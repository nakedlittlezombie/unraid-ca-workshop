.shim-banner{display:flex;align-items:center;gap:12px;padding:14px 17px;background:#eef5f1;border:1px solid #dde9e1;border-radius:7px;margin:0 0 15px}.shim-banner&gt;span{display:grid;place-items:center;width:31px;height:31px;border-radius:7px;background:var(--surface);color:#267650;font-size:18px}.shim-banner b,.shim-banner small{display:block}.shim-banner b{font-size:11px}.shim-banner small{font-size:9px;color:#748178;margin-top:4px}.shim-repo{padding:16px 18px;margin-bottom:23px}.shim-heading{display:flex;justify-content:space-between;align-items:end;margin:0 0 11px}.shim-heading h2{font-size:15px;margin:0 0 5px}.shim-heading p{font-size:10px;color:#7d8982;margin:0}.shim-heading input{padding:8px 10px;border:1px solid var(--line);border-radius:5px;font:10px 'nudista-web';width:220px}.ca-catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.ca-card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:15px;min-width:0;display:flex;flex-direction:column;align-items:flex-start}.ca-card-top{width:100%;display:flex;align-items:center;justify-content:space-between}.ca-type{font-size:8px;letter-spacing:.8px;color:#748178;font-weight:700}.ca-card h3{font-size:13px;margin:13px 0 5px}.ca-card p{font-size:10px;line-height:1.5;color:#7c8981;margin:0 0 10px;min-height:30px}.ca-image,.ca-file{font:9px monospace;color:#516257;overflow-wrap:anywhere;margin:3px 0}.ca-file{font-size:8px;color:#97a199;margin-bottom:8px}.ca-card .error-text{font-size:9px;color:#a54c42;margin:2px 0}.ca-card button{margin-top:auto}.ca-card button:disabled{opacity:.55;cursor:not-allowed}.plugin-heading{margin-top:24px}.shim-empty{grid-column:1/-1;padding:21px;background:var(--surface);border:1px dashed #d9e2dc;border-radius:7px;text-align:center;color:#87938b;font-size:10px}.plugin-card{background:#fcfcfb}
