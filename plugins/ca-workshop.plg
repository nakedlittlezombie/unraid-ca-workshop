.repo-file-list{max-height:270px;overflow:auto}.repo-file{width:100%;background:transparent;border-left:0;border-right:0;border-bottom:0;text-align:left;cursor:pointer}.repo-file:hover{background:#f7faf8}.activity-list{max-height:360px;overflow:auto}.activity-row{padding:12px 2px;border-top:1px solid #edf0ee}.activity-row b,.activity-row small{display:block}.activity-row b{font-size:11px}.activity-row small{font-size:9px;color:#89958e;margin-top:4px}.repo-bar .subtle{margin-left:0}
.all-repo-files{max-height:65vh;overflow:auto}.all-repo-files .file-row{width:100%;background:var(--surface);border-left:0;border-right:0;border-bottom:0;text-align:left;cursor:pointer}.all-repo-files .file-row:hover{background:#f7faf8}
.unraid-panel{padding:18px;margin-bottom:18px}.unraid-connect-form{display:flex;gap:12px;align-items:flex-end}.unraid-connect-form label{flex:1;font-size:10px;font-weight:600;color:#68756e}.unraid-connect-form input{display:block;width:100%;margin-top:6px;border:1px solid var(--line);border-radius:5px;padding:9px 10px;font:12px 'nudista-web';color:var(--ink)}.unraid-status{display:flex;flex-direction:column;gap:5px;margin-top:13px;padding:10px 12px;border-radius:6px;background:#f6f8f6;color:#617068;font-size:11px}.unraid-status code{font:10px monospace;color:#3b594a}.unraid-note{font-size:10px;color:#7c8981;margin:10px 0 0}.unraid-panel&gt;p{line-height:1.5}.unraid-panel&gt;.text-button{margin-top:10px;padding:0}@media(max-width:700px){.unraid-connect-form{align-items:stretch;flex-direction:column}.unraid-connect-form .primary{align-self:flex-start}}
html[data-theme="light"]{color-scheme:light;--ink:#27272a;--muted:#71717a;--line:#e4e4e7;--bg:#f4f4f5;--surface:#fff;--surface-2:#f4f4f5;--rail:#fff;--green:#15803d;--green2:#dcfce7;--orange:#c2410c;--orange2:#ffedd5;--navy:#fff;--accent:#c2410c;--accent-hover:#9a3412;--success-bg:#dcfce7;--success:#166534;--warn-bg:#fef3c7;--warn:#92400e;--danger-bg:#fee2e2;--danger:#991b1b}
body{background:var(--bg);color:var(--ink);font-family:'nudista-web',sans-serif}.rail,header{background:var(--rail);border-color:var(--line)}.brand-mark{background:var(--accent)}.nav{color:var(--muted)}.nav.active{background:var(--orange2);color:var(--accent)}.nav.active span,.text-button,.subtle,.doc-card&gt;span{color:var(--accent)}.primary{background:var(--accent);border-color:var(--accent);color:#fff}.primary:hover{background:var(--accent-hover);border-color:var(--accent-hover)}.panel,.repo-bar,.stats,.package-card,.file-dialog-box,.file-dialog-head,.full-button,.doc-card,.docker-form input,.docker-form select,.template-summary,.sandbox-note,.shim-banner,.shim-repo,.ca-card,.next,.workflow{background:var(--surface);color:var(--ink);border-color:var(--line)}.file-row,.tree&gt;div,.tag,.repo-icon,.file-icon.plain,.docker-status,.unraid-status{background:var(--surface-2);color:var(--muted)}.file-row,.check-row,.template-result,.container-row,.activity-row{border-color:var(--line)}.repo-name span,.crumb,.eyebrow,.page-heading p,.panel-head p,.stat span,.stat em,.check-row small,.file-row small,.doc-card small,.docker&gt;p,.file-dialog-head small,.template-result small,.container-row small,.sandbox-note,.unraid-note,.repo-file-list{color:var(--muted)}.check.pass,.pill.good{background:var(--success-bg);color:var(--success)}.check.warn,.pill.pending{background:var(--warn-bg);color:var(--warn)}.docker-icon,.unsupported-setting,.container-row button{background:var(--danger-bg);color:var(--danger);border-color:var(--line)}.notice{background:var(--surface-2);border-color:var(--line);color:var(--muted)}.notice p{color:var(--muted)}.repo-icon,.package-symbol,.docker-icon{border:1px solid var(--line)}.full-button:hover,.outline:hover,.doc-card:hover,.repo-file:hover,.archive-file:hover{background:var(--surface-2);border-color:var(--accent)}.local-tag,.branch,.theme-toggle{color:var(--muted);border-color:var(--line)}.theme-toggle{width:30px;height:30px;border:1px solid var(--line);border-radius:6px;background:var(--surface);font:18px 'nudista-web';cursor:pointer}.theme-toggle:hover{color:var(--accent);border-color:var(--accent)}input:focus,select:focus,button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.repo-file{background:transparent}.file-dialog{background:#09090bcc}.file-dialog pre{background:var(--surface);color:var(--ink)}.activity-row{border-top:1px solid var(--line)}.workflow .step span{background:var(--surface-2);color:var(--muted)}.workflow .step.current span,.workflow .step.done span{background:var(--accent);color:#fff}.step b{color:var(--ink)}.step small{color:var(--muted)}.ca-type{color:var(--accent)}a{color:var(--accent)}
.avatar,.repo-icon,.package-symbol,.tag,.tree&gt;div,.template-summary,.shim-banner,.unraid-status,.package-main code{background:var(--surface-2);color:var(--muted)}.file-icon.xml{background:var(--success-bg);color:var(--success)}.connector{background:var(--line)}.empty-result{background:var(--surface-2);border-color:var(--line);color:var(--muted)}.empty-icon{background:var(--success-bg);color:var(--success)}.file-state.ok{color:var(--success)}.file-state.review{color:var(--warn)}.next-mark{background:var(--orange2);color:var(--accent)}.step.done&gt;span{background:var(--success-bg);color:var(--success)}
.ca-browser-controls{padding:15px;background:var(--surface);border:1px solid var(--line);border-radius:8px}.ca-search-form{display:flex;gap:8px}.ca-search-form input,.ca-filter-row select{border:1px solid var(--line);border-radius:5px;padding:9px 11px;background:var(--surface-2);color:var(--ink);font:11px 'nudista-web'}.ca-search-form input{flex:1}.ca-filter-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px}.ca-filter-row select{min-width:150px}.ca-filter-row .outline{margin:0}.ca-results-head{display:flex;align-items:center;justify-content:space-between;margin:16px 0 10px;color:var(--muted);font-size:10px}.ca-results-head .outline{margin:0 0 0 6px}.ca-market-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.ca-market-card{min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:14px;display:flex;flex-direction:column}.ca-market-top{display:flex;align-items:center;gap:10px;min-height:48px}.ca-market-top img,.ca-market-placeholder{width:45px;height:45px;border-radius:7px;object-fit:contain;background:var(--surface-2);border:1px solid var(--line)}.ca-market-placeholder{display:grid;place-items:center;color:var(--accent);font-weight:700;font-size:11px}.ca-market-top&gt;div{display:flex;flex-direction:column;align-items:flex-start;gap:5px}.ca-official{color:var(--success);font-size:8px;font-weight:700;letter-spacing:.5px}.ca-market-card h2{font-size:13px;margin:12px 0 5px}.ca-market-card p{font-size:10px;line-height:1.55;color:var(--muted);margin:0 0 11px;min-height:45px}.ca-market-meta{display:flex;gap:6px;flex-wrap:wrap;color:var(--muted);font-size:9px;margin-bottom:12px}.ca-market-meta span{color:var(--warn);background:var(--warn-bg);border-radius:10px;padding:3px 6px}.ca-market-actions{display:flex;gap:8px;align-items:center;margin-top:auto}.ca-market-actions .outline{margin:0}.market-link{font-size:9px;text-decoration:none}.ca-market-card .primary{font-size:9px;padding:8px 10px}
+@media(max-width:950px){.ca-market-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.ca-market-grid{grid-template-columns:1fr}.ca-filter-row{align-items:stretch;flex-direction:column}.ca-filter-row select,.ca-filter-row button{width:100%}.ca-results-head{align-items:flex-start;gap:8px;flex-direction:column}}
.install-console{position:fixed;right:20px;bottom:20px;width:min(430px,calc(100vw - 32px));z-index:20;background:#18181b;color:#f4f4f5;border:1px solid #3f3f46;border-radius:9px;box-shadow:0 16px 48px #0008;overflow:hidden}.install-console[hidden]{display:none}.install-console-head{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid #3f3f46}.install-console-head b,.install-console-head small{display:block}.install-console-head b{font-size:11px}.install-console-head small{font-size:9px;color:#a1a1aa;margin-top:4px}.install-console-head button{border:0;background:transparent;color:#a1a1aa;font-size:20px;cursor:pointer}.install-console pre{box-sizing:border-box;margin:0;padding:12px 14px;max-height:190px;min-height:54px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:9px/1.5 ui-monospace,monospace;color:#d4d4d8}.install-console.install-done .install-console-head{border-top:2px solid #22c55e}.install-console.install-failed .install-console-head{border-top:2px solid #ef4444}
.volume-setting label{display:block;margin-top:8px;font-size:9px;font-weight:600;color:var(--muted)}.volume-setting select,.volume-setting input{display:block;width:100%;box-sizing:border-box;margin-top:4px;padding:7px 8px;border:1px solid var(--line);border-radius:4px;background:var(--surface);color:var(--ink);font:10px 'nudista-web'}.volume-setting .bind-path[hidden]{display:none}.volume-setting .volume-help{line-height:1.45}
.bootstrap-card{margin:14px 0 18px;padding:14px 16px;background:var(--surface);border:1px solid var(--line);border-radius:8px}.bootstrap-card&gt;summary{cursor:pointer;color:var(--accent);font-size:12px;font-weight:700}.bootstrap-copy{margin:9px 0 12px;color:var(--muted);font-size:10px}.bootstrap-form{display:grid;gap:10px;max-width:720px}.bootstrap-form label{font-size:10px;font-weight:600;color:var(--muted)}.bootstrap-form input,.bootstrap-form textarea{box-sizing:border-box;display:block;width:100%;margin-top:5px;padding:9px 10px;border:1px solid var(--line);border-radius:5px;background:var(--surface-2);color:var(--ink);font:11px 'nudista-web'}.bootstrap-form textarea{resize:vertical;line-height:1.5}.bootstrap-form label small{display:block;margin-top:5px;font-size:9px;line-height:1.5;font-weight:400}.bootstrap-form label small a{color:var(--accent)}.bootstrap-note,.bootstrap-status{font-size:9px;line-height:1.5;color:var(--muted);margin:0}.bootstrap-status a{overflow-wrap:anywhere}.muted-inline{font-weight:400}.repo-editor-box{height:min(82vh,780px)}.repo-editor-tools{display:flex;align-items:end;gap:9px;padding:11px 15px}.repo-editor-tools label{flex:1;color:var(--muted);font-size:9px}.repo-editor-tools input{box-sizing:border-box;display:block;width:100%;margin-top:4px;padding:8px;border:1px solid var(--line);border-radius:4px;background:var(--surface-2);color:var(--ink);font:10px monospace}.danger-button{border:1px solid var(--danger);background:var(--danger-bg);color:var(--danger);border-radius:4px;padding:8px 10px;font:10px 'nudista-web';cursor:pointer}.repo-editor-box textarea{box-sizing:border-box;flex:1;width:100%;min-height:200px;resize:none;border:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);outline:none;padding:15px;background:var(--surface-2);color:var(--ink);font:11px/1.55 ui-monospace,monospace;tab-size:2}.repo-editor-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 15px}.repo-editor-footer span{font-size:9px;color:var(--muted)}.repo-editor-footer button{flex:none}.file-dialog-head&gt;div:last-child{display:flex;align-items:center;gap:7px}.file-dialog-head .outline{margin:0;padding:6px 9px}.file-dialog-head&gt;div:last-child&gt;button:last-child{border:0;background:transparent;color:var(--muted);font-size:20px;cursor:pointer}
@media(max-width:650px){.repo-editor-tools{align-items:stretch;flex-direction:column}.repo-editor-footer{align-items:stretch;flex-direction:column}.repo-editor-footer button{align-self:flex-start}.bootstrap-form .form-pair{grid-template-columns:1fr}}
.portal-panel{margin:0 0 18px;overflow:hidden}.portal-actions{display:flex;gap:9px;align-items:center}.portal-actions .outline{margin:0}.portal-panel iframe{display:block;width:100%;height:min(82vh,1050px);min-height:690px;border:0;border-top:1px solid var(--line);background:#fff}.unraid-containers{margin-top:12px}.unraid-containers h3{font-size:11px;margin:3px 0 7px}.unraid-container-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--line)}.unraid-container-row b,.unraid-container-row small{display:block}.unraid-container-row b{font-size:10px}.unraid-container-row small{font-size:9px;color:var(--muted);margin-top:4px}.unraid-container-actions{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.unraid-container-actions button{padding:5px 7px;border:1px solid var(--line);border-radius:4px;background:var(--surface-2);color:var(--ink);font:9px 'nudista-web';cursor:pointer}.unraid-container-actions button:hover{border-color:var(--accent);color:var(--accent)}.unraid-container-actions .danger-button{background:var(--danger-bg);color:var(--danger)}.unraid-empty{padding:10px 0;color:var(--muted);font-size:10px}.portal-panel .panel-head{padding:14px 17px;margin:0}
