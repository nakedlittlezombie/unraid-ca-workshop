.profile-actions{display:flex;align-items:center;gap:8px}.profile-actions .outline{margin:0}.profile-fields{display:grid;gap:9px}.profile-field-row{display:grid;grid-template-columns:minmax(130px,.7fr) minmax(200px,1.3fr) 28px;align-items:end;gap:9px;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--surface)}.profile-field-row label{display:grid;gap:5px;color:var(--muted);font-size:9px;font-weight:600}.profile-field-row input,.profile-field-row textarea{width:100%;border:1px solid var(--line);border-radius:5px;background:var(--surface-2);color:var(--ink);padding:8px;font:11px ui-monospace,SFMono-Regular,Consolas,monospace}.profile-field-row textarea{resize:vertical;min-height:38px}.profile-field-remove{width:26px;height:29px;border:1px solid var(--line);border-radius:5px;background:var(--surface-2);color:var(--danger);font:18px/1 'nudista-web';cursor:pointer}.profile-field-remove:hover{background:var(--danger-bg);border-color:var(--danger)}
