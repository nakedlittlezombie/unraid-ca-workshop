e-columns:1fr}.icon-tool-wide .form-pair .primary{justify-self:start}}
.ca-store-installer{margin:20px 0;padding:18px}.archive-panel{padding:18px}.sandbox-running{padding:18px}.sandbox-running .containers{margin-top:18px}.sandbox-running .docker-status{width:max-content;max-width:100%}
.settings-card{padding:18px;margin:0 0 17px}.settings-form{display:grid;gap:13px}.settings-form label{display:grid;gap:6px;font-size:11px;font-weight:600}.settings-form input{width:100%;border:1px solid var(--line);background:var(--surface-2);color:var(--ink);border-radius:5px;padding:9px 10px;font:12px 'nudista-web'}.settings-form small,.settings-footnote{font-size:10px;color:var(--muted);line-height:1.6}.settings-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.settings-actions span{font-size:10px;color:var(--muted)}.settings-actions .outline{margin:0}.sync-status{padding:12px;background:var(--surface-2);border-radius:6px;margin-bottom:12px}.sync-status p{font-size:11px;margin:8px 0;color:var(--muted)}.sync-status small{display:block;font-size:10px;color:var(--warn);margin-top:5px}.sync-state{display:inline-flex;padding:5px 8px;border-radius:20px;font-size:9px;font-weight:700;letter-spacing:.5px}.sync-state.good{background:var(--success-bg);color:var(--success)}.sync-state.pending{background:var(--warn-bg);color:var(--warn)}.sync-public.good-text{color:var(--success)}.sync-file-list{font-size:10px;color:var(--muted);margin:8px 0 14px;line-height:1.7}.sync-file-list&gt;div{font-family:monospace;overflow-wrap:anywhere}.sync-other{margin-top:8px;color:var(--warn)}.settings-form&gt;button{justify-self:start}.unraid-panel{margin-top:14px}
.nav-tree{display:grid;gap:2px;margin:0 0 7px 28px;padding:2px 0 4px 10px;border-left:1px solid #d8e0da}.nav-tree-item{width:100%;min-height:29px;padding:5px 9px;border:0;border-radius:5px;background:transparent;text-align:left;color:#77847c;font:11px 'nudista-web';cursor:pointer}.nav-tree-item:hover{background:#eef2ef;color:#315b46}.nav-tree-item.active{background:#eaf3ee;color:#15593e;font-weight:700}.rail{overflow-y:auto}.rail-bottom{flex:0 0 auto}
.submission-kind{display:inline-block;margin-left:5px;padding:2px 5px;border-radius:9px;background:var(--surface-2);color:var(--muted);font-size:8px;font-weight:500;vertical-align:1px}
.ca-scroll-sentinel{grid-column:1/-1;min-height:40px;padding:13px;text-align:center;color:var(--muted);font-size:10px}.ca-scroll-sentinel[hidden]{display:none}.ca-results-head #caScrollStatus{color:var(--muted);font-size:9px}.ca-install-backdrop{position:fixed;inset:0;z-index:50;background:#09090bcc}.ca-install-backdrop[hidden]{display:none}.ca-install-drawer{position:fixed;inset:0 0 0 auto;z-index:51;width:min(470px,100vw);height:100dvh;overflow-y:auto;padding:23px;background:var(--surface);border-left:1px solid var(--line);box-shadow:-18px 0 55px #0007}.ca-install-drawer[hidden]{display:none}.ca-install-drawer-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;padding-bottom:16px;margin-bottom:18px;border-bottom:1px solid var(--line)}.ca-install-drawer-head h2{margin:3px 0;font-size:17px}.ca-install-drawer-head p{margin:0;color:var(--muted);font-size:10px}.drawer-close{width:34px;height:34px;border:1px solid var(--line);border-radius:6px;background:var(--surface-2);color:var(--ink);font-size:21px;cursor:pointer}.ca-install-drawer .docker-form{display:grid;gap:14px}.ca-install-drawer .docker-form&gt;label{display:grid;gap:6px;color:var(--muted);font-size:10px}.ca-install-drawer .docker-form input,.ca-install-drawer .docker-form select{width:100%;padding:9px;border:1px solid var(--line);border-radius:5px;background:var(--surface-2);color:var(--ink);font:11px 'nudista-web'}.ca-install-drawer .template-summary{padding:12px;border:1px solid var(--line);border-radius:6px;background:var(--bg)}.ca-install-drawer .template-inputs{display:grid;gap:10px}.ca-install-drawer .volume-setting{display:grid;gap:8px}.ca-install-drawer .docker-form&gt;button{justify-self:stretch;padding:11px}.install-console{z-index:70}.drawer-open{overflow:hidden}.common-install-vars{display:grid;gap:8px}.common-install-var-row{display:grid;grid-template-columns:minmax(100px,.8fr) minmax(130px,1.2fr) auto auto;align-items:end;gap:8px;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--bg)}.common-install-var-row&gt;label:not(.common-var-reveal){display:grid;gap:5px;color:var(--muted);font-size:9px}.common-install-var-row .common-var-reveal{display:flex;align-items:center;gap:4px;padding:8px 0;color:var(--muted);font-size:9px;white-space:nowrap}.common-install-var-row .common-var-reveal input{width:auto;margin:0}.common-install-var-row .common-var-remove{margin:0;padding:7px 9px;font-size:9px}.common-vars-card .panel-head&gt;button{margin:0;white-space:nowrap}
@media(max-width:600px){.ca-install-drawer{padding:17px}.common-install-var-row{grid-template-columns:1fr 1fr}.common-install-var-row .common-var-reveal{grid-column:1;grid-row:2}.common-install-var-row .common-var-remove{grid-column:2;grid-row:2;justify-self:end}.common-vars-card .panel-head{align-items:flex-start;gap:10px}}

/* Floating overlay for package contents */
#packageOverlay{position:fixed;inset:0;z-index:50;display:none;backdrop-filter:blur(4px);background:rgba(0,0,0,.45);animation:fadein .2s ease-out}
#packageOverlay.hidden{display:none}
#packageOverlay .overlay-box{position:absolute;inset:50% 50% auto auto;width:min(760px,92vw);max-height:84vh;transform:translate(-50%,-50%);background:var(--surface);border:1px solid var(--border);border-radius:8px;box-shadow:0 12px 40px rgba(0,0,0,.35);display:flex;flex-direction:column;animation:scaleup .2s ease-out}
#packageOverlay .overlay-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--border)}
#packageOverlay .overlay-head button{background:transparent;border:none;font-size:24px;line-height:1;cursor:pointer;padding:0;color:var(--muted)}
#packageOverlay .overlay-body{overflow:auto;padding:16px}
@keyframes fadein{from{opacity:0}to{opacity:1}}
@keyframes scaleup{from{transform:translate(-50%,-48%) scale(.96);opacity:0}to{transform:translate(-50%,-50%) scale(1);opacity:1}}
.package-check-row{display:flex;gap:8px;padding-top:12px}
.package-info{padding-top:12px;font-size:13px;color:var(--muted)}
.package-info .ok{color:var(--success)}
.package-info .bad{color:var(--error)}
.package-entries{max-height:260px;overflow:auto;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
.package-entries .entry-row{display:flex;justify-content:space-between;padding:4px 8px;border-bottom:1px solid var(--border)}
.package-entries .entry-name{color:var(--fg)}
.package-entries .entry-size{color:var(--muted)}
.ai-connection-fields{align-items:start}
.settings-form select{width:100%;border:1px solid var(--line);background:var(--surface-2);color:var(--ink);border-radius:5px;padding:9px 10px;font:12px 'nudista-web'}
.ai-model-field{margin-top:2px}
.settings-actions .ai-suggestion-status{font-size:9px;color:var(--muted)}
.ai-field-control{position:relative;display:block;min-width:0}
.ai-field-control&gt;input,.ai-field-control&gt;textarea{padding-right:36px}
.ai-field-button{position:absolute;top:5px;right:5px;width:25px;height:25px;display:grid;place-items:center;padding:0;border:1px solid var(--line);border-radius:5px;background:var(--surface);color:var(--accent);font:14px/1 'nudista-web';cursor:pointer;opacity:.62;transition:opacity .15s,background .15s,border-color .15s}
.ai-field-button:hover,.ai-field-button:focus-visible{opacity:1;background:var(--orange2);border-color:var(--accent)}
.ai-field-button:disabled{opacity:.35;cursor:wait}
.ai-suggestion{display:grid;gap:8px;margin-top:6px;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--surface-2)}
.ai-suggestion[hidden]{display:none}
.ai-suggestion-head{display:flex;align-items:center;justify-content:space-between;gap:8px;color:var(--accent);font-size:9px;font-weight:700;letter-spacing:.5px}
.ai-suggestion-close{width:22px;height:22px;padding:0;border:0;background:transparent;color:var(--muted);font:17px/1 'nudista-web';cursor:pointer}
.ai-suggestion-close:hover{color:var(--ink)}
.ai-suggestion-text{box-sizing:border-box;width:100%;min-height:58px;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:5px;background:var(--surface);color:var(--ink);font:11px/1.5 'nudista-web'}
.ai-suggestion-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.ai-suggestion-actions .primary,.ai-suggestion-actions .outline{margin:0}
.ai-suggestion-status{flex:1;min-width:120px;font-size:9px;line-height:1.4;color:var(--muted)}
.ai-suggestion.busy .ai-suggestion-text{opacity:.55}
@media(max-width:650px){.ai-connection-fields{grid-template-columns:1fr}.ai-field-button{opacity:.85}}
.runtime-status{display:grid;gap:0;margin-top:4px}
.runtime-row{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:8px 0;border-top:1px solid var(--line);font-size:10px}
.runtime-row:first-child{border-top:0}
.runtime-row span{color:var(--muted)}
.runtime-row b{font-weight:500;text-align:right;overflow-wrap:anywhere}
.runtime-good{color:var(--success)}
.runtime-bad{color:var(--warn)}
.runtime-note{margin:10px 0 0;color:var(--muted);font-size:9px;line-height:1.6}

.brand-icon{height:36px;width:auto;display:block;}
</INLINE>
</FILE>
