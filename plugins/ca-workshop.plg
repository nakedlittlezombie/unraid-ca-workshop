async function loadIconTools(){try{renderIconTools(await api('/api/repo/icon-tools'))}catch(error){document.querySelector('#placeholderStatus').textContent=error.message;document.querySelector('#fontAwesomeTemplate').innerHTML='&lt;option value=""&gt;Connect a repository first&lt;/option&gt;';document.querySelector('#createFontAwesomeIcon').disabled=true}}
document.querySelector('#refreshIconTools').addEventListener('click',()=&gt;loadIconTools());
function readFileBase64(file){return new Promise((resolve,reject)=&gt;{const reader=new FileReader();reader.onload=()=&gt;resolve(String(reader.result).split(',')[1]||'');reader.onerror=()=&gt;reject(Error('The selected image could not be read.'));reader.readAsDataURL(file)})}
