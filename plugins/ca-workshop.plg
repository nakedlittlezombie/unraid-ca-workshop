.nav-planned{opacity:.55;cursor:not-allowed}.nav-planned small{margin-left:auto;font-size:7px;letter-spacing:.4px}.app-workflow-actions{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 15px}.app-workflow-actions .outline{margin:0}.app-stats{margin-bottom:15px}.app-list-panel,.app-submission-panel{padding:16px;margin:0 0 15px}.app-list-panel .panel-head,.app-submission-panel .panel-head{align-items:center}.application-list{display:grid;gap:9px}.application-row{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:7px;background:var(--surface)}.application-icon{flex:0 0 42px;height:42px;display:grid;place-items:center;border-radius:7px;background:var(--orange2);color:var(--accent);font-size:12px;font-weight:700}.application-main{min-width:0;flex:1}.application-main&gt;b,.application-main&gt;small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.application-main&gt;b{font-size:11px}.application-main&gt;small{margin-top:3px;color:var(--muted);font-size:9px}.application-meta{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:8px}.application-status{color:var(--muted);font-size:9px}.application-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.application-actions .outline{margin:0}.application-metrics{margin-top:9px;border-top:1px solid var(--line);padding-top:8px}.application-metrics summary{cursor:pointer;color:var(--accent);font-size:9px;font-weight:600}.application-metrics-content{margin-top:8px;color:var(--muted);font-size:9px}.application-metrics&gt;.outline{margin:8px 0 0;padding:6px 8px;font-size:9px}.application-metrics-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.application-metrics-grid&gt;div{min-width:0;padding:8px;border:1px solid var(--line);border-radius:5px;background:var(--surface-2)}.application-metrics-grid small,.application-metrics-grid b{display:block;overflow-wrap:anywhere}.application-metrics-grid small{color:var(--muted);font-size:8px}.application-metrics-grid b{margin-top:4px;color:var(--ink);font-size:9px}.metrics-source{display:block;margin-top:7px;color:var(--muted);font-size:8px}.app-submission-panel .notice{margin:0}.app-submission-panel .panel-head{margin-bottom:12px}@media(max-width:720px){.application-row{align-items:flex-start;flex-wrap:wrap}.application-actions{width:100%;padding-left:54px;justify-content:flex-start}.app-submission-panel .panel-head{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.application-metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
