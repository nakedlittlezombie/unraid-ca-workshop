.portal-footnote{padding:9px 15px;color:var(--muted);font-size:10px;border-top:1px solid var(--line)}
.package-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.package-controls .outline{margin:0}.package-message{display:block;margin-top:8px;color:var(--muted);font-size:10px;line-height:1.5}.package-controls .primary{white-space:nowrap}@media(max-width:650px){.package-controls{width:100%;justify-content:flex-start;margin-left:59px}}
.compose-intro{margin-bottom:16px}.compose-panel{padding:18px}.compose-form{display:grid;gap:13px}.compose-form label,.compose-template label{display:grid;gap:6px;color:var(--muted);font-size:10px;font-weight:600}.compose-form input[type=file],.compose-form textarea,.compose-template input,.compose-template textarea{width:100%;border:1px solid var(--line);border-radius:5px;background:var(--surface-2);color:var(--ink);padding:10px;font:11px 'nudista-web'}.compose-form textarea,.compose-template textarea{font:11px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;resize:vertical}.compose-form-footer,.compose-save-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.compose-form-footer span,.compose-message{font-size:10px;color:var(--muted)}.compose-message{margin:14px 2px}.compose-results{display:grid;gap:11px}.compose-template{background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:14px}.compose-template summary{display:flex;gap:12px;align-items:center;cursor:pointer;list-style:none}.compose-template summary::-webkit-details-marker{display:none}.compose-template summary span{font-size:12px;font-weight:700}.compose-template summary small{margin-left:auto;color:var(--muted);font-size:9px}.compose-template&gt;label{margin-top:12px}.compose-warnings,.compose-success{margin:12px 0;padding:10px 12px;border-radius:5px;background:var(--warn-bg);color:var(--warn);font-size:10px;line-height:1.5}.compose-warnings ul{margin:6px 0 0;padding-left:18px}.compose-warnings li+li{margin-top:3px}.compose-success{background:var(--success-bg);color:var(--success)}.compose-save-row{justify-content:flex-end;margin:14px 0 30px}.compose-form-footer .primary,.compose-save-row .primary{white-space:nowrap}@media(max-width:650px){.compose-template summary{align-items:flex-start;flex-direction:column;gap:5px}.compose-template summary small{margin:0}.compose-form-footer{align-items:flex-start;flex-direction:column}}
