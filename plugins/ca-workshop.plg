document.querySelector('#createFontAwesomeIcon').addEventListener('click',async()=&gt;{const template=document.querySelector('#fontAwesomeTemplate').value,name=document.querySelector('#fontAwesomeName').value.trim().replace(/^fa-/i,''),style=document.querySelector('#fontAwesomeStyle').value,status=document.querySelector('#fontAwesomeStatus'),button=document.querySelector('#createFontAwesomeIcon');if(!template||!name){status.textContent='Choose a template and enter an icon name.';return}button.disabled=true;status.textContent='Downloading the Font Awesome SVG…';try{const result=await api(`/api/icons/font-awesome?name=${encodeURIComponent(name)}&amp;style=${encodeURIComponent(style)}`),png=await svgToPng(result.svg),data=await readFileBase64(new File([png],`${name}.png`,{type:'image/png'})),saved=await api('/api/repo/icons/font-awesome',{method:'POST',body:JSON.stringify({template,data})});const preview=document.querySelector('#fontAwesomePreview');preview.innerHTML='';const image=document.createElement('img');image.src=URL.createObjectURL(png);image.alt=`${name} Font Awesome icon`;preview.append(image);status.textContent=`Saved ${saved.icon} and updated ${saved.template} to use its public icon URL.`;toast('Template icon created and linked.');await loadIconTools()}catch(error){status.textContent=error.message;toast(error.message)}finally{button.disabled=false}});
document.querySelector('#placeholderIconUpload').addEventListener('change',async event=&gt;{const file=event.target.files?.[0];if(!file)return;const status=document.querySelector('#placeholderStatus');if(!file.name.toLowerCase().endsWith('.png')||file.type&amp;&amp;file.type!=='image/png'||file.size&gt;2_000_000){status.textContent='Choose a PNG placeholder smaller than 2 MB.';event.target.value='';return}try{await api('/api/repo/icons/placeholder',{method:'POST',body:JSON.stringify({data:await readFileBase64(file)})});placeholderMatches=[];status.textContent='Saved images/placeholder-icon.png.';await loadIconTools();toast('Placeholder icon saved.')}catch(error){status.textContent=error.message}});
