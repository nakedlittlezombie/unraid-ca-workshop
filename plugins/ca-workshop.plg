<FILE Name="/usr/local/emhttp/plugins/ca-workshop/automation/template_validation/__init__.py">
<INLINE>"""Community Apps template validation helpers."""
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/ca-workshop/automation/template_validation/validate_app_config.py">
<INLINE>#!/usr/bin/env python3
"""Validate Unraid Docker app template configuration, with no OS-specific tools."""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

WEBUI_PORT = re.compile(r"^https?://\[IP\]:\[PORT:(\d+)\]", re.IGNORECASE)


def _target_contains_port(target: str, port: int) -&gt; bool:
    """Match a single target or a numeric target range without substring matches."""
    value = target.strip()
    if re.fullmatch(r"\d+", value):
        return int(value) == port
    match = re.fullmatch(r"(\d+)\s*-\s*(\d+)", value)
    return bool(match and int(match.group(1)) &lt;= port &lt;= int(match.group(2)))


def validate_template_content(content: str) -&gt; list[str]:
    """Return validation errors for a Docker template XML document."""
    errors: list[str] = []
    content = content.strip()
    if not content.startswith("&lt;?xml"):
        errors.append("The XML declaration is missing.")
    try:
        root = ET.fromstring(content)
    except ET.ParseError as exc:
        return errors + [f"Malformed XML: {exc}"]

    webui = root.findtext("WebUI")
    if webui is not None:
        network = root.findtext("Network")
        if network is None or not network.strip():
            errors.append("WebUI is present but &lt;Network&gt; is missing.")
        elif network.strip().lower() != "host":
            match = WEBUI_PORT.match(webui.strip())
            if not match:
                errors.append("&lt;WebUI&gt; must use http(s)://[IP]:[PORT:&lt;port_number&gt;].")
            else:
                port = int(match.group(1))
                matching = any(
                    (config.get("Type") or "").strip().lower() == "port"
                    and _target_contains_port(config.get("Target") or "", port)
                    for config in root.findall("Config")
                )
                if not matching:
                    errors.append(f"No Port Config Target matches WebUI port {port}.")

    for config in root.findall("Config"):
        target = (config.get("Target") or "").strip()
        if target and target.isupper() and (config.get("Type") or "").strip().lower() != "variable":
            errors.append(f"Config Target '{target}' is all caps, so its Type should be Variable.")

    return errors


def validate_template_xsd(schema_path: str | Path, template_path: str | Path) -&gt; dict[str, object]:
    """Validate a template with xmllint, the engine used by idddev/xml-xsd-validator.

    The upstream Node wrapper requires xmllint and constructs a shell command from
    file paths. Invoke the same engine with an argument list so paths containing
    spaces are safe and the call works on Windows, macOS, and Linux.
    """
    executable = shutil.which("xmllint")
    if not executable:
        return {"status": "skipped", "message": "xmllint is not installed; the XSD check was skipped."}
    try:
        result = subprocess.run(
            [executable, "--nonet", "--noout", "--schema", str(schema_path), str(template_path)],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return {"status": "skipped", "message": "XSD validation timed out."}
    except OSError as exc:
        return {"status": "skipped", "message": f"Could not start xmllint: {exc}"}

    if result.returncode == 0:
        return {"status": "valid", "message": "Valid against template_schema.xsd."}
    output = (result.stderr or result.stdout).strip()
    lines = [line.strip() for line in output.splitlines() if line.strip()]
    messages = [line for line in lines if "fails to validate" not in line.lower()]
    if not messages:
        messages = ["Template does not match template_schema.xsd."]
    return {"status": "invalid", "message": " ".join(messages[:4])}


def validate_template_file(template_file_path: str | Path) -&gt; bool:
    """Validate a template file and print any errors. Return True when valid."""
    path = Path(template_file_path)
    try:
        content = path.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"Error: Could not read {path}: {exc}")
        return False
    errors = validate_template_content(content)
    for error in errors:
        print(f"Error: {error}")
    if errors:
        print(f"{path} failed validation")
        return False
    print(f"{path} passed validation")
    return True


def main() -&gt; int:
    parser = argparse.ArgumentParser(description="Validate an Unraid Docker app template XML file.")
    parser.add_argument("template_file", help="Path to the app template XML file to validate.")
    args = parser.parse_args()
    return 0 if validate_template_file(args.template_file) else 1


if __name__ == "__main__":
    sys.exit(main())
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/ca-workshop/index.html">
<INLINE>&lt;!doctype html&gt;
&lt;html lang="en" data-theme="dark"&gt;
&lt;head&gt;
  &lt;meta charset="utf-8"&gt;&lt;link rel="icon" type="image/png" href="data:image/png;base64,"&gt;&lt;meta name="viewport" content="width=device-width,initial-scale=1"&gt;
  &lt;title&gt;CA Workshop — Repository &amp; Submission Workbench&lt;/title&gt;
  &lt;link rel="stylesheet" href="https://use.typekit.net/ymm4lqb.css"&gt;
  &lt;link rel="stylesheet" href="style.css"&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;aside class="rail"&gt;&lt;div class="brand"&gt;&lt;img src="data:image/png;base64," alt="CA Workshop" class="brand-icon"&gt;&lt;span&gt;WORKSHOP&lt;/span&gt;&lt;/div&gt;&lt;div class="rail-label"&gt;WORKSPACE&lt;/div&gt;
    &lt;button class="nav active" data-page="repository"&gt;&lt;span&gt;▦&lt;/span&gt; Repository&lt;/button&gt;&lt;button class="nav" data-page="applications"&gt;&lt;span&gt;▣&lt;/span&gt; Applications&lt;/button&gt;&lt;div class="nav-tree" aria-label="Application pages"&gt;&lt;button class="nav-tree-item" data-page="applications"&gt;My apps&lt;/button&gt;&lt;button class="nav-tree-item" data-page="template-editor"&gt;Editor&lt;/button&gt;&lt;button class="nav-tree-item" data-page="application-stats"&gt;Statistics&lt;/button&gt;&lt;/div&gt;&lt;button class="nav" data-page="plugins"&gt;&lt;span&gt;⌘&lt;/span&gt; Plugins&lt;/button&gt;&lt;div class="nav-tree" aria-label="Plugin pages"&gt;&lt;button class="nav-tree-item" data-page="plugins"&gt;My plugins&lt;/button&gt;&lt;button class="nav-tree-item" data-page="plugin-stats"&gt;Statistics&lt;/button&gt;&lt;/div&gt;&lt;button class="nav" data-page="submissions"&gt;&lt;span&gt;⇧&lt;/span&gt; Submissions&lt;/button&gt;&lt;button class="nav" data-page="ca-browser"&gt;&lt;span&gt;⌕&lt;/span&gt; CA Store&lt;/button&gt;
    &lt;div class="rail-label tools-label"&gt;TOOLS&lt;/div&gt;&lt;button class="nav" data-page="ca-shim"&gt;&lt;span&gt;▤&lt;/span&gt; Repository preview&lt;/button&gt;&lt;button class="nav" data-page="settings"&gt;&lt;span&gt;⚙&lt;/span&gt; Settings&lt;/button&gt;&lt;button class="nav" data-page="docs"&gt;&lt;span&gt;⌘&lt;/span&gt; Unraid docs&lt;/button&gt;
    &lt;div class="rail-bottom"&gt;&lt;span class="avatar"&gt;M&lt;/span&gt;&lt;span&gt;&lt;b&gt;Local workspace&lt;/b&gt;&lt;small&gt;Not connected to CA&lt;/small&gt;&lt;/span&gt;&lt;span class="green-dot"&gt;&lt;/span&gt;&lt;/div&gt;
  &lt;/aside&gt;
  &lt;main&gt;&lt;header&gt;&lt;div class="crumb"&gt;WORKSPACE &lt;span&gt;/&lt;/span&gt; &lt;b id="crumb"&gt;Repository&lt;/b&gt;&lt;/div&gt;&lt;div class="header-right"&gt;&lt;button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to light theme" title="Switch theme"&gt;☼&lt;/button&gt;&lt;span class="local-tag"&gt;&lt;i&gt;&lt;/i&gt; LOCAL&lt;/span&gt;&lt;/div&gt;&lt;/header&gt;
    &lt;section id="repository" class="page active-page"&gt;
      &lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;MAINTAINER WORKSPACE&lt;/div&gt;&lt;h1&gt;Repository overview&lt;/h1&gt;&lt;p&gt;Prepare and validate your Community Apps repository before submitting.&lt;/p&gt;&lt;/div&gt;&lt;button class="primary" id="openRepo"&gt;＋ Connect repository&lt;/button&gt;&lt;/div&gt;
      &lt;div class="repo-bar"&gt;&lt;div class="repo-icon"&gt;⌘&lt;/div&gt;&lt;div class="repo-name"&gt;&lt;b id="repoName"&gt;No repository connected&lt;/b&gt;&lt;span id="repoUrl"&gt;Choose a local folder to begin&lt;/span&gt;&lt;/div&gt;&lt;span class="branch"&gt;Local&lt;/span&gt;&lt;span id="repoSyncInfo" class="repo-sync-info"&gt;&lt;/span&gt;&lt;button class="subtle" id="editRepo"&gt;Change repository&lt;/button&gt;&lt;/div&gt;
      &lt;details id="bootstrapCard" class="bootstrap-card"&gt;&lt;summary&gt;New repository from Unraid starter&lt;/summary&gt;&lt;div class="bootstrap-copy"&gt;Create a public repository from Unraid’s official starter, clone it here, and edit its files in this app.&lt;/div&gt;&lt;form id="bootstrapForm" class="bootstrap-form"&gt;&lt;label&gt;GitHub personal access token&lt;input id="githubToken" name="token" type="password" autocomplete="off" placeholder="Optional if a token is saved in Settings"&gt;&lt;small&gt;Uses your saved Settings token, or this one-time token if supplied. Fine-grained tokens need repository creation and contents access. Classic tokens need the &lt;code&gt;public_repo&lt;/code&gt; scope. &lt;a href="https://docs.github.com/en/rest/repos/repos#create-a-repository-using-a-template" target="_blank" rel="noreferrer"&gt;GitHub permission details ↗&lt;/a&gt;&lt;/small&gt;&lt;/label&gt;&lt;div class="form-pair"&gt;&lt;label&gt;Repository name&lt;input name="name" required pattern="[A-Za-z0-9_.-]{1,100}" placeholder="my-community-apps"&gt;&lt;/label&gt;&lt;label&gt;Clone into existing folder&lt;input name="parent" required value="~/dev" placeholder="/home/you/dev"&gt;&lt;/label&gt;&lt;/div&gt;&lt;label&gt;Repository description&lt;input name="description" maxlength="350" placeholder="Community Apps submissions"&gt;&lt;/label&gt;&lt;label&gt;Community Apps profile description&lt;textarea name="overview" required maxlength="4000" rows="3" placeholder="Describe what you maintain and where users can get support."&gt;&lt;/textarea&gt;&lt;/label&gt;&lt;label&gt;Support forum URL &lt;span class="muted-inline"&gt;(optional)&lt;/span&gt;&lt;input name="support_url" type="url" placeholder="https://forums.unraid.net/topic/..."&gt;&lt;/label&gt;&lt;p class="bootstrap-note"&gt;This creates the repository under the GitHub account that owns the token. It is public so Community Apps can access it. The starter files are cloned locally; you can edit or remove them below.&lt;/p&gt;&lt;button class="primary small" type="submit"&gt;Create &amp;amp; clone starter repository&lt;/button&gt;&lt;span id="bootstrapStatus" class="bootstrap-status" aria-live="polite"&gt;&lt;/span&gt;&lt;/form&gt;&lt;/details&gt;
      &lt;div class="stats"&gt;&lt;div class="stat"&gt;&lt;span&gt;READINESS&lt;/span&gt;&lt;strong id="readinessStat"&gt;—&lt;/strong&gt;&lt;em id="readinessLabel"&gt;Connect a repository&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;APP TEMPLATES&lt;/span&gt;&lt;strong id="appCount"&gt;—&lt;/strong&gt;&lt;em&gt;Docker templates found&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;PLUGINS&lt;/span&gt;&lt;strong id="pluginCount"&gt;—&lt;/strong&gt;&lt;em&gt;Plugin wrappers found&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;LAST VALIDATION&lt;/span&gt;&lt;strong class="date" id="validationDate"&gt;—&lt;/strong&gt;&lt;em id="validationLabel"&gt;Not run yet&lt;/em&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;div class="content-grid"&gt;&lt;section class="panel readiness"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Repository readiness&lt;/h2&gt;&lt;p&gt;Repository files, profile, license, and public GitHub availability&lt;/p&gt;&lt;/div&gt;&lt;button class="text-button" id="validate"&gt;Check repository &lt;span&gt;↗&lt;/span&gt;&lt;/button&gt;&lt;/div&gt;
        &lt;div id="readinessChecks"&gt;&lt;div class="check-row"&gt;&lt;span class="check warn"&gt;!&lt;/span&gt;&lt;div&gt;&lt;b&gt;Connect a repository&lt;/b&gt;&lt;small&gt;Readiness checks will use files in your selected folder&lt;/small&gt;&lt;/div&gt;&lt;span class="pill pending"&gt;PENDING&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;/section&gt;&lt;section class="panel files"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Repository files&lt;/h2&gt;&lt;p&gt;Files detected in the connected folder&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;
        &lt;div id="repoFileList" class="repo-file-list"&gt;&lt;div class="history-empty"&gt;Connect a repository to browse its files.&lt;/div&gt;&lt;/div&gt;
        &lt;button class="full-button" id="browseFiles"&gt;Browse repository setup files &lt;span&gt;→&lt;/span&gt;&lt;/button&gt;
      &lt;/section&gt;&lt;/div&gt;

      &lt;section id="readyNextPanel" class="panel next" hidden&gt;&lt;div class="next-mark"&gt;✓&lt;/div&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;REPOSITORY READY&lt;/div&gt;&lt;h2&gt;Repository readiness checks are green&lt;/h2&gt;&lt;p&gt;Continue to Applications to review each Docker template, fix validation errors, and prepare submissions.&lt;/p&gt;&lt;/div&gt;&lt;button class="primary" id="readyValidate" type="button"&gt;Open applications &lt;span&gt;→&lt;/span&gt;&lt;/button&gt;&lt;/section&gt;
      &lt;section class="panel next"&gt;&lt;div class="next-mark"&gt;✳&lt;/div&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;YOUR NEXT STEP&lt;/div&gt;&lt;h2&gt;Build and manage your Docker applications&lt;/h2&gt;&lt;p&gt;Create templates, add icons, validate each app, and continue through the CA submission workflow.&lt;/p&gt;&lt;/div&gt;&lt;button class="primary" data-go="applications"&gt;Open applications &lt;span&gt;→&lt;/span&gt;&lt;/button&gt;&lt;/section&gt;
      &lt;div class="footnote"&gt;Guidance based on &lt;a href="https://ca.unraid.net/submit/help" target="_blank"&gt;Unraid Community Apps submission help ↗&lt;/a&gt;&lt;/div&gt;
    &lt;/section&gt;
    &lt;section id="applications" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;DOCKER APP WORKSPACE&lt;/div&gt;&lt;h1&gt;Applications&lt;/h1&gt;&lt;p&gt;Create and maintain Docker templates, track their CA submission progress, and review published app details.&lt;/p&gt;&lt;/div&gt;&lt;button class="primary" data-go="template-editor"&gt;＋ Create application&lt;/button&gt;&lt;/div&gt;
      &lt;div class="app-workflow-actions"&gt;&lt;button class="outline" data-go="compose"&gt;Convert Compose file&lt;/button&gt;&lt;button class="outline" data-go="template-editor"&gt;Create or edit template&lt;/button&gt;&lt;button class="outline" data-go="icon-tools"&gt;Manage app icons&lt;/button&gt;&lt;/div&gt;
      &lt;div class="stats app-stats"&gt;&lt;div class="stat"&gt;&lt;span&gt;DOCKER APPLICATIONS&lt;/span&gt;&lt;strong id="applicationCount"&gt;—&lt;/strong&gt;&lt;em&gt;In connected repository&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;PASSING VALIDATION&lt;/span&gt;&lt;strong id="applicationReadyCount"&gt;—&lt;/strong&gt;&lt;em&gt;Ready for submission review&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;SUBMITTED / PUBLISHED&lt;/span&gt;&lt;strong id="applicationSubmissionState"&gt;—&lt;/strong&gt;&lt;em&gt;Tracked locally; confirm in CA portal&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;PUBLISHED APPS&lt;/span&gt;&lt;strong id="applicationMetricsState"&gt;—&lt;/strong&gt;&lt;em&gt;Eligible for CA Store statistics&lt;/em&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;section id="populatePanel" class="panel populate-panel" hidden&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;FIRST SUBMISSION FILES&lt;/div&gt;&lt;h2&gt;Build a starter app template&lt;/h2&gt;&lt;p&gt;Your repository checks are ready for its first example. Add the app details and icon; CA Workshop will create the XML in &lt;code&gt;templates/&lt;/code&gt; and update &lt;code&gt;ca_profile.xml&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;&lt;span class="tag"&gt;GUIDED SETUP&lt;/span&gt;&lt;/div&gt;&lt;form id="populateForm" class="bootstrap-form"&gt;&lt;div class="form-pair"&gt;&lt;label&gt;App name&lt;input name="name" required maxlength="100" value="Example Web App"&gt;&lt;/label&gt;&lt;label&gt;Docker image&lt;input name="image" required maxlength="300" value="nginx:alpine" placeholder="ghcr.io/owner/app:latest"&gt;&lt;/label&gt;&lt;/div&gt;&lt;div class="form-pair"&gt;&lt;label&gt;Project page&lt;input name="project" type="url" required value="https://github.com" placeholder="https://github.com/owner/project"&gt;&lt;/label&gt;&lt;label&gt;Support page &lt;span class="muted-inline"&gt;(optional)&lt;/span&gt;&lt;input name="support" type="url" placeholder="https://forums.unraid.net/topic/..."&gt;&lt;/label&gt;&lt;/div&gt;&lt;div class="form-pair"&gt;&lt;label&gt;Container web port&lt;input name="container_port" required inputmode="numeric" value="80"&gt;&lt;/label&gt;&lt;label&gt;Suggested host port&lt;input name="host_port" required inputmode="numeric" value="8080"&gt;&lt;/label&gt;&lt;/div&gt;&lt;label&gt;What does the app do?&lt;textarea name="overview" required maxlength="2000" rows="3"&gt;A sample web application template. Replace this example with a short description of your app.&lt;/textarea&gt;&lt;/label&gt;&lt;label&gt;Repository profile&lt;textarea name="profile" required maxlength="4000" rows="3"&gt;Example Community Apps repository. Replace this text with an overview of the apps you maintain and where users can get support.&lt;/textarea&gt;&lt;/label&gt;&lt;label&gt;App icon&lt;input id="populateIcon" type="file" accept="image/png" required&gt;&lt;small&gt;Upload a PNG image up to 2 MB. It will be saved as &lt;code&gt;icon.png&lt;/code&gt; in the repository root.&lt;/small&gt;&lt;/label&gt;&lt;label class="check-option"&gt;&lt;input name="removePluginExample" type="checkbox" checked&gt;&lt;span&gt;Remove the unused starter plugin example if it is still a placeholder&lt;/span&gt;&lt;/label&gt;&lt;button class="primary small" type="submit"&gt;Create example files&lt;/button&gt;&lt;span id="populateStatus" class="bootstrap-status" aria-live="polite"&gt;&lt;/span&gt;&lt;/form&gt;&lt;/section&gt;
      &lt;section class="panel app-list-panel"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Your Docker applications&lt;/h2&gt;&lt;p&gt;Templates and icons are managed here; repository setup files stay in Repository.&lt;/p&gt;&lt;/div&gt;&lt;button class="text-button" id="refreshApplications" type="button"&gt;Refresh &lt;span&gt;↻&lt;/span&gt;&lt;/button&gt;&lt;/div&gt;&lt;div id="applicationList" class="application-list"&gt;&lt;div class="history-empty"&gt;Connect a repository to see its Docker applications.&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;/section&gt;
    &lt;section id="application-stats" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;PUBLISHED DOCKER APPS&lt;/div&gt;&lt;h1&gt;Application statistics&lt;/h1&gt;&lt;p&gt;CA Store details and available metrics for apps you have marked as published.&lt;/p&gt;&lt;/div&gt;&lt;button class="outline" id="refreshApplicationStats" type="button"&gt;Refresh statistics&lt;/button&gt;&lt;/div&gt;&lt;div class="notice"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;Mark an app as published in Submissions after confirming its approval in the CA portal. Metrics come from the CA catalog; fields it does not provide will show as unavailable.&lt;/p&gt;&lt;/div&gt;&lt;div id="publishedApplicationStats" class="application-list"&gt;&lt;div class="history-empty"&gt;Loading published apps…&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="submissions" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;SUBMISSION WORKFLOW&lt;/div&gt;&lt;h1&gt;Validate &amp; submit&lt;/h1&gt;&lt;p&gt;Run a local preflight, then continue the official submission in Community Apps.&lt;/p&gt;&lt;/div&gt;&lt;a class="primary link-button" href="https://ca.unraid.net/submit/new" target="_blank" rel="noreferrer"&gt;Open CA submission ↗&lt;/a&gt;&lt;/div&gt;
      &lt;section class="panel app-submission-panel"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Apps and plugins&lt;/h2&gt;&lt;p&gt;Track each repository item here. Update its status after confirming progress in the CA portal.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="submissionTracker" class="submission-tracker"&gt;&lt;div class="history-empty"&gt;Connect a repository to track app submissions.&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;
      &lt;section class="panel portal-panel"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Official Community Apps submission portal&lt;/h2&gt;&lt;p&gt;Sync the repository to GitHub before opening the submission workflow.&lt;/p&gt;&lt;/div&gt;&lt;div class="portal-actions"&gt;&lt;button id="reloadCAPortal" class="outline" type="button"&gt;Open portal here&lt;/button&gt;&lt;a class="text-button" href="https://ca.unraid.net/submit/new" target="_blank" rel="noreferrer"&gt;Open in new tab ↗&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;iframe id="caSubmissionFrame" src="https://ca.unraid.net/submit/new" title="Community Apps submission portal" loading="lazy" referrerpolicy="no-referrer"&gt;&lt;/iframe&gt;&lt;div class="portal-footnote"&gt;If sign-in or a popup is blocked in the embedded view, open the portal in a new tab after the repository is synced.&lt;/div&gt;&lt;/section&gt;
      &lt;div class="workflow"&gt;&lt;div class="step"&gt;&lt;span&gt;1&lt;/span&gt;&lt;div&gt;&lt;b&gt;Local preflight&lt;/b&gt;&lt;small&gt;Run in this workspace&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class="connector"&gt;&lt;/div&gt;&lt;div class="step"&gt;&lt;span&gt;2&lt;/span&gt;&lt;div&gt;&lt;b&gt;Official Validate&lt;/b&gt;&lt;small&gt;Run on CA portal&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class="connector"&gt;&lt;/div&gt;&lt;div class="step"&gt;&lt;span&gt;3&lt;/span&gt;&lt;div&gt;&lt;b&gt;Official Scan&lt;/b&gt;&lt;small&gt;Run on CA portal&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class="connector"&gt;&lt;/div&gt;&lt;div class="step"&gt;&lt;span&gt;4&lt;/span&gt;&lt;div&gt;&lt;b&gt;Submit&lt;/b&gt;&lt;small&gt;Complete on CA portal&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;div class="submission-grid"&gt;&lt;section class="panel"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Local preflight&lt;/h2&gt;&lt;p&gt;Check required repository files and template structure&lt;/p&gt;&lt;/div&gt;&lt;button class="primary small" id="validate2"&gt;Run preflight&lt;/button&gt;&lt;/div&gt;&lt;div id="validationResult" class="empty-result"&gt;&lt;div class="empty-icon"&gt;✓&lt;/div&gt;&lt;b&gt;Ready when you are&lt;/b&gt;&lt;p&gt;This local check does not contact the CA submission portal.&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class="panel history"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Local activity&lt;/h2&gt;&lt;p&gt;Actions recorded by this workspace&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="activityHistory" class="history-empty"&gt;&lt;div&gt;◷&lt;/div&gt;&lt;b&gt;No local activity yet&lt;/b&gt;&lt;p&gt;Connect a repository or run a preflight to begin.&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;
      &lt;div class="notice"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;This local preflight checks files and XML structure. Official Validate, Scan, submission status, and review are handled in &lt;a href="https://ca.unraid.net/submit/new" target="_blank" rel="noreferrer"&gt;Unraid Community Apps&lt;/a&gt;.&lt;/p&gt;&lt;/div&gt;
    &lt;/section&gt;
    &lt;section id="plugins" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;UNRAID PLUGINS&lt;/div&gt;&lt;h1&gt;Plugins&lt;/h1&gt;&lt;p&gt;Review plugin wrappers in your repository and track their Community Apps submission status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class="stats app-stats"&gt;&lt;div class="stat"&gt;&lt;span&gt;PLUGIN WRAPPERS&lt;/span&gt;&lt;strong id="pluginWorkspaceCount"&gt;—&lt;/strong&gt;&lt;em&gt;In connected repository&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;PASSING VALIDATION&lt;/span&gt;&lt;strong id="pluginReadyCount"&gt;—&lt;/strong&gt;&lt;em&gt;Ready for submission review&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;SUBMITTED / PUBLISHED&lt;/span&gt;&lt;strong id="pluginSubmissionCount"&gt;—&lt;/strong&gt;&lt;em&gt;Tracked locally&lt;/em&gt;&lt;/div&gt;&lt;div class="stat"&gt;&lt;span&gt;PUBLISHED PLUGINS&lt;/span&gt;&lt;strong id="pluginPublishedCount"&gt;—&lt;/strong&gt;&lt;em&gt;Eligible for CA Store statistics&lt;/em&gt;&lt;/div&gt;&lt;/div&gt;&lt;section class="panel app-list-panel"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Your plugins&lt;/h2&gt;&lt;p&gt;Plugin XML wrappers are read from the &lt;code&gt;plugins/&lt;/code&gt; folder.&lt;/p&gt;&lt;/div&gt;&lt;button class="text-button" id="refreshPlugins" type="button"&gt;Refresh &lt;span&gt;↻&lt;/span&gt;&lt;/button&gt;&lt;/div&gt;&lt;div id="pluginList" class="application-list"&gt;&lt;div class="history-empty"&gt;Connect a repository to see plugin wrappers.&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;/section&gt;
    &lt;section id="plugin-stats" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;PUBLISHED PLUGINS&lt;/div&gt;&lt;h1&gt;Plugin statistics&lt;/h1&gt;&lt;p&gt;CA Store details and metrics for plugins you have marked as published.&lt;/p&gt;&lt;/div&gt;&lt;button class="outline" id="refreshPluginStats" type="button"&gt;Refresh statistics&lt;/button&gt;&lt;/div&gt;&lt;div class="notice"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;Mark a plugin as Published after confirming approval in the CA portal. Available CA Store metrics are shown for each published plugin.&lt;/p&gt;&lt;/div&gt;&lt;div id="publishedPluginStats" class="application-list"&gt;&lt;div class="history-empty"&gt;Loading published plugins…&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="settings" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;WORKSPACE CONFIGURATION&lt;/div&gt;&lt;h1&gt;Settings&lt;/h1&gt;&lt;p&gt;Set up GitHub access, local AI assistance, repository publishing, and Unraid server authorization.&lt;/p&gt;&lt;/div&gt;&lt;button id="refreshSettings" class="outline" type="button"&gt;Refresh settings&lt;/button&gt;&lt;/div&gt;
      &lt;section class="panel settings-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;GitHub access&lt;/h2&gt;&lt;p&gt;Save a token for repository checks and HTTPS pushes.&lt;/p&gt;&lt;/div&gt;&lt;span id="githubSettingsBadge" class="pill pending"&gt;NOT CONNECTED&lt;/span&gt;&lt;/div&gt;&lt;form id="githubSettingsForm" class="settings-form"&gt;&lt;label&gt;GitHub personal access token&lt;input id="settingsGithubToken" type="password" autocomplete="new-password" placeholder="Paste token to connect or replace it"&gt;&lt;small&gt;Use a fine-grained token with Contents: write access to the connected repository. The token is stored in a private local settings file with owner-only permissions; it is never written into the repository.&lt;/small&gt;&lt;/label&gt;&lt;div class="settings-actions"&gt;&lt;button class="primary small" type="submit"&gt;Verify &amp;amp; save token&lt;/button&gt;&lt;button id="removeGithubToken" class="outline" type="button" hidden&gt;Remove saved token&lt;/button&gt;&lt;span id="githubSettingsStatus" aria-live="polite"&gt;No GitHub token saved.&lt;/span&gt;&lt;/div&gt;&lt;/form&gt;&lt;/section&gt;
      &lt;section class="panel settings-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Local AI assistant&lt;/h2&gt;&lt;p&gt;Connect an OpenAI-compatible endpoint on this computer or local network to list models and draft text in app fields.&lt;/p&gt;&lt;/div&gt;&lt;span id="aiSettingsBadge" class="pill pending"&gt;NOT CONNECTED&lt;/span&gt;&lt;/div&gt;&lt;form id="aiSettingsForm" class="settings-form"&gt;&lt;div class="form-pair ai-connection-fields"&gt;&lt;label&gt;API base URL&lt;input id="aiBaseUrl" type="url" autocomplete="off" spellcheck="false" placeholder="http://127.0.0.1:11434/v1"&gt;&lt;small&gt;OpenAI-compatible base URL. Ollama uses port 11434 and LM Studio uses 1234; the app adds &lt;code&gt;/v1&lt;/code&gt; when it is missing.&lt;/small&gt;&lt;/label&gt;&lt;label&gt;API key &lt;span class="muted-inline"&gt;(optional)&lt;/span&gt;&lt;input id="aiApiKey" type="password" autocomplete="new-password" placeholder="Leave blank if the endpoint has no key"&gt;&lt;small&gt;Stored in a private local settings file with owner-only permissions; never added to the repository.&lt;/small&gt;&lt;/label&gt;&lt;/div&gt;&lt;div class="settings-actions"&gt;&lt;button id="aiDiscoverModels" class="outline" type="button"&gt;Check connection &amp;amp; list models&lt;/button&gt;&lt;span id="aiSettingsStatus" aria-live="polite"&gt;Not connected.&lt;/span&gt;&lt;/div&gt;&lt;label class="ai-model-field"&gt;Model&lt;select id="aiModel"&gt;&lt;option value=""&gt;Check the endpoint to load models&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;div class="settings-actions"&gt;&lt;button class="primary small" type="submit"&gt;Save AI settings&lt;/button&gt;&lt;button id="removeAISettings" class="outline" type="button" hidden&gt;Remove AI settings&lt;/button&gt;&lt;small&gt;Text for a field is sent only to the endpoint you configure. Review generated text before saving it.&lt;/small&gt;&lt;/div&gt;&lt;/form&gt;&lt;/section&gt;
      &lt;section class="panel settings-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Sync repository to GitHub&lt;/h2&gt;&lt;p&gt;Push Docker templates, plugin wrappers, and icons before marking submissions sent.&lt;/p&gt;&lt;/div&gt;&lt;button id="refreshSyncStatus" class="outline" type="button"&gt;Check sync status&lt;/button&gt;&lt;/div&gt;&lt;div id="syncStatus" class="sync-status"&gt;Checking repository status…&lt;/div&gt;&lt;div id="syncFileList" class="sync-file-list"&gt;&lt;/div&gt;&lt;form id="syncForm" class="settings-form"&gt;&lt;label&gt;Commit message&lt;input id="syncCommitMessage" maxlength="200" value="Update Community Apps submission" required&gt;&lt;/label&gt;&lt;button id="syncRepository" class="primary small" type="submit"&gt;Commit app files &amp;amp; push&lt;/button&gt;&lt;small&gt;Only .gitignore exclusions are excluded; everything else under the repository is included in this sync. Pushes use the current branch and do not force-push.&lt;/small&gt;&lt;/form&gt;&lt;/section&gt;
      &lt;section class="panel settings-card common-vars-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Common install variables&lt;/h2&gt;&lt;p&gt;Save values such as PUID, PGID, and TZ. Matching Docker template variables are filled automatically in the CA Store installer.&lt;/p&gt;&lt;/div&gt;&lt;button id="addCommonInstallVar" class="outline" type="button"&gt;＋ Add variable&lt;/button&gt;&lt;/div&gt;&lt;form id="commonInstallVarsForm" class="settings-form"&gt;&lt;div id="commonInstallVars" class="common-install-vars"&gt;&lt;/div&gt;&lt;div class="settings-actions"&gt;&lt;button class="primary small" type="submit"&gt;Save install variables&lt;/button&gt;&lt;span id="commonInstallVarsStatus" aria-live="polite"&gt;Saved server-side (persists across browsers).&lt;/span&gt;&lt;/div&gt;&lt;/form&gt;&lt;/section&gt;&lt;section class="panel settings-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Unraid server authorization&lt;/h2&gt;&lt;p&gt;Use the server’s own sign-in and OIDC setup to authorize API access.&lt;/p&gt;&lt;/div&gt;&lt;a class="text-button" href="https://docs.unraid.net/API/api-key-app-developer-authorization-flow/" target="_blank" rel="noreferrer"&gt;Authorization guide ↗&lt;/a&gt;&lt;/div&gt;&lt;form id="unraidConnectForm" class="unraid-connect-form"&gt;&lt;label&gt;Unraid server address&lt;input id="unraidHost" type="url" required placeholder="http://tower.local or https://tower.example.com"&gt;&lt;/label&gt;&lt;button class="primary small" type="submit"&gt;Authorize Docker controls&lt;/button&gt;&lt;/form&gt;&lt;div id="unraidStatus" class="unraid-status"&gt;Not connected. The app requests &lt;code&gt;system:read&lt;/code&gt;, &lt;code&gt;docker:read&lt;/code&gt;, &lt;code&gt;docker:update&lt;/code&gt;, and &lt;code&gt;docker:delete&lt;/code&gt;.&lt;/div&gt;&lt;div id="unraidContainers" class="unraid-containers"&gt;&lt;/div&gt;&lt;button id="unraidDisconnect" class="text-button" hidden&gt;Disconnect server&lt;/button&gt;&lt;p class="unraid-note"&gt;If Unraid.net OIDC is enabled on the server, its authorization page handles sign-in. CA portal sign-in is separate.&lt;/p&gt;&lt;/section&gt;
      &lt;section class="panel settings-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Host runtime&lt;/h2&gt;&lt;p&gt;Where CA Workshop is running and which host services it can use.&lt;/p&gt;&lt;/div&gt;&lt;span id="runtimeBadge" class="pill pending"&gt;CHECKING&lt;/span&gt;&lt;/div&gt;&lt;div id="runtimeStatus" class="runtime-status"&gt;Checking the host runtime…&lt;/div&gt;&lt;/section&gt;
      &lt;section class="panel settings-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Unraid Dashboard widget&lt;/h2&gt;&lt;p&gt;Display your pending approvals, approved apps, and submission statuses as a widget on the Unraid Dashboard.&lt;/p&gt;&lt;/div&gt;&lt;span id="dashboardWidgetBadge" class="pill good"&gt;ENABLED&lt;/span&gt;&lt;/div&gt;&lt;div class="settings-actions"&gt;&lt;label class="check-option"&gt;&lt;input id="dashboardWidgetToggle" type="checkbox" checked&gt;&lt;span&gt;Enable CA Workshop widget on the Unraid Dashboard&lt;/span&gt;&lt;/label&gt;&lt;/div&gt;&lt;small&gt;The widget displays each app as an icon with its name and approval status below. Turn this off if you do not want the widget on your main dashboard.&lt;/small&gt;&lt;/section&gt;
      &lt;section class="panel settings-card"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Local preferences&lt;/h2&gt;&lt;p&gt;Choose the appearance used by this browser.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;button id="settingsThemeToggle" class="outline" type="button"&gt;Toggle light / dark theme&lt;/button&gt;&lt;p class="settings-footnote"&gt;CA Workshop stays bound to this computer. Unraid OIDC client settings are managed by your Unraid server; there is no separate app client secret to enter here.&lt;/p&gt;&lt;/section&gt;
      &lt;/section&gt;
    &lt;section id="ca-shim" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;LOCAL COMPATIBILITY LAYER&lt;/div&gt;&lt;h1&gt;Community Apps shim&lt;/h1&gt;&lt;p&gt;Preview your repository like a small local CA catalog and route Docker templates to your Docker server.&lt;/p&gt;&lt;/div&gt;&lt;span class="local-tag"&gt;&lt;i&gt;&lt;/i&gt; LOCAL ONLY&lt;/span&gt;&lt;/div&gt;&lt;div class="shim-banner"&gt;&lt;span&gt;↔&lt;/span&gt;&lt;div&gt;&lt;b&gt;Supported here: catalog metadata, template checks, and Docker template installs.&lt;/b&gt;&lt;small&gt;The original Unraid PHP plugin is not running in this shim.&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;&lt;section class="panel shim-repo"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2 id="shimRepoName"&gt;Connected repository&lt;/h2&gt;&lt;p id="shimProfile"&gt;Repository profile details&lt;/p&gt;&lt;/div&gt;&lt;a class="text-button" href="https://ca.unraid.net/submit/new" target="_blank" rel="noreferrer"&gt;Official CA Submit ↗&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;&lt;div class="shim-heading"&gt;&lt;div&gt;&lt;h2&gt;Docker applications&lt;/h2&gt;&lt;p&gt;Install-ready XML templates can be launched with the local Docker adapter.&lt;/p&gt;&lt;/div&gt;&lt;input id="catalogSearch" type="search" placeholder="Search your repository"&gt;&lt;/div&gt;&lt;div id="shimApps" class="ca-catalog-grid"&gt;&lt;div class="shim-empty"&gt;Loading local catalog…&lt;/div&gt;&lt;/div&gt;&lt;div class="shim-heading plugin-heading"&gt;&lt;div&gt;&lt;h2&gt;Plugin wrappers&lt;/h2&gt;&lt;p&gt;Review manifest links and metadata. Installation requires an Unraid host.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="shimPlugins" class="ca-catalog-grid"&gt;&lt;/div&gt;&lt;div class="notice"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;The CA plugin itself reads Unraid version/config files and loads WebGUI/Docker Manager libraries. This shim models selected behavior and uses Docker for templates; it does not execute `.plg` install hooks.&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="ca-browser" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;COMMUNITY APPS CATALOG&lt;/div&gt;&lt;h1&gt;Browse CA&lt;/h1&gt;&lt;p&gt;Catalog organization follows Community Applications’ categories, popularity, and listing details. Docker installs use this computer’s Docker server.&lt;/p&gt;&lt;/div&gt;&lt;a class="primary link-button" href="https://ca.unraid.net/" target="_blank" rel="noreferrer"&gt;Open Community Apps ↗&lt;/a&gt;&lt;/div&gt;&lt;div class="ca-browser-controls"&gt;&lt;form id="caSearchForm" class="ca-search-form"&gt;&lt;input id="caSearch" type="search" placeholder="Search apps and plugins" aria-label="Search apps and plugins"&gt;&lt;button class="primary" type="submit"&gt;Search&lt;/button&gt;&lt;/form&gt;&lt;div class="ca-filter-row"&gt;&lt;select id="caCategory" aria-label="Filter by category"&gt;&lt;option value="all"&gt;All categories&lt;/option&gt;&lt;/select&gt;&lt;select id="caType" aria-label="Filter by type"&gt;&lt;option value="all"&gt;Apps and plugins&lt;/option&gt;&lt;option value="docker"&gt;Docker apps&lt;/option&gt;&lt;option value="plugin"&gt;Plugins&lt;/option&gt;&lt;/select&gt;&lt;select id="caSort" aria-label="Sort results"&gt;&lt;option value="popularity"&gt;Popular&lt;/option&gt;&lt;option value="topTrending"&gt;Trending&lt;/option&gt;&lt;option value="topPerforming"&gt;Top new installs&lt;/option&gt;&lt;option value="newest"&gt;Recently added&lt;/option&gt;&lt;option value="name"&gt;Name&lt;/option&gt;&lt;/select&gt;&lt;button id="popularPlugins" class="outline" type="button"&gt;Popular plugins&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class="ca-results-head"&gt;&lt;span id="caResultSummary"&gt;Loading catalog…&lt;/span&gt;&lt;span id="caScrollStatus" aria-live="polite"&gt;&lt;/span&gt;&lt;/div&gt;&lt;div id="caResults" class="ca-market-grid"&gt;&lt;/div&gt;&lt;div id="caScrollSentinel" class="ca-scroll-sentinel" aria-live="polite"&gt;Loading CA Store entries…&lt;/div&gt;&lt;div id="storeInstallerBackdrop" class="ca-install-backdrop" hidden&gt;&lt;/div&gt;&lt;aside id="storeInstaller" class="ca-install-drawer" role="dialog" aria-modal="true" aria-labelledby="storeInstallerTitle" hidden&gt;&lt;div class="ca-install-drawer-head"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;DOCKER INSTALL&lt;/div&gt;&lt;h2 id="storeInstallerTitle"&gt;Review Docker template&lt;/h2&gt;&lt;p&gt;Choose settings for this local sandbox install.&lt;/p&gt;&lt;/div&gt;&lt;button id="closeStoreInstaller" class="drawer-close" type="button" aria-label="Close installer"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;form id="templateForm" class="docker-form"&gt;&lt;label&gt;CA Store Docker template&lt;select id="templateSelect" name="template" required&gt;&lt;option value=""&gt;Choose an app above&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;div id="templateSummary" class="template-summary"&gt;&lt;/div&gt;&lt;div id="templateInputs" class="template-inputs"&gt;&lt;/div&gt;&lt;label&gt;Sandbox container name&lt;input id="templateName" name="name" value="ca-app-test" required&gt;&lt;/label&gt;&lt;button class="primary small" type="submit"&gt;Install to Docker sandbox&lt;/button&gt;&lt;/form&gt;&lt;/aside&gt;&lt;div class="notice"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;Community Apps archive files guide the local catalog’s layout and workflow. Listings and template XML are loaded from the official live CA catalog. Plugin listings open in the CA portal because plugin installation requires an Unraid host.&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;div class="sandbox-note"&gt;&lt;b&gt;Sandbox controls&lt;/b&gt;&lt;span&gt;Apps launched from the CA Store run with workshop resource limits. Published ports bind to loopback. Storage uses isolated Docker volumes unless you choose a host bind mount during install.&lt;/span&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="compose" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;TEMPLATE BUILDER&lt;/div&gt;&lt;h1&gt;Docker Compose import&lt;/h1&gt;&lt;p&gt;Map Compose services into the dummy XML starter, then continue each result in the graphical template editor.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class="notice compose-intro"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;Compose images, ports, volumes, and environment variables fill matching fields in the same dummy XML starter used by the Template Editor. Unsupported settings are shown for review; secrets are left blank. Continue each generated service in the graphical editor before saving.&lt;/p&gt;&lt;/div&gt;&lt;section class="panel compose-panel"&gt;&lt;form id="composeForm" class="compose-form"&gt;&lt;label&gt;Choose a Compose file&lt;input id="composeFileInput" type="file" accept=".yaml,.yml,application/yaml,text/yaml"&gt;&lt;/label&gt;&lt;label&gt;Compose contents&lt;textarea id="composeSource" rows="14" spellcheck="false" placeholder="services:
  web:
    image: nginx:alpine
    ports:
      - 8080:80
"&gt;&lt;/textarea&gt;&lt;/label&gt;&lt;div class="compose-form-footer"&gt;&lt;span id="composeRepoStatus"&gt;Checking repository…&lt;/span&gt;&lt;button class="primary" id="convertCompose" type="submit"&gt;Generate templates&lt;/button&gt;&lt;/div&gt;&lt;/form&gt;&lt;/section&gt;&lt;div id="composeMessage" class="compose-message" aria-live="polite"&gt;&lt;/div&gt;&lt;div id="composeResults" class="compose-results"&gt;&lt;/div&gt;&lt;div class="compose-save-row"&gt;&lt;button id="saveComposeTemplates" class="primary" type="button" hidden&gt;Save generated templates to repository&lt;/button&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="template-editor" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;DOCKER APPLICATIONS&lt;/div&gt;&lt;h1&gt;Application template editor&lt;/h1&gt;&lt;p&gt;Create or edit Docker template values and save them into your connected repository.&lt;/p&gt;&lt;/div&gt;&lt;div class="application-actions"&gt;&lt;button class="outline" data-go="compose" type="button"&gt;Convert Compose&lt;/button&gt;&lt;button id="startDummyTemplate" class="outline" type="button"&gt;Start from dummy XML&lt;/button&gt;&lt;button class="outline" id="editRawTemplate" type="button"&gt;Edit raw XML&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;section class="panel template-editor-picker"&gt;&lt;label for="templateEditorSelect"&gt;Choose an application template&lt;/label&gt;&lt;select id="templateEditorSelect"&gt;&lt;option value=""&gt;Connect a repository to load templates&lt;/option&gt;&lt;/select&gt;&lt;span id="templateEditorStatus" aria-live="polite"&gt;Connect a repository to begin.&lt;/span&gt;&lt;/section&gt;&lt;div id="templateEditorEmpty" class="history-empty"&gt;Choose a Docker application template or start from the dummy example.&lt;/div&gt;&lt;div id="templateEditorWorkspace" class="template-editor-workspace" hidden&gt;&lt;section class="panel template-editor-fields"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Template fields&lt;/h2&gt;&lt;p&gt;Change values in the template file&lt;/p&gt;&lt;/div&gt;&lt;button id="saveVisualTemplate" class="primary small" type="button"&gt;Save changes&lt;/button&gt;&lt;/div&gt;&lt;label class="template-file-path"&gt;Save template to&lt;input id="templateEditorFilePath" type="text" autocomplete="off" spellcheck="false" placeholder="templates/my-app.xml"&gt;&lt;/label&gt;&lt;div id="templateEditorForm" class="template-editor-form"&gt;&lt;/div&gt;&lt;div id="templateEditorConfigs" class="template-editor-configs"&gt;&lt;/div&gt;&lt;/section&gt;&lt;details class="panel template-xml-preview"&gt;&lt;summary&gt;XML preview&lt;/summary&gt;&lt;pre id="templateEditorPreview"&gt;&lt;/pre&gt;&lt;/details&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="profile-editor" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;REPOSITORY METADATA&lt;/div&gt;&lt;h1&gt;CA profile editor&lt;/h1&gt;&lt;p&gt;Describe your repository and maintainer details in &lt;code&gt;ca_profile.xml&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;&lt;button id="reloadCAProfile" class="outline" type="button"&gt;Reload existing profile&lt;/button&gt;&lt;/div&gt;&lt;div class="notice"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;Edit the sample profile fields or add custom XML fields. Existing nested XML elements are preserved when you save.&lt;/p&gt;&lt;/div&gt;&lt;div class="template-editor-workspace profile-editor-workspace"&gt;&lt;section class="panel template-editor-fields"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Maintainer details&lt;/h2&gt;&lt;p&gt;Saved at the repository root as &lt;code&gt;ca_profile.xml&lt;/code&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class="profile-actions"&gt;&lt;button id="addCAProfileField" class="outline" type="button"&gt;＋ Add field&lt;/button&gt;&lt;button id="saveCAProfile" class="primary small" type="button"&gt;Save profile&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="caProfileForm" class="profile-fields" aria-label="CA profile fields"&gt;&lt;/div&gt;&lt;span id="caProfileStatus" class="bootstrap-status profile-wide" aria-live="polite"&gt;Connect a repository to create or edit its profile.&lt;/span&gt;&lt;/section&gt;&lt;details class="panel template-xml-preview" open&gt;&lt;summary&gt;XML preview&lt;/summary&gt;&lt;pre id="caProfilePreview"&gt;&lt;/pre&gt;&lt;/details&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="icon-tools" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;TEMPLATE ARTWORK&lt;/div&gt;&lt;h1&gt;Icon tools&lt;/h1&gt;&lt;p&gt;Create, check, and update template icons in your repository.&lt;/p&gt;&lt;/div&gt;&lt;button id="refreshIconTools" class="outline" type="button"&gt;Refresh&lt;/button&gt;&lt;/div&gt;&lt;div class="notice"&gt;&lt;span&gt;ⓘ&lt;/span&gt;&lt;p&gt;These tools use the repository’s &lt;code&gt;templates/&lt;/code&gt; and &lt;code&gt;images/&lt;/code&gt; folders. Icon conversion and file handling run in the browser and app, so they work across operating systems without Bash, ImageMagick, or OS-specific &lt;code&gt;stat&lt;/code&gt; commands.&lt;/p&gt;&lt;/div&gt;&lt;div class="icon-tools-grid"&gt;&lt;section class="panel icon-tool-panel"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Font Awesome template icon&lt;/h2&gt;&lt;p&gt;Download an icon, save a PNG, and update the selected template’s Icon URL.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;label&gt;Docker template&lt;select id="fontAwesomeTemplate"&gt;&lt;option value=""&gt;Connect a repository with templates&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;div class="form-pair icon-fa-inputs"&gt;&lt;label&gt;Font Awesome icon name&lt;input id="fontAwesomeName" placeholder="server (without fa-)"&gt;&lt;/label&gt;&lt;label&gt;Style&lt;select id="fontAwesomeStyle"&gt;&lt;option value="solid"&gt;Solid&lt;/option&gt;&lt;option value="regular"&gt;Regular&lt;/option&gt;&lt;option value="brands"&gt;Brands&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;/div&gt;&lt;div class="icon-create-preview"&gt;&lt;div id="fontAwesomePreview" aria-label="Icon preview"&gt;✿&lt;/div&gt;&lt;span id="fontAwesomeStatus" aria-live="polite"&gt;Choose a template and icon name.&lt;/span&gt;&lt;/div&gt;&lt;button id="createFontAwesomeIcon" class="primary small" type="button"&gt;Create icon and update template&lt;/button&gt;&lt;/section&gt;&lt;section class="panel icon-tool-panel"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Missing template icons&lt;/h2&gt;&lt;p&gt;Fill missing convention-named icons from &lt;code&gt;images/placeholder-icon.png&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="placeholderStatus" class="icon-tool-status"&gt;Checking repository images…&lt;/div&gt;&lt;label&gt;Upload placeholder PNG&lt;input id="placeholderIconUpload" type="file" accept="image/png"&gt;&lt;/label&gt;&lt;button id="fillMissingIcons" class="outline" type="button" disabled&gt;Populate missing icons&lt;/button&gt;&lt;div id="missingIconResults" class="icon-tool-results"&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class="panel icon-tool-panel icon-tool-wide"&gt;&lt;div class="panel-head"&gt;&lt;div&gt;&lt;h2&gt;Find and replace placeholder icons&lt;/h2&gt;&lt;p&gt;Compare PNG pixels against the placeholder, then replace exact matches with a chosen image.&lt;/p&gt;&lt;/div&gt;&lt;button id="scanPlaceholderIcons" class="outline" type="button" disabled&gt;Check placeholder icons&lt;/button&gt;&lt;/div&gt;&lt;div class="form-pair"&gt;&lt;label&gt;Replacement PNG&lt;select id="placeholderReplacement"&gt;&lt;option value=""&gt;Choose an image from images/&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;button id="replacePlaceholderIcons" class="primary small" type="button" disabled&gt;Replace matching icons&lt;/button&gt;&lt;/div&gt;&lt;div id="placeholderScanResults" class="icon-tool-results"&gt;Upload a placeholder PNG, then check the repository.&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;&lt;/section&gt;
    &lt;section id="docs" class="page"&gt;&lt;div class="page-heading"&gt;&lt;div&gt;&lt;div class="eyebrow"&gt;REFERENCE&lt;/div&gt;&lt;h1&gt;Unraid submission docs&lt;/h1&gt;&lt;p&gt;Quick access to the official guidance used in this workspace.&lt;/p&gt;&lt;/div&gt;&lt;a class="primary link-button" href="https://ca.unraid.net/submit/help" target="_blank" rel="noreferrer"&gt;Open docs ↗&lt;/a&gt;&lt;/div&gt;&lt;div class="docs-grid"&gt;&lt;a class="doc-card" href="https://ca.unraid.net/submit/help" target="_blank" rel="noreferrer"&gt;&lt;span&gt;01&lt;/span&gt;&lt;b&gt;Submission help&lt;/b&gt;&lt;small&gt;Requirements and recommended starting point&lt;/small&gt;&lt;i&gt;↗&lt;/i&gt;&lt;/a&gt;&lt;a class="doc-card" href="https://ca.unraid.net/submit/help/repository-xml" target="_blank" rel="noreferrer"&gt;&lt;span&gt;02&lt;/span&gt;&lt;b&gt;Repository XML format&lt;/b&gt;&lt;small&gt;Docker templates and plugin wrappers&lt;/small&gt;&lt;i&gt;↗&lt;/i&gt;&lt;/a&gt;&lt;a class="doc-card" href="https://ca.unraid.net/submit/help/repository-info-xml" target="_blank" rel="noreferrer"&gt;&lt;span&gt;03&lt;/span&gt;&lt;b&gt;Repository information XML&lt;/b&gt;&lt;small&gt;ca_profile.xml metadata requirements&lt;/small&gt;&lt;i&gt;↗&lt;/i&gt;&lt;/a&gt;&lt;a class="doc-card" href="https://ca.unraid.net/submit/help/xml-field-reference" target="_blank" rel="noreferrer"&gt;&lt;span&gt;04&lt;/span&gt;&lt;b&gt;XML field reference&lt;/b&gt;&lt;small&gt;Supported public template fields&lt;/small&gt;&lt;i&gt;↗&lt;/i&gt;&lt;/a&gt;&lt;a class="doc-card" href="https://ca.unraid.net/submit/help/builders" target="_blank" rel="noreferrer"&gt;&lt;span&gt;05&lt;/span&gt;&lt;b&gt;Builder guide&lt;/b&gt;&lt;small&gt;Repository structure and quick start&lt;/small&gt;&lt;i&gt;↗&lt;/i&gt;&lt;/a&gt;&lt;a class="doc-card" href="https://github.com/nakedlittlezombie/unraid-community-apps" target="_blank" rel="noreferrer"&gt;&lt;span&gt;06&lt;/span&gt;&lt;b&gt;Your repository&lt;/b&gt;&lt;small&gt;Open the connected project on GitHub&lt;/small&gt;&lt;i&gt;↗&lt;/i&gt;&lt;/a&gt;&lt;a class="doc-card" href="https://docs.unraid.net/API/api-key-app-developer-authorization-flow/" target="_blank" rel="noreferrer"&gt;&lt;span&gt;07&lt;/span&gt;&lt;b&gt;Unraid API authorization&lt;/b&gt;&lt;small&gt;Authorize existing Docker container controls&lt;/small&gt;&lt;i&gt;↗&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class="notice"&gt;&lt;span&gt;✦&lt;/span&gt;&lt;p&gt;For meaningful XML changes, run Validate and then Scan in the official submission flow.&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;
  &lt;/main&gt;&lt;div id="browseDialog" class="file-dialog" hidden&gt;&lt;div class="file-dialog-box"&gt;&lt;div class="file-dialog-head"&gt;&lt;div&gt;&lt;b&gt;Repository files&lt;/b&gt;&lt;small&gt;Select a text file to edit&lt;/small&gt;&lt;/div&gt;&lt;div&gt;&lt;button id="newRepoFile" class="outline" type="button"&gt;New file&lt;/button&gt;&lt;button id="closeBrowse" aria-label="Close"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="allRepoFiles" class="all-repo-files"&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="repoEditorDialog" class="file-dialog" hidden&gt;&lt;div class="file-dialog-box repo-editor-box"&gt;&lt;div class="file-dialog-head"&gt;&lt;div&gt;&lt;b id="repoEditorTitle"&gt;Edit repository file&lt;/b&gt;&lt;small&gt;Changes are saved to your local clone&lt;/small&gt;&lt;/div&gt;&lt;button id="closeRepoEditor" aria-label="Close"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;div class="repo-editor-tools"&gt;&lt;label&gt;File path&lt;input id="repoEditorPath" autocomplete="off" spellcheck="false"&gt;&lt;/label&gt;&lt;button id="deleteRepoFile" class="danger-button" type="button"&gt;Delete file&lt;/button&gt;&lt;/div&gt;&lt;textarea id="repoEditorContent" spellcheck="false" aria-label="Repository file contents"&gt;&lt;/textarea&gt;&lt;div class="repo-editor-footer"&gt;&lt;span id="repoEditorStatus"&gt;Local edits are not pushed to GitHub automatically.&lt;/span&gt;&lt;button id="saveRepoFile" class="primary small" type="button"&gt;Save local changes&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div id="fileDialog" class="file-dialog" hidden&gt;&lt;div class="file-dialog-box"&gt;&lt;div class="file-dialog-head"&gt;&lt;div&gt;&lt;b id="fileTitle"&gt;File preview&lt;/b&gt;&lt;small id="fileSubtitle"&gt;Read-only local preview&lt;/small&gt;&lt;/div&gt;&lt;button id="closeFile" aria-label="Close"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;pre id="fileContent"&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;aside id="installConsole" class="install-console" aria-live="polite" hidden&gt;&lt;div class="install-console-head"&gt;&lt;div&gt;&lt;b id="installConsoleTitle"&gt;Docker install&lt;/b&gt;&lt;small id="installConsoleStage"&gt;Preparing install…&lt;/small&gt;&lt;/div&gt;&lt;button id="installConsoleClose" aria-label="Close install console"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;pre id="installConsoleLog"&gt;Waiting for Docker…&lt;/pre&gt;&lt;/aside&gt;&lt;div id="toast" class="toast"&gt;&lt;/div&gt;&lt;div id="iconUploadDialog" class="file-dialog" hidden&gt;&lt;div class="file-dialog-box icon-upload-box"&gt;&lt;div class="file-dialog-head"&gt;&lt;div&gt;&lt;b&gt;Replace repository icon&lt;/b&gt;&lt;small id="iconUploadPath"&gt;Choose a replacement image&lt;/small&gt;&lt;/div&gt;&lt;button id="closeIconUpload" type="button" aria-label="Close"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;div class="icon-upload-content"&gt;&lt;label for="iconUploadInput"&gt;Choose a replacement image&lt;input id="iconUploadInput" type="file" required&gt;&lt;/label&gt;&lt;small&gt;Use the same image format as the current icon. Maximum size: 2 MB.&lt;/small&gt;&lt;img id="iconUploadPreview" alt="Selected icon preview" hidden&gt;&lt;span id="iconUploadStatus" aria-live="polite"&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class="icon-upload-footer"&gt;&lt;button id="cancelIconUpload" class="outline" type="button"&gt;Cancel&lt;/button&gt;&lt;button id="saveIconUpload" class="primary small" type="button" disabled&gt;Upload and save&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script&gt;
window.CA_WORKSHOP_API_BASE='api.php?path=';
try {
  var t = new URLSearchParams(window.location.search).get('csrf_token');
  if (t) window.csrf_token = t;
  else if (window.parent &amp;&amp; window.parent.csrf_token) window.csrf_token = window.parent.csrf_token;
} catch(e) {}
&lt;/script&gt;
&lt;script src="app.js"&gt;&lt;/script&gt;
&lt;/body&gt;&lt;/html&gt;
</INLINE>
</FILE>
<FILE Name="/etc/rc.d/rc.ca-workshop">
<INLINE>#!/bin/bash
exec /usr/local/emhttp/plugins/ca-workshop/rc.ca-workshop "$@"
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/ca-workshop/api.php">
<INLINE>&lt;?php
/*
 * Loopback-only proxy for the CA Workshop Python service.
 * The service binds to 127.0.0.1 so it is never exposed directly on the LAN.
 */
$path = isset($_GET['path']) ? (string) $_GET['path'] : '';
if (($_SERVER['HTTP_X_CA_WORKSHOP'] ?? '') !== '1') {
    http_response_code(403);
    header('Content-Type: application/json');
    echo json_encode(['error' =&gt; 'CA Workshop requests must come from the plugin page.']);
    exit;
}

if (isset($_GET['get_csrf_token']) || isset($_GET['csrf']) || $path === '/api/auth/csrf' || $path === '/api/csrf-token') {
    $token = '';
    global $var;
    if (isset($var['csrf_token']) &amp;&amp; is_string($var['csrf_token']) &amp;&amp; $var['csrf_token'] !== '') {
        $token = $var['csrf_token'];
    }
    if ($token === '' &amp;&amp; file_exists('/var/local/emhttp/var.ini')) {
        $ini = @parse_ini_file('/var/local/emhttp/var.ini');
        if (isset($ini['csrf_token']) &amp;&amp; is_string($ini['csrf_token'])) {
            $token = $ini['csrf_token'];
        }
    }
    if ($token === '' &amp;&amp; file_exists('/var/local/emhttp/var.ini')) {
        $raw = @file_get_contents('/var/local/emhttp/var.ini');
        if ($raw &amp;&amp; preg_match('/csrf_token="([^"]+)"/', $raw, $m)) {
            $token = $m[1];
        }
    }
    header('Content-Type: application/json');
    header('Cache-Control: no-store');
    echo json_encode(['csrf_token' =&gt; $token]);
    exit;
}
if ($path === '' || strpos($path, '/api/') !== 0 || strpos($path, '..') !== false || preg_match('/[\r\n]/', $path)) {
    http_response_code(400);
    header('Content-Type: application/json');
    echo json_encode(['error' =&gt; 'Invalid CA Workshop API path.']);
    exit;
}

$url = 'http://127.0.0.1:8765' . $path;
$method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
$headers = ['Accept: application/json'];

// If payload was posted via form-urlencoded (to satisfy Unraid local_prepend.php csrf check),
// unpack it as application/json for the Python backend.
$post_payload = null;
if (isset($_POST['payload'])) {
    $post_payload = (string) $_POST['payload'];
    $headers[] = 'Content-Type: application/json';
} elseif (!empty($_SERVER['CONTENT_TYPE'])) {
    $headers[] = 'Content-Type: ' . $_SERVER['CONTENT_TYPE'];
}

$handle = curl_init($url);
curl_setopt_array($handle, [
    CURLOPT_CUSTOMREQUEST =&gt; $method,
    CURLOPT_RETURNTRANSFER =&gt; true,
    CURLOPT_FOLLOWLOCATION =&gt; false,
    CURLOPT_CONNECTTIMEOUT =&gt; 5,
    CURLOPT_TIMEOUT =&gt; 180,
    CURLOPT_HTTPHEADER =&gt; $headers,
]);
$body_payload = null;
if (in_array($method, ['POST', 'PUT', 'PATCH', 'DELETE'], true)) {
    $body_payload = $post_payload !== null ? $post_payload : file_get_contents('php://input');
    curl_setopt($handle, CURLOPT_POSTFIELDS, $body_payload);
}

$body = curl_exec($handle);
if ($body === false) {
    // If the loopback service is down, attempt to start it and retry once
    $rc = '/usr/local/emhttp/plugins/ca-workshop/rc.ca-workshop';
    if (file_exists($rc)) {
        @exec('/bin/bash ' . escapeshellarg($rc) . ' start &gt;/dev/null 2&gt;&amp;1');
        usleep(900000); // Wait 900ms for service to start
        $retry_handle = curl_init($url);
        curl_setopt_array($retry_handle, [
            CURLOPT_CUSTOMREQUEST =&gt; $method,
            CURLOPT_RETURNTRANSFER =&gt; true,
            CURLOPT_FOLLOWLOCATION =&gt; false,
            CURLOPT_CONNECTTIMEOUT =&gt; 5,
            CURLOPT_TIMEOUT =&gt; 180,
            CURLOPT_HTTPHEADER =&gt; $headers,
        ]);
        if ($body_payload !== null) {
            curl_setopt($retry_handle, CURLOPT_POSTFIELDS, $body_payload);
        }
        $body = curl_exec($retry_handle);
        $status = (int) (curl_getinfo($retry_handle, CURLINFO_RESPONSE_CODE) ?: 502);
        $contentType = curl_getinfo($retry_handle, CURLINFO_CONTENT_TYPE) ?: 'application/json';
        $error = curl_error($retry_handle);
        curl_close($retry_handle);
        curl_close($handle);
    } else {
        $status = (int) (curl_getinfo($handle, CURLINFO_RESPONSE_CODE) ?: 502);
        $contentType = curl_getinfo($handle, CURLINFO_CONTENT_TYPE) ?: 'application/json';
        $error = curl_error($handle);
        curl_close($handle);
    }
} else {
    $status = (int) (curl_getinfo($handle, CURLINFO_RESPONSE_CODE) ?: 502);
    $contentType = curl_getinfo($handle, CURLINFO_CONTENT_TYPE) ?: 'application/json';
    $error = curl_error($handle);
    curl_close($handle);
}

if ($body === false) {
    $status = 502;
    $contentType = 'application/json';
    $body = json_encode(['error' =&gt; 'CA Workshop is not running on this server.', 'detail' =&gt; $error]);
}

http_response_code($status);
header('Content-Type: ' . $contentType);
header('Cache-Control: no-store');
echo $body;
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/ca-workshop/rc.ca-workshop">
<INLINE>#!/bin/bash
# CA Workshop service control for the Unraid plugin.
PLUGIN_DIR="/usr/local/emhttp/plugins/ca-workshop"
CONFIG_DIR="/boot/config/plugins/ca-workshop"
PIDFILE="/var/run/ca-workshop.pid"
LOGFILE="/var/log/ca-workshop.log"

apply_menu_placement() {
  local state_file="$CONFIG_DIR/.ca-workshop-state.json"
  local page_file="$PLUGIN_DIR/CAWorkshop.page"
  if [ -f "$state_file" ] &amp;&amp; [ -f "$page_file" ]; then
    local placement
    placement=$(grep -o '"menu_placement": *"[^"]*"' "$state_file" 2&gt;/dev/null | head -n1 | cut -d'"' -f4)
    if [ "$placement" = "tasks" ]; then
      sed -i 's/^Menu="[^"]*"/Menu="Tasks:50"/' "$page_file"
    elif [ "$placement" = "hidden" ]; then
      sed -i 's/^Menu="[^"]*"/Menu="None"/' "$page_file"
    elif [ "$placement" = "utilities" ]; then
      sed -i 's/^Menu="[^"]*"/Menu="Utilities:10"/' "$page_file"
    fi
  fi
}

start_service() {
  if [ -f "$PIDFILE" ]; then
    local current_pid
    current_pid=$(cat "$PIDFILE" 2&gt;/dev/null)
    if [ -n "$current_pid" ] &amp;&amp; kill -0 "$current_pid" 2&gt;/dev/null; then
      return 0
    fi
    rm -f "$PIDFILE"
  fi
  mkdir -p "$CONFIG_DIR" || return 1
  apply_menu_placement
  if ! command -v python3 &gt;/dev/null 2&gt;&amp;1; then
    echo "python3 is required. Install Python 3 (for example with NerdTools) and restart CA Workshop." &gt;&gt; "$LOGFILE"
    return 1
  fi
  cd "$PLUGIN_DIR" || return 1
  export CA_WORKSHOP_UNRAID=1
  export CA_WORKSHOP_CONFIG_DIR="$CONFIG_DIR"
  export CA_WORKSHOP_STATE_DIR="$CONFIG_DIR"
  command -v fuser &gt;/dev/null 2&gt;&amp;1 &amp;&amp; fuser -k 8765/tcp 2&gt;/dev/null || true
  nohup python3 server.py --host 127.0.0.1 --port 8765 &gt;&gt; "$LOGFILE" 2&gt;&amp;1 &amp;
  local new_pid=$!
  echo "$new_pid" &gt; "$PIDFILE"
  sleep 1
  if kill -0 "$new_pid" 2&gt;/dev/null; then
    echo "CA Workshop started on 127.0.0.1:8765 (pid $new_pid)" &gt;&gt; "$LOGFILE"
    return 0
  fi
  rm -f "$PIDFILE"
  return 1
}

stop_service() {
  if [ -f "$PIDFILE" ]; then
    local pid
    pid=$(cat "$PIDFILE" 2&gt;/dev/null)
    if [ -n "$pid" ] &amp;&amp; kill -0 "$pid" 2&gt;/dev/null; then
      kill "$pid" 2&gt;/dev/null
      for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2&gt;/dev/null || break
        sleep 0.2
      done
      kill -9 "$pid" 2&gt;/dev/null
    fi
    rm -f "$PIDFILE"
  fi
  command -v fuser &gt;/dev/null 2&gt;&amp;1 &amp;&amp; fuser -k 8765/tcp 2&gt;/dev/null || true
}

case "$1" in
  start) start_service ;;
  stop) stop_service ;;
  restart) stop_service; sleep 1; start_service ;;
  status)
    if [ -f "$PIDFILE" ] &amp;&amp; kill -0 "$(cat "$PIDFILE")" 2&gt;/dev/null; then
      echo "running"
      exit 0
    fi
    echo "stopped"
    exit 1
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/ca-workshop/CAWorkshop.page">
<INLINE>Menu="Utilities:10"
Icon="ca-workshop.png"
Name="CA Workshop"
Type="xmenu"
Tabs="false"
---
&lt;?php
$csrf_token = '';
if (isset($var['csrf_token']) &amp;&amp; is_string($var['csrf_token']) &amp;&amp; $var['csrf_token'] !== '') {
    $csrf_token = $var['csrf_token'];
}
if ($csrf_token === '' &amp;&amp; file_exists('/var/local/emhttp/var.ini')) {
    $ini = @parse_ini_file('/var/local/emhttp/var.ini');
    if (isset($ini['csrf_token']) &amp;&amp; is_string($ini['csrf_token'])) {
        $csrf_token = $ini['csrf_token'];
    }
}
if ($csrf_token === '' &amp;&amp; file_exists('/var/local/emhttp/var.ini')) {
    $raw = @file_get_contents('/var/local/emhttp/var.ini');
    if ($raw &amp;&amp; preg_match('/csrf_token="([^"]+)"/', $raw, $m)) {
        $csrf_token = $m[1];
    }
}
?&gt;
&lt;script&gt;
window.csrf_token = &lt;?=json_encode($csrf_token)?&gt;;
&lt;/script&gt;
&lt;style&gt;
  .caw-frame-wrap { margin: -12px -12px 0; }
  .caw-frame { display: block; width: 100%; height: calc(100vh - 92px); min-height: 620px; border: 0; background: #18181b; }
  .caw-frame-note { margin: 0 0 8px; color: #8a9490; font-size: 11px; }
&lt;/style&gt;
&lt;p class="caw-frame-note"&gt;CA Workshop runs as a loopback-only service on this Unraid server. API calls are relayed through the plugin page; the service is not exposed on the network.&lt;/p&gt;
&lt;div class="caw-frame-wrap"&gt;
  &lt;iframe id="cawFrame" class="caw-frame" src="/plugins/ca-workshop/index.html?csrf_token=&lt;?=$csrf_token?&gt;" title="CA Workshop"&gt;&lt;/iframe&gt;
&lt;/div&gt;
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/ca-workshop/CAWorkshopDashboard.page">
<INLINE>Menu="Dashboard"
Icon="ca-workshop.png"
Title="CA Workshop"
Tag="cubes"
---
&lt;?php
/*
 * Unraid Dashboard Tile for CA Workshop
 * Displays repository apps, pending approvals, and approval statuses with icons.
 */
$state_file = (getenv('CA_WORKSHOP_STATE_DIR') ?: '/boot/config/plugins/ca-workshop') . '/.ca-workshop-state.json';
$widget_enabled = true;
if (file_exists($state_file)) {
    $raw = @file_get_contents($state_file);
    $saved = $raw ? json_decode($raw, true) : null;
    if (is_array($saved) &amp;&amp; array_key_exists('dashboard_widget_enabled', $saved)) {
        $widget_enabled = (bool)$saved['dashboard_widget_enabled'];
    }
}

// Fetch live widget data from local loopback service
$service_url = 'http://127.0.0.1:8765/api/dashboard/widget';
$context = stream_context_create([
    'http' =&gt; [
        'timeout' =&gt; 1.5,
        'header' =&gt; "Accept: application/json\r\n"
    ]
]);
$service_data = @file_get_contents($service_url, false, $context);
$widget = $service_data ? json_decode($service_data, true) : null;
if ($widget &amp;&amp; array_key_exists('enabled', $widget)) {
    $widget_enabled = (bool)$widget['enabled'];
}
?&gt;

&lt;style&gt;
.caw-dash-box { padding: 10px 14px 14px; }
.caw-dash-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; font-size: 11px; }
.caw-dash-stats { display: flex; gap: 8px; align-items: center; }
.caw-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 12px; font-weight: 600; font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; }
.caw-badge-pending { background: rgba(227, 98, 9, 0.15); color: #e36209; border: 1px solid rgba(227, 98, 9, 0.35); }
.caw-badge-approved { background: rgba(46, 160, 67, 0.15); color: #2ea44f; border: 1px solid rgba(46, 160, 67, 0.35); }
.caw-badge-draft { background: rgba(140, 149, 159, 0.15); color: #8c959f; border: 1px solid rgba(140, 149, 159, 0.3); }
.caw-badge-changes { background: rgba(207, 34, 46, 0.15); color: #cf222e; border: 1px solid rgba(207, 34, 46, 0.35); }

.caw-app-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 12px; text-align: center; }
.caw-app-tile { display: flex; flex-direction: column; align-items: center; padding: 10px 6px 8px; border-radius: 8px; text-decoration: none !important; color: inherit !important; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); transition: all 0.15s ease-in-out; }
.caw-app-tile:hover { background: rgba(255, 255, 255, 0.08); transform: translateY(-1px); border-color: rgba(255, 255, 255, 0.14); }

.caw-icon-box { width: 48px; height: 48px; margin-bottom: 8px; display: flex; align-items: center; justify-content: center; }
.caw-img { width: 48px; height: 48px; object-fit: contain; border-radius: 8px; }
.caw-fallback-icon { width: 48px; height: 48px; border-radius: 8px; background: #2b313a; color: #e1e4e8; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: bold; }

.caw-label { font-size: 11px; font-weight: 600; line-height: 1.25; margin-bottom: 5px; max-width: 86px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.caw-tile-status { font-size: 9px; }
.caw-msg-empty { text-align: center; padding: 22px 14px; color: #8a9490; font-size: 12px; }
.caw-msg-empty a { color: #2ea44f; font-weight: 600; }
&lt;/style&gt;

&lt;div id="caw-dashboard-widget" class="caw-dash-box"&gt;
&lt;?php if (!$widget_enabled): ?&gt;
  &lt;div class="caw-msg-empty"&gt;
    &lt;span&gt;CA Workshop dashboard widget is disabled in &lt;a href="/Utilities/CAWorkshop"&gt;Settings&lt;/a&gt;.&lt;/span&gt;
  &lt;/div&gt;
&lt;?php elseif (!$widget || empty($widget['connected'])): ?&gt;
  &lt;div class="caw-msg-empty"&gt;
    &lt;span&gt;No repository connected. Open &lt;a href="/Utilities/CAWorkshop"&gt;CA Workshop&lt;/a&gt; to connect a repository.&lt;/span&gt;
  &lt;/div&gt;
&lt;?php else: ?&gt;
  &lt;div class="caw-dash-top"&gt;
    &lt;div class="caw-dash-stats"&gt;
      &lt;span class="caw-badge caw-badge-pending"&gt;&lt;?=intval($widget['pending_count'] ?? 0)?&gt; Pending&lt;/span&gt;
      &lt;span class="caw-badge caw-badge-approved"&gt;&lt;?=intval($widget['approved_count'] ?? 0)?&gt; Approved&lt;/span&gt;
    &lt;/div&gt;
    &lt;a href="/Utilities/CAWorkshop" style="font-size:11px; color:#2ea44f; text-decoration:none;"&gt;Open Workshop ↗&lt;/a&gt;
  &lt;/div&gt;
  &lt;div class="caw-app-grid"&gt;
    &lt;?php foreach (($widget['apps'] ?? []) as $app):
      $name = htmlspecialchars($app['name'] ?? 'App');
      $status = $app['status'] ?? 'Draft';
      $badge_cls = 'caw-badge-draft';
      if (in_array($status, ['Submitted', 'In review'])) $badge_cls = 'caw-badge-pending';
      elseif ($status === 'Changes requested') $badge_cls = 'caw-badge-changes';
      elseif (in_array($status, ['Approved', 'Published'])) $badge_cls = 'caw-badge-approved';
    ?&gt;
      &lt;a href="/Utilities/CAWorkshop" class="caw-app-tile" title="&lt;?=$name?&gt; · &lt;?=$status?&gt;"&gt;
        &lt;div class="caw-icon-box"&gt;
          &lt;?php if (!empty($app['icon_data'])): ?&gt;
            &lt;img class="caw-img" src="&lt;?=$app['icon_data']?&gt;" alt=""&gt;
          &lt;?php elseif (!empty($app['icon_url'])): ?&gt;
            &lt;img class="caw-img" src="&lt;?=htmlspecialchars($app['icon_url'])?&gt;" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"&gt;
            &lt;div class="caw-fallback-icon" style="display:none;"&gt;&lt;?=htmlspecialchars(strtoupper(substr($name, 0, 2)))?&gt;&lt;/div&gt;
          &lt;?php else: ?&gt;
            &lt;div class="caw-fallback-icon"&gt;&lt;?=htmlspecialchars(strtoupper(substr($name, 0, 2)))?&gt;&lt;/div&gt;
          &lt;?php endif; ?&gt;
        &lt;/div&gt;
        &lt;div class="caw-label"&gt;&lt;?=$name?&gt;&lt;/div&gt;
        &lt;span class="caw-badge &lt;?=$badge_cls?&gt; caw-tile-status"&gt;&lt;?=htmlspecialchars($status)?&gt;&lt;/span&gt;
      &lt;/a&gt;
    &lt;?php endforeach; ?&gt;
  &lt;/div&gt;
&lt;?php endif; ?&gt;
&lt;/div&gt;

&lt;script&gt;
$(function() {
  function updateCAWorkshopTile() {
    $.ajax({
      url: '/plugins/ca-workshop/api.php?path=/api/dashboard/widget',
      headers: { 'X-CA-Workshop': '1' },
      dataType: 'json',
      timeout: 3000,
      success: function(data) {
        if (!data) return;
        var box = $('#caw-dashboard-widget');
        if (!data.enabled) {
          box.html('&lt;div class="caw-msg-empty"&gt;CA Workshop dashboard widget is disabled in &lt;a href="/Utilities/CAWorkshop"&gt;Settings&lt;/a&gt;.&lt;/div&gt;');
          return;
        }
        if (!data.connected) {
          box.html('&lt;div class="caw-msg-empty"&gt;No repository connected. Open &lt;a href="/Utilities/CAWorkshop"&gt;CA Workshop&lt;/a&gt; to connect a repository.&lt;/div&gt;');
          return;
        }
        var html = '&lt;div class="caw-dash-top"&gt;&lt;div class="caw-dash-stats"&gt;' +
          '&lt;span class="caw-badge caw-badge-pending"&gt;' + (data.pending_count || 0) + ' Pending&lt;/span&gt;' +
          '&lt;span class="caw-badge caw-badge-approved"&gt;' + (data.approved_count || 0) + ' Approved&lt;/span&gt;' +
          '&lt;/div&gt;&lt;a href="/Utilities/CAWorkshop" style="font-size:11px; color:#2ea44f; text-decoration:none;"&gt;Open Workshop ↗&lt;/a&gt;&lt;/div&gt;&lt;div class="caw-app-grid"&gt;';
        (data.apps || []).forEach(function(app) {
          var status = app.status || 'Draft';
          var badgeCls = 'caw-badge-draft';
          if (status === 'Submitted' || status === 'In review') badgeCls = 'caw-badge-pending';
          else if (status === 'Changes requested') badgeCls = 'caw-badge-changes';
          else if (status === 'Approved' || status === 'Published') badgeCls = 'caw-badge-approved';
          var name = $('&lt;div&gt;').text(app.name || 'App').html();
          var icon = '';
          if (app.icon_data) {
            icon = '&lt;img class="caw-img" src="' + app.icon_data + '" alt=""&gt;';
          } else if (app.icon_url) {
            icon = '&lt;img class="caw-img" src="' + $('&lt;div&gt;').text(app.icon_url).html() + '" alt="" onerror="this.style.display=\'none\';$(this).next().show();"&gt;&lt;div class="caw-fallback-icon" style="display:none;"&gt;' + name.slice(0, 2).toUpperCase() + '&lt;/div&gt;';
          } else {
            icon = '&lt;div class="caw-fallback-icon"&gt;' + name.slice(0, 2).toUpperCase() + '&lt;/div&gt;';
          }
          html += '&lt;a href="/Utilities/CAWorkshop" class="caw-app-tile" title="' + name + ' · ' + status + '"&gt;' +
            '&lt;div class="caw-icon-box"&gt;' + icon + '&lt;/div&gt;' +
            '&lt;div class="caw-label"&gt;' + name + '&lt;/div&gt;' +
            '&lt;span class="caw-badge ' + badgeCls + ' caw-tile-status"&gt;' + status + '&lt;/span&gt;&lt;/a&gt;';
        });
        html += '&lt;/div&gt;';
        box.html(html);
      }
    });
  }
  setInterval(updateCAWorkshopTile, 30000);
});
&lt;/script&gt;
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/ca-workshop/CAWorkshopSettings.page">
<INLINE>Menu="UserUtilities"
Title="CA Workshop"
Icon="ca-workshop.png"
---
&lt;?php
/*
 * Unraid Settings Page for CA Workshop
 * Configures Dashboard tile and WebGUI navigation placement.
 */
$csrf_token = '';
if (isset($var['csrf_token']) &amp;&amp; is_string($var['csrf_token']) &amp;&amp; $var['csrf_token'] !== '') {
    $csrf_token = $var['csrf_token'];
}
if ($csrf_token === '' &amp;&amp; file_exists('/var/local/emhttp/var.ini')) {
    $ini = @parse_ini_file('/var/local/emhttp/var.ini');
    if (isset($ini['csrf_token']) &amp;&amp; is_string($ini['csrf_token'])) {
        $csrf_token = $ini['csrf_token'];
    }
}
if ($csrf_token === '' &amp;&amp; file_exists('/var/local/emhttp/var.ini')) {
    $raw = @file_get_contents('/var/local/emhttp/var.ini');
    if ($raw &amp;&amp; preg_match('/csrf_token="([^"]+)"/', $raw, $m)) {
        $csrf_token = $m[1];
    }
}
$state_file = (getenv('CA_WORKSHOP_STATE_DIR') ?: '/boot/config/plugins/ca-workshop') . '/.ca-workshop-state.json';
$dashboard_widget = true;
$menu_placement = 'utilities';
if (file_exists($state_file)) {
    $raw = @file_get_contents($state_file);
    $saved = $raw ? json_decode($raw, true) : null;
    if (is_array($saved)) {
        if (array_key_exists('dashboard_widget_enabled', $saved)) {
            $dashboard_widget = (bool)$saved['dashboard_widget_enabled'];
        }
        if (!empty($saved['menu_placement'])) {
            $menu_placement = (string)$saved['menu_placement'];
        }
    }
}
$open_url = ($menu_placement === 'tasks') ? '/CAWorkshop' : '/Utilities/CAWorkshop';
?&gt;

&lt;div style="max-width: 720px; margin: 20px auto; padding: 22px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;"&gt;
  &lt;div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.1);"&gt;
    &lt;div&gt;
      &lt;h2 style="margin: 0 0 6px; font-size: 18px;"&gt;CA Workshop Settings&lt;/h2&gt;
      &lt;p style="margin: 0; color: #8a9490; font-size: 12px;"&gt;Configure Unraid WebGUI integration, dashboard widget display, and navigation.&lt;/p&gt;
    &lt;/div&gt;
    &lt;a href="&lt;?=$open_url?&gt;" class="button" style="text-decoration:none; padding: 8px 14px; background: #2ea44f; color: #fff; border-radius: 6px; font-weight: 600; font-size: 12px;"&gt;Open CA Workshop ↗&lt;/a&gt;
  &lt;/div&gt;

  &lt;form id="cawSettingsForm" method="POST" action="/plugins/ca-workshop/api.php?path=/api/settings/unraid-plugin"&gt;
    &lt;input type="hidden" name="csrf_token" value="&lt;?=$csrf_token?&gt;"&gt;

    &lt;div style="margin-bottom: 20px;"&gt;
      &lt;label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px;"&gt;Dashboard Widget Display&lt;/label&gt;
      &lt;select name="dashboard_widget_enabled" style="width: 100%; max-width: 420px; padding: 8px 10px; border-radius: 5px; border: 1px solid #3e4451; background: #20242b; color: #fff;"&gt;
        &lt;option value="1" &lt;?=$dashboard_widget ? 'selected' : ''?&gt;&gt;Enabled — Show pending approvals and approved apps on Dashboard&lt;/option&gt;
        &lt;option value="0" &lt;?=!$dashboard_widget ? 'selected' : ''?&gt;&gt;Disabled — Hide widget tile from Dashboard&lt;/option&gt;
      &lt;/select&gt;
      &lt;div style="font-size: 11px; color: #8a9490; margin-top: 4px;"&gt;Controls whether the CA Workshop submission status widget appears on your main Unraid Dashboard.&lt;/div&gt;
    &lt;/div&gt;

    &lt;div style="margin-bottom: 24px;"&gt;
      &lt;label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px;"&gt;WebGUI Navigation Placement&lt;/label&gt;
      &lt;select name="menu_placement" style="width: 100%; max-width: 420px; padding: 8px 10px; border-radius: 5px; border: 1px solid #3e4451; background: #20242b; color: #fff;"&gt;
        &lt;option value="tasks" &lt;?=$menu_placement === 'tasks' ? 'selected' : ''?&gt;&gt;Dedicated Menu Tab — Add 'CA Workshop' to top navigation bar&lt;/option&gt;
        &lt;option value="utilities" &lt;?=$menu_placement === 'utilities' ? 'selected' : ''?&gt;&gt;Utilities Menu — Access via Tools → CA Workshop&lt;/option&gt;
        &lt;option value="hidden" &lt;?=$menu_placement === 'hidden' ? 'selected' : ''?&gt;&gt;Plugins &amp;amp; Settings Only — Access from Settings/Plugins icons&lt;/option&gt;
      &lt;/select&gt;
      &lt;div style="font-size: 11px; color: #8a9490; margin-top: 4px;"&gt;Choose how you want to open CA Workshop in your Unraid WebGUI.&lt;/div&gt;
    &lt;/div&gt;

    &lt;div style="display: flex; align-items: center; gap: 14px; margin-top: 20px;"&gt;
      &lt;button type="submit" id="cawSaveBtn" class="button" style="padding: 9px 18px; background: #e36209; color: #fff; border: 0; border-radius: 6px; font-weight: 600; cursor: pointer;"&gt;Save Settings&lt;/button&gt;
      &lt;span id="cawSaveStatus" style="font-size: 12px; color: #2ea44f;"&gt;&lt;/span&gt;
    &lt;/div&gt;
  &lt;/form&gt;
&lt;/div&gt;

&lt;script&gt;
$('#cawSettingsForm').on('submit', function(e) {
  e.preventDefault();
  var btn = $('#cawSaveBtn');
  var status = $('#cawSaveStatus');
  btn.prop('disabled', true).text('Saving…');
  status.text('').css('color', '#2ea44f');
  
  var enabled = $('select[name="dashboard_widget_enabled"]').val() === '1';
  var placement = $('select[name="menu_placement"]').val();
  var token = $('input[name="csrf_token"]').val() || (window.csrf_token || '');

  function sendSave(tok) {
    $.ajax({
      url: '/plugins/ca-workshop/api.php?path=/api/settings/unraid-plugin&amp;csrf_token=' + encodeURIComponent(tok),
      type: 'POST',
      headers: { 'X-CA-Workshop': '1', 'X-CSRF-Token': tok },
      data: {
        csrf_token: tok,
        payload: JSON.stringify({ dashboard_widget_enabled: enabled, menu_placement: placement })
      },
      dataType: 'json',
      success: function(data) {
        status.text('Settings saved. Refreshing Unraid WebGUI…');
        setTimeout(function() {
          location.reload();
        }, 900);
      },
      error: function(xhr) {
        btn.prop('disabled', false).text('Save Settings');
        var err = xhr.responseJSON ? xhr.responseJSON.error : xhr.responseText;
        status.css('color', '#cf222e').text('Error saving settings: ' + (err || 'Server error'));
      }
    });
  }

  if (!token) {
    $.getJSON('/plugins/ca-workshop/api.php?get_csrf_token=1', function(data) {
      sendSave(data.csrf_token || '');
    }).fail(function() {
      sendSave('');
    });
  } else {
    sendSave(token);
  }
});
&lt;/script&gt;
</INLINE>
</FILE>
<FILE Run="/bin/bash" Method="remove">
<INLINE>#!/bin/bash
/etc/rc.d/rc.ca-workshop stop 2&gt;/dev/null
rm -f /etc/rc.d/rc.ca-workshop
rm -rf /usr/local/emhttp/plugins/ca-workshop
rm -f /boot/config/plugins/ca-workshop/ca-workshop.png
</INLINE>
</FILE>
<RUN>/bin/bash -c 'mkdir -p /boot/config/plugins/ca-workshop &amp;&amp; cp -f /usr/local/emhttp/plugins/ca-workshop/ca-workshop.png /boot/config/plugins/ca-workshop/ca-workshop.png 2&gt;/dev/null; chmod +x /etc/rc.d/rc.ca-workshop /usr/local/emhttp/plugins/ca-workshop/rc.ca-workshop &amp;&amp; /etc/rc.d/rc.ca-workshop restart'</RUN>
</PLUGIN>
