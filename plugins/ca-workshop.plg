let toastTimer,packagePollTimer;function toast(message){const t=document.querySelector('#toast');t.textContent=message;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=&gt;t.classList.remove('show'),3000)}
const apiBase=window.CA_WORKSHOP_API_BASE||'';
let csrfPromise=null;
async function getCsrfToken(){if(window.csrf_token)return window.csrf_token;try{const st=new URLSearchParams(window.location.search).get('csrf_token');if(st){window.csrf_token=st;return st;}}catch(e){}try{if(window.parent&amp;&amp;window.parent.csrf_token){window.csrf_token=window.parent.csrf_token;return window.csrf_token;}}catch(e){}if(!apiBase)return '';if(!csrfPromise){csrfPromise=(async()=&gt;{try{const r=await fetch('api.php?get_csrf_token=1',{headers:{'X-CA-Workshop':'1'}});if(r.ok){const d=await r.json();if(d.csrf_token){window.csrf_token=d.csrf_token;return d.csrf_token;}}}catch(e){}return '';})();}return await csrfPromise;}
getCsrfToken();
function apiUrl(path){if(!apiBase)return path;let url=apiBase+encodeURIComponent(path);if(window.csrf_token)url+='&amp;csrf_token='+encodeURIComponent(window.csrf_token);return url}
async function api(path,options={}){const isWrite=options.method&amp;&amp;options.method.toUpperCase()!=='GET';let token=window.csrf_token;if(apiBase&amp;&amp;(isWrite||!token)){token=await getCsrfToken();}const url=apiUrl(path);let fetchOptions;if(isWrite&amp;&amp;apiBase){const payload=typeof options.body==='string'?options.body:JSON.stringify(options.body||{});fetchOptions={...options,headers:{'X-CA-Workshop':'1',...(token?{'X-CSRF-Token':token}:{}),...(options.headers||{})},body:new URLSearchParams({csrf_token:token||'',payload})};delete fetchOptions.headers['Content-Type'];}else{fetchOptions={...options,headers:{'Content-Type':'application/json','X-CA-Workshop':'1',...(token?{'X-CSRF-Token':token}:{}),...(options.headers||{})}};}let response=await fetch(url,fetchOptions);if(!response.ok&amp;&amp;apiBase&amp;&amp;isWrite){let errText='';try{const c=response.clone();const j=await c.json();errText=j.error||'';}catch(e){try{errText=await response.clone().text();}catch(e2){}}if(errText.toLowerCase().includes('csrf')||response.status===403||response.status===400){window.csrf_token='';csrfPromise=null;const freshToken=await getCsrfToken();if(freshToken&amp;&amp;freshToken!==token){const payload=typeof options.body==='string'?options.body:JSON.stringify(options.body||{});fetchOptions.body=new URLSearchParams({csrf_token:freshToken,payload});if(fetchOptions.headers)fetchOptions.headers['X-CSRF-Token']=freshToken;response=await fetch(url,fetchOptions);}}}let data={};try{data=await response.json()}catch{}if(!response.ok)throw Error(data.error||`Request failed (${response.status})`);return data}
let caProfileDocument=null,caProfileRepoPath='',caProfileOriginalLeafIndexes=new Set();
const caProfileFields=['Icon','Profile','DonateLink','DonateText','WebPage','Forum'];
