60;font-size:18px;margin-bottom:10px}.docker h2{font-size:13px;margin:0 0 7px}.docker&gt;p{max-width:300px;font-size:10px;color:#7c8981;line-height:1.6;margin:0 auto 17px}.docker-status{background:var(--danger-bg);border:1px solid #f2e1df;border-radius:5px;padding:9px 10px;display:flex;align-items:center;gap:7px;font-size:9px;color:#9c5951}.red-dot{width:6px;height:6px;background:#d36c5d;border-radius:50%}.docker-status button{border:0;background:none;color:#a54c42;font:600 9px 'nudista-web';cursor:pointer}.outline{background:var(--surface);border:1px solid var(--line);border-radius:5px;padding:8px 12px;margin-top:13px;font:500 10px 'nudista-web';color:#53625a;cursor:pointer}.sandbox-note{display:flex;gap:12px;margin-top:16px;padding:12px 15px;border:1px solid var(--line);border-radius:6px;background:var(--surface);font-size:9px;color:#7c8981}.sandbox-note b{color:#57655d}.docs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.doc-card{position:relative;min-height:122px;background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:15px;text-decoration:none;color:var(--ink);display:flex;flex-direction:column}.doc-card:hover{border-color:#99bba7;transform:translateY(-1px)}.doc-card&gt;span{font:10px monospace;color:#3d8b67;margin-bottom:16px}.doc-card b{font-size:11px}.doc-card small{font-size:9px;color:#849188;margin-top:5px}.doc-card i{position:absolute;right:13px;top:13px;font-style:normal;color:#7b8980}.link-button{text-decoration:none}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;transition:.25s;background:#22382e;color:#fff;padding:10px 15px;border-radius:6px;font-size:11px;box-shadow:0 6px 24px #10281c33;pointer-events:none;z-index:5}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:950px){.rail{width:190px}main{margin-left:190px}.page{padding:32px 25px}.content-grid,.submission-grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid var(--line)}}@media(max-width:650px){.rail{position:static;width:auto;height:auto;padding:10px 12px;display:block;border-right:0;border-bottom:1px solid var(--line)}.brand{padding:0 5px 10px}.rail-label,.rail-bottom{display:none}.nav{display:inline-flex;width:auto;height:34px;padding:0 9px;font-size:11px;margin:0 2px 0 0}.nav span{font-size:14px}.nav .count{display:none}main{margin:0}header{height:45px;padding:0 17px}.page{padding:26px 16px}.page-heading{align-items:flex-start;gap:10px}.page h1{font-size:22px}.page-heading p{max-width:280px;line-height:1.5}.page-heading&gt;.primary{font-size:10px;padding:9px}.stats{grid-template-columns:1fr 1fr}.stat{padding:12px}.content-grid,.sandbox-grid,.docs-grid{grid-template-columns:1fr}.next{align-items:flex-start;flex-wrap:wrap}.next .primary{margin-left:49px}.workflow{padding:14px 10px;overflow:auto}.step{min-width:88px;gap:5px}.connector{min-width:12px;margin:0 4px}.step b{font-size:9px}.step small{font-size:8px}.package-card{align-items:flex-start;flex-wrap:wrap}.package-card&gt;.pill{margin-left:59px}.repo-bar{gap:8px}.subtle{margin-left:3px}.branch{font-size:9px}.page-heading .local-tag{font-size:8px}.sandbox-note{line-height:1.6}}
.docker-form{width:100%;text-align:left;margin-top:13px;display:grid;gap:9px}.docker-form[hidden]{display:none}.docker-form label{font-size:9px;font-weight:600;color:#607067}.docker-form input{width:100%;display:block;margin-top:4px;border:1px solid var(--line);border-radius:4px;padding:8px;font:10px monospace;color:var(--ink);background:var(--surface)}.form-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px}.docker-form button{justify-self:start}.template-results{border-top:1px solid var(--line);padding-top:12px;margin-top:4px}.template-results h3,.containers h3{font-size:11px;margin:2px 0 9px}.template-result,.container-row{display:flex;gap:9px;align-items:center;padding:8px 2px;border-top:1px solid #edf0ee}.template-result&gt;span:nth-child(2),.container-row&gt;span{flex:1}.template-result b,.template-result small,.container-row b,.container-row small{display:block;font-size:10px}.template-result small,.container-row small{font-size:9px;color:#89958e;margin-top:3px}.template-result .error-text{color:#b34c42}.container-row button{border:1px solid #ecd9d6;background:var(--danger-bg);color:#a54c42;border-radius:4px;padding:6px 8px;font:9px 'nudista-web';cursor:pointer}.tree-item{font-family:monospace;font-size:9px;overflow-wrap:anywhere}
