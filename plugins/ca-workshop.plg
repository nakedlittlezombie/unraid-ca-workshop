async function iconPixels(path){const response=await fetch(apiUrl(`/api/repo/icon-image?path=${encodeURIComponent(path)}`),{headers:{'X-CA-Workshop':'1'}});if(!response.ok)throw Error(`Could not read ${path}.`);const bitmap=await createImageBitmap(await response.blob()),canvas=document.createElement('canvas');canvas.width=bitmap.width;canvas.height=bitmap.height;const context=canvas.getContext('2d',{willReadFrequently:true});context.drawImage(bitmap,0,0);const pixels=context.getImageData(0,0,bitmap.width,bitmap.height).data;bitmap.close?.();return{width:canvas.width,height:canvas.height,pixels}}
document.querySelector('#scanPlaceholderIcons').addEventListener('click',async()=&gt;{const status=document.querySelector('#placeholderScanResults'),button=document.querySelector('#scanPlaceholderIcons');if(!iconToolsData?.has_placeholder)return;button.disabled=true;placeholderMatches=[];status.textContent='Comparing repository PNG icons with the placeholder…';try{const reference=await iconPixels('images/placeholder-icon.png'),icons=iconToolsData.images.filter(path=&gt;path!=='images/placeholder-icon.png');for(let index=0;index&lt;icons.length;index++){const candidate=await iconPixels(icons[index]);if(candidate.width===reference.width&amp;&amp;candidate.height===reference.height&amp;&amp;candidate.pixels.every((value,pixel)=&gt;value===reference.pixels[pixel]))placeholderMatches.push(icons[index]);if(index%8===7)status.textContent=`Checked ${index+1} of ${icons.length} PNG files…`}status.innerHTML=placeholderMatches.length?placeholderMatches.map(path=&gt;`&lt;div class="icon-tool-row"&gt;&lt;span&gt;${escapeHtml(path)}&lt;/span&gt;&lt;small&gt;Placeholder match&lt;/small&gt;&lt;/div&gt;`).join(''):`Checked ${icons.length} image(s); no exact placeholder matches found.`;document.querySelector('#replacePlaceholderIcons').disabled=!placeholderMatches.length||!document.querySelector('#placeholderReplacement').value}catch(error){status.textContent=error.message}finally{button.disabled=false}});
document.querySelector('#placeholderReplacement').addEventListener('change',()=&gt;{document.querySelector('#replacePlaceholderIcons').disabled=!placeholderMatches.length||!document.querySelector('#placeholderReplacement').value});
document.querySelector('#replacePlaceholderIcons').addEventListener('click',async()=&gt;{const source=document.querySelector('#placeholderReplacement').value,button=document.querySelector('#replacePlaceholderIcons');if(!source||!placeholderMatches.length)return;button.disabled=true;try{const result=await api('/api/repo/icons/replace-placeholders',{method:'POST',body:JSON.stringify({source,targets:placeholderMatches})});toast(`Replaced ${result.replaced.length} placeholder icon(s).`);placeholderMatches=[];await loadIconTools();document.querySelector('#placeholderScanResults').textContent=`Replaced ${result.replaced.length} image(s) with ${source}.`}catch(error){document.querySelector('#placeholderScanResults').textContent=error.message}finally{button.disabled=false}});
function savedFilesKey(path){return `ca-workshop-saved-files:${path||'no-repository'}`}
function loadSavedRepoFiles(path){try{const saved=JSON.parse(localStorage.getItem(savedFilesKey(path))||'[]');return new Set(Array.isArray(saved)?saved.filter(item=&gt;typeof item==='string'):[])}catch{return new Set()}}
function persistSavedRepoFiles(){try{localStorage.setItem(savedFilesKey(savedRepoFilesRepo),JSON.stringify([...savedRepoFiles]))}catch{}}
function markRepoFileSaved(path){savedRepoFiles.add(path);persistSavedRepoFiles()}
function markRepoFileDeleted(path){savedRepoFiles.delete(path);persistSavedRepoFiles()}
function drawRepo(data){repo=data;const path=data.connected?data.path:'';if(path!==savedRepoFilesRepo){savedRepoFilesRepo=path;savedRepoFiles=loadSavedRepoFiles(path)}const list=document.querySelector('#readinessChecks');if(!data.connected){document.querySelector('#repoName').textContent='No repository connected';document.querySelector('#repoUrl').textContent='Choose a local folder to begin';document.querySelector('#readinessStat').textContent='—';document.querySelector('#readinessLabel').textContent='Connect a repository';document.querySelector('#appCount').textContent='—';document.querySelector('#pluginCount').textContent='—';list.innerHTML='&lt;div class="check-row"&gt;&lt;span class="check warn"&gt;!&lt;/span&gt;&lt;div&gt;&lt;b&gt;Connect a repository&lt;/b&gt;&lt;small&gt;Readiness checks will use files in your selected folder&lt;/small&gt;&lt;/div&gt;&lt;span class="pill pending"&gt;PENDING&lt;/span&gt;&lt;/div&gt;';document.querySelector('#repoFileList').innerHTML='&lt;div class="history-empty"&gt;Connect a repository to browse its files.&lt;/div&gt;';renderInstallerTemplates([]);return}
 document.querySelector('#repoName').textContent=data.name;document.querySelector('#repoUrl').textContent=data.path;const syncInfo=data.sync||{};document.querySelector('#repoSyncInfo').textContent=syncInfo.synced!==false&amp;&amp;(syncInfo.remote||'')?(syncInfo.remote+(syncInfo.branch?(' / '+syncInfo.branch):'')+' ('+(syncInfo.ahead||0)+' ahead, '+(syncInfo.behind||0)+' behind)').replace(' (0 ahead, 0 behind)','').trim()||'Not synced':'Not synced';const checks=data.checks||[],required=checks.filter(x=&gt;!x.manual),preTemplateReady=['profile-file','profile-content','license','public-repository'].every(id=&gt;checks.some(x=&gt;x.id===id&amp;&amp;x.ok&amp;&amp;!x.manual)),allGreen=checks.length===5&amp;&amp;checks.every(x=&gt;x.ok&amp;&amp;!x.manual);document.querySelector('#populatePanel').hidden=!preTemplateReady||(data.templates||[]).length&gt;0;document.querySelector('#readyNextPanel').hidden=!(allGreen&amp;&amp;(data.repository_ready??required.every(check=&gt;check.ok)));document.querySelector('#readinessStat').innerHTML=`${required.filter(x=&gt;x.ok).length} &lt;small&gt;/ ${required.length}&lt;/small&gt;`;const repositoryReady=data.repository_ready??required.every(check=&gt;check.ok);document.querySelector('#readinessLabel').textContent=repositoryReady?'Repository checks passed':'Review repository items below';document.querySelector('#readinessLabel').className=repositoryReady?'':'amber';document.querySelector('#appCount').textContent=data.templates.filter(t=&gt;t.kind==='docker').length;document.querySelector('#pluginCount').textContent=data.templates.filter(t=&gt;t.kind==='plugin').length;list.innerHTML=checks.map(c=&gt;`&lt;div class="check-row"&gt;&lt;span class="check ${c.ok?'pass':'warn'}"&gt;${c.ok?'✓':c.manual?'?':'!'}&lt;/span&gt;&lt;div&gt;&lt;b&gt;${escapeHtml(c.label)}&lt;/b&gt;&lt;small&gt;${escapeHtml(c.detail)}&lt;/small&gt;&lt;/div&gt;&lt;span class="pill ${c.manual?'pending':c.ok?'good':'pending'}"&gt;${c.manual?'REVIEW':c.ok?'PASS':'FIX'}&lt;/span&gt;&lt;/div&gt;`).join('');renderInstallerTemplates(data.templates);loadRepoFiles()}
let installerTemplates=[];
function renderInstallerTemplates(templates){installerTemplates=[];/* Repository templates are edited in Applications; the CA Store installer only accepts official catalog templates. */}
function renderTemplateInputs(){const selectValue=document.querySelector('#templateSelect').value,selected=selectValue.startsWith('external:')?selectedExternalTemplate:installerTemplates.find(t=&gt;t.file===selectValue),summary=document.querySelector('#templateSummary'),inputs=document.querySelector('#templateInputs');if(!selected){summary.textContent='';inputs.innerHTML='';document.querySelector('#templateForm button[type=submit]').disabled=true;return}summary.innerHTML=`&lt;b&gt;${escapeHtml(selected.name)}&lt;/b&gt;&lt;small&gt;${escapeHtml(selected.repository)}&lt;/small&gt;&lt;p&gt;${escapeHtml(selected.overview||'No overview provided.')}&lt;/p&gt;`;const unsupported=selected.configs.filter(c=&gt;!['port','path','variable'].includes(c.type.toLowerCase()));inputs.innerHTML=selected.configs.map((c,i)=&gt;{const type=c.type.toLowerCase();if(type==='path')return `&lt;div class="volume-setting"&gt;&lt;b&gt;${escapeHtml(c.name)}&lt;/b&gt;&lt;small&gt;Container folder: ${escapeHtml(c.target)}&lt;/small&gt;&lt;label&gt;Storage type&lt;select data-volume-mode="${i}"&gt;&lt;option value="volume" selected&gt;Isolated Docker volume (recommended)&lt;/option&gt;&lt;option value="bind"&gt;Bind mount a host folder&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;label class="bind-path" hidden&gt;Host folder path&lt;input type="text" data-bind-source="${i}" placeholder="/path/to/folder on this computer" autocomplete="off"&gt;&lt;/label&gt;&lt;small class="volume-help"&gt;Isolated storage is separate from host files. Bind mounts expose the selected host folder to this container.&lt;/small&gt;&lt;/div&gt;`;if(type==='port')return `&lt;label&gt;${escapeHtml(c.name)} · container port ${escapeHtml(c.target)}&lt;input type="number" min="1" max="65535" data-config="${i}" value="${escapeHtml(c.default)}" ${c.required?'required':''} placeholder="Host port"&gt;&lt;/label&gt;`;if(type==='variable'){const commonValues=getCommonInstallVariables(),value=Object.prototype.hasOwnProperty.call(commonValues,c.name)?commonValues[c.name]:c.default;return `&lt;label&gt;${escapeHtml(c.name)}${c.required?' · required':''}&lt;input type="${c.mask?'password':'text'}" data-config="${i}" value="${escapeHtml(value)}" ${c.required?'required':''} autocomplete="off" placeholder="${c.mask?'Enter secret value':'Optional'}"&gt;&lt;/label&gt;`}return ''}).join('')+(unsupported.length?`&lt;div class="unsupported-setting"&gt;Unsupported setting(s): ${unsupported.map(c=&gt;escapeHtml(c.name)+' ('+escapeHtml(c.type)+')').join(', ')}. The template cannot be installed with this version.&lt;/div&gt;`:'');inputs.querySelectorAll('[data-volume-mode]').forEach(mode=&gt;mode.addEventListener('change',()=&gt;{const path=inputs.querySelector(`[data-bind-source="${mode.dataset.volumeMode}"]`),label=path.closest('.bind-path');label.hidden=mode.value!=='bind';path.required=mode.value==='bind'}));document.querySelector('#templateForm button[type=submit]').disabled=unsupported.length&gt;0;document.querySelector('#templateName').value=`ca-${selected.name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,30)||'app'}-test`}
function renderCatalog(data){if(!data.connected){document.querySelector('#shimRepoName').textContent='No repository connected';document.querySelector('#shimProfile').textContent='Connect a local repository to preview its CA entries.';document.querySelector('#shimApps').innerHTML='&lt;div class="shim-empty"&gt;Connect a repository folder to build a local catalog.&lt;/div&gt;';document.querySelector('#shimPlugins').innerHTML='';return}const profile=data.repository.profile||{};document.querySelector('#shimRepoName').textContent=data.repository.name;document.querySelector('#shimProfile').textContent=profile.Profile||'No repository profile description.';const apps=document.querySelector('#shimApps'),plugins=document.querySelector('#shimPlugins');apps.innerHTML=data.apps.length?data.apps.map(t=&gt;`&lt;article class="ca-card"&gt;&lt;div class="ca-card-top"&gt;&lt;span class="ca-type"&gt;DOCKER APP&lt;/span&gt;&lt;span class="pill ${t.ok?'good':'pending'}"&gt;${t.ok?'READY':'NEEDS WORK'}&lt;/span&gt;&lt;/div&gt;&lt;h3&gt;${escapeHtml(t.name||'Unnamed template')}&lt;/h3&gt;&lt;p&gt;${escapeHtml(t.overview||'No overview in template XML.')}&lt;/p&gt;&lt;small class="ca-image"&gt;${escapeHtml(t.repository||'Image reference missing')}&lt;/small&gt;&lt;small class="ca-file"&gt;${escapeHtml(t.file)}&lt;/small&gt;${t.errors.map(e=&gt;`&lt;small class="error-text"&gt;${escapeHtml(e)}&lt;/small&gt;`).join('')}&lt;button class="primary small" data-install-template="${escapeHtml(t.file)}" ${t.ok?'':'disabled'}&gt;${t.ok?'Edit template':'Edit'}&lt;/button&gt;&lt;/article&gt;`).join(''):'&lt;div class="shim-empty"&gt;No Docker templates were found in this repository.&lt;/div&gt;';plugins.innerHTML=data.plugins.length?data.plugins.map(t=&gt;`&lt;article class="ca-card plugin-card"&gt;&lt;div class="ca-card-top"&gt;&lt;span class="ca-type"&gt;UNRAID PLUGIN&lt;/span&gt;&lt;span class="pill pending"&gt;HOST REQUIRED&lt;/span&gt;&lt;/div&gt;&lt;h3&gt;${escapeHtml(t.name||'Unnamed plugin')}&lt;/h3&gt;&lt;p&gt;${escapeHtml(t.overview||'No overview in wrapper XML.')}&lt;/p&gt;&lt;small class="ca-image"&gt;Manifest: ${escapeHtml(t.plugin_url||'PluginURL missing')}&lt;/small&gt;&lt;small class="ca-file"&gt;${escapeHtml(t.file)}&lt;/small&gt;${t.errors.map(e=&gt;`&lt;small class="error-text"&gt;${escapeHtml(e)}&lt;/small&gt;`).join('')}&lt;button class="outline" data-plugin-info="${escapeHtml(t.file)}"&gt;Why no local install?&lt;/button&gt;&lt;/article&gt;`).join(''):'&lt;div class="shim-empty"&gt;No plugin wrappers were found in this repository.&lt;/div&gt;';apps.querySelectorAll('[data-install-template]').forEach(b=&gt;b.addEventListener('click',()=&gt;selectTemplateInSandbox(b.dataset.installTemplate)));plugins.querySelectorAll('[data-plugin-info]').forEach(b=&gt;b.addEventListener('click',()=&gt;toast('Plugin install hooks target Unraid paths and services. The shim only emulates the catalog and Docker template installer.')))}
async function loadCatalog(search=''){try{renderCatalog(await api(`/api/ca/catalog${search?`?q=${encodeURIComponent(search)}`:''}`))}catch(e){toast(e.message)}}
async function selectTemplateInSandbox(file){await navigate('template-editor');document.querySelector('#templateEditorSelect').value=file;await loadTemplateEditorFile(file)}
let searchTimer;document.querySelector('#catalogSearch').addEventListener('input',e=&gt;{clearTimeout(searchTimer);searchTimer=setTimeout(()=&gt;loadCatalog(e.target.value),180)});
function escapeHtml(s){return String(s).replace(/[&amp;&lt;&gt;"']/g,c=&gt;({'&amp;':'&amp;amp;','&lt;':'&amp;lt;','&gt;':'&amp;gt;','"':'&amp;quot;',"'":'&amp;#39;'}[c]))}
async function loadCABrowser(){try{await loadCACategories();if(!caObserver){caObserver=new IntersectionObserver(entries=&gt;{if(entries.some(entry=&gt;entry.isIntersecting)&amp;&amp;caPage*12&lt;caTotal)fetchCABrowser().catch(error=&gt;toast(error.message))},{rootMargin:'650px 0px'});caObserver.observe(document.querySelector('#caScrollSentinel'))}await fetchCABrowser(true)}catch(e){document.querySelector('#caResults').innerHTML=`&lt;div class="shim-empty"&gt;${escapeHtml(e.message)}. The CA portal may be temporarily unavailable.&lt;/div&gt;`;document.querySelector('#caResultSummary').textContent='Catalog unavailable';document.querySelector('#caScrollStatus').textContent=''}}
async function loadCACategories(){const select=document.querySelector('#caCategory');if(select.dataset.loaded)return;const data=await api('/api/ca/categories');select.innerHTML='&lt;option value="all"&gt;All categories&lt;/option&gt;'+(data.categories||[]).map(c=&gt;`&lt;option value="${escapeHtml(c.path)}"&gt;${escapeHtml(c.name)} (${Number(c.count)||0})&lt;/option&gt;`).join('');select.dataset.loaded='true'}
async function fetchCABrowser(reset=false){if(reset){caBrowserRequest++;caPage=0;caTotal=0;caLoading=false;document.querySelector('#caResults').replaceChildren();document.querySelector('#caScrollStatus').textContent='Loading…';document.querySelector('#caScrollSentinel').hidden=false}if(caLoading||caPage*12&gt;=caTotal&amp;&amp;caPage&gt;0)return;caLoading=true;const requestId=caBrowserRequest,page=caPage,params=new URLSearchParams({q:document.querySelector('#caSearch').value.trim(),category:document.querySelector('#caCategory').value,type:document.querySelector('#caType').value,sort:document.querySelector('#caSort').value,page:String(page),limit:'12'});try{const data=await api(`/api/ca/browse?${params}`);if(requestId!==caBrowserRequest)return;caTotal=Number(data.total)||0;const hits=data.hits||[],results=document.querySelector('#caResults'),sentinel=document.querySelector('#caScrollSentinel');if(hits.length){results.insertAdjacentHTML('beforeend',hits.map(caCard).join(''));caPage=page+1}else if(page===0)results.innerHTML='&lt;div class="shim-empty"&gt;No matching Community Apps entries. Try another search or category.&lt;/div&gt;';const loaded=results.querySelectorAll('.ca-market-card').length;document.querySelector('#caResultSummary').textContent=`${loaded.toLocaleString()} of ${caTotal.toLocaleString()} catalog entries`;const hasMore=loaded&lt;caTotal&amp;&amp;hits.length&gt;0;sentinel.hidden=!hasMore;sentinel.textContent=hasMore?'Scroll to load more entries':'You’re all caught up';document.querySelector('#caScrollStatus').textContent=hasMore?'More apps load as you scroll':'End of results'}catch(error){if(requestId===caBrowserRequest)throw error}finally{if(requestId===caBrowserRequest){caLoading=false;const sentinel=document.querySelector('#caScrollSentinel');if(!sentinel.hidden&amp;&amp;sentinel.getBoundingClientRect().top&lt;window.innerHeight+650&amp;&amp;caPage*12&lt;caTotal)requestAnimationFrame(()=&gt;fetchCABrowser().catch(error=&gt;toast(error.message)))}}}

function caCard(item){const plugin=item.appType==='plugin',url=item.InstallTemplateURL||item.TemplateURL||'',cats=(item.CategoryList||[]).slice(0,2).join(' · '),portal=`https://ca.unraid.net/apps?q=${encodeURIComponent(item.Name)}`,image=item.Icon||'';return `&lt;article class="ca-market-card"&gt;&lt;div class="ca-market-top"&gt;${image?`&lt;img src="${escapeHtml(image)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.hidden=true"&gt;`:'&lt;span class="ca-market-placeholder"&gt;CA&lt;/span&gt;'}&lt;div&gt;&lt;span class="ca-type"&gt;${plugin?'PLUGIN':'DOCKER APP'}&lt;/span&gt;${item.isOfficial?'&lt;span class="ca-official"&gt;OFFICIAL&lt;/span&gt;':''}&lt;/div&gt;&lt;/div&gt;&lt;h2&gt;${escapeHtml(item.Name)}&lt;/h2&gt;&lt;p&gt;${escapeHtml(item.overviewPreview||item.Overview||'No overview provided.')}&lt;/p&gt;&lt;div class="ca-market-meta"&gt;${escapeHtml(cats||'Community Apps')} ${item.beta?'&lt;span&gt;Beta&lt;/span&gt;':''} ${item.deprecated?'&lt;span&gt;Deprecated&lt;/span&gt;':''}&lt;/div&gt;&lt;div class="ca-market-actions"&gt;${plugin?`${runtime.unraid&amp;&amp;item.PluginURL?`&lt;button class="primary small" data-ca-plugin-install="${escapeHtml(item.PluginURL)}"&gt;Install plugin&lt;/button&gt;`:''}&lt;a class="outline" href="${portal}" target="_blank" rel="noreferrer"&gt;View on CA ↗&lt;/a&gt;`:url?`&lt;button class="primary small" data-ca-install="${escapeHtml(url)}"&gt;Review &amp;amp; install&lt;/button&gt;&lt;a class="market-link" href="${portal}" target="_blank" rel="noreferrer"&gt;CA listing ↗&lt;/a&gt;`:`&lt;a class="outline" href="${portal}" target="_blank" rel="noreferrer"&gt;View on CA ↗&lt;/a&gt;`}&lt;/div&gt;&lt;/article&gt;`}
async function selectCATemplate(url){try{const template=await api(`/api/ca/template?url=${encodeURIComponent(url)}`);if(!template.ok){toast((template.errors||['Template is incomplete.']).join(' '));return}selectedExternalTemplate=template;const select=document.querySelector('#templateSelect');select.innerHTML=`&lt;option value="external:${escapeHtml(url)}"&gt;CA Store · ${escapeHtml(template.name)}&lt;/option&gt;`;select.value=`external:${url}`;renderTemplateInputs();document.querySelector('#storeInstaller').hidden=false;document.querySelector('#storeInstallerBackdrop').hidden=false;document.body.classList.add('drawer-open');document.querySelector('#closeStoreInstaller').focus();toast('Review the CA template settings before installing.')}catch(e){toast(e.message)}}
function closeStoreInstaller(){document.querySelector('#storeInstaller').hidden=true;document.querySelector('#storeInstallerBackdrop').hidden=true;document.body.classList.remove('drawer-open')}
document.querySelector('#closeStoreInstaller').addEventListener('click',closeStoreInstaller);document.querySelector('#storeInstallerBackdrop').addEventListener('click',closeStoreInstaller);document.addEventListener('keydown',event=&gt;{if(event.key==='Escape'&amp;&amp;!document.querySelector('#storeInstaller').hidden)closeStoreInstaller()});
function resetCABrowser(){fetchCABrowser(true).catch(error=&gt;toast(error.message))}
document.querySelector('#caResults').addEventListener('click',async event=&gt;{const pluginButton=event.target.closest('[data-ca-plugin-install]');if(pluginButton){const url=pluginButton.dataset.caPluginInstall;if(!runtime.unraid){toast('Plugin installation requires CA Workshop to run on the Unraid host.');return}if(!confirm(`Install this plugin on the Unraid server with its plugin manager?\n\n${url}`))return;pluginButton.disabled=true;pluginButton.textContent='Installing…';try{await api('/api/unraid/plugins/install',{method:'POST',body:JSON.stringify({url,confirmed:true})});toast('Plugin installed. Refresh the Unraid page to load its settings.');await loadRuntime()}catch(error){toast(error.message)}finally{pluginButton.disabled=false;pluginButton.textContent='Install plugin'}return}const button=event.target.closest('[data-ca-install]');if(button)selectCATemplate(button.dataset.caInstall)});
document.querySelector('#shimApps').addEventListener('click',async event=&gt;{const button=event.target.closest('[data-install-template]');if(!button)return;const file=button.dataset.installTemplate;if(!file)return;if(!confirm('Install locally (Docker sandbox) or on Unraid server? Click OK for server, Cancel for local.')){await selectTemplateInSandbox(file);return}try{const unraidStatus=await api('/api/unraid/status');if(unraidStatus.connected){await api('/api/unraid/docker/run',{method:'POST',body:JSON.stringify({template:file})});toast('App installation started on Unraid server.')}else{toast('Unraid server not connected; installing locally.');await selectTemplateInSandbox(file)}}catch(e){toast('Server install failed: '+e.message);await selectTemplateInSandbox(file)}});
document.querySelector('#caSearchForm').addEventListener('submit',event=&gt;{event.preventDefault();resetCABrowser()});document.querySelector('#caSearch').addEventListener('input',()=&gt;{clearTimeout(caTimer);caTimer=setTimeout(resetCABrowser,300)});['caCategory','caType','caSort'].forEach(id=&gt;document.querySelector(`#${id}`).addEventListener('change',resetCABrowser));document.querySelector('#popularPlugins').addEventListener('click',()=&gt;{document.querySelector('#caType').value='plugin';document.querySelector('#caSort').value='popularity';document.querySelector('#caCategory').value='all';resetCABrowser()});

async function refreshRepo(){try{const d=await api('/api/repo/validate',{method:'POST',body:'{}'});drawRepo(d)}catch(e){toast(e.message)}}
async function connectRepo(){const path=window.prompt('Enter the full path to your local repository folder:');if(!path)return;try{drawRepo(await api('/api/repo/connect',{method:'POST',body:JSON.stringify({path})}));toast('Repository folder connected.')}catch(e){toast(e.message)}}
document.querySelector('#bootstrapForm').addEventListener('submit',async ev=&gt;{ev.preventDefault();const form=ev.currentTarget,button=form.querySelector('button[type=submit]'),status=document.querySelector('#bootstrapStatus'),payload=Object.fromEntries(new FormData(form).entries());button.disabled=true;button.textContent='Creating GitHub repository…';status.textContent='Authorizing and generating the starter repository…';try{const result=await api('/api/repo/bootstrap',{method:'POST',body:JSON.stringify(payload)});drawRepo(result);status.innerHTML=`Created &lt;a href="${escapeHtml(result.github_url)}" target="_blank" rel="noreferrer"&gt;${escapeHtml(result.github_url)}&lt;/a&gt; and cloned it to ${escapeHtml(result.path)}.`;document.querySelector('#githubToken').value='';form.reset();document.querySelector('#bootstrapCard').open=false;await loadActivity();toast('Starter repository created and connected.')}catch(e){status.textContent=e.message;toast(e.message)}finally{document.querySelector('#githubToken').value='';button.disabled=false;button.textContent='Create &amp; clone starter repository'}});
document.querySelector('#populateForm').addEventListener('submit',async event=&gt;{event.preventDefault();const form=event.currentTarget,file=document.querySelector('#populateIcon').files[0],status=document.querySelector('#populateStatus'),button=form.querySelector('button[type=submit]');if(!file){status.textContent='Choose an app icon first.';return}if(file.size&gt;2_000_000){status.textContent='Choose an image smaller than 2 MB.';return}button.disabled=true;status.textContent='Creating the profile, template, and icon in your local repository…';try{const iconData=await new Promise((resolve,reject)=&gt;{const reader=new FileReader();reader.onload=()=&gt;resolve(String(reader.result).split(',')[1]);reader.onerror=()=&gt;reject(Error('The selected icon could not be read.'));reader.readAsDataURL(file)}),values=Object.fromEntries(new FormData(form).entries()),payload={...values,icon:{type:file.type,data:iconData},remove_plugin_example:form.elements.removePluginExample.checked};const result=await api('/api/repo/populate',{method:'POST',body:JSON.stringify(payload)});drawRepo(result);status.textContent=`Saved ${result.created_files.join(', ')} to the connected folder. Review the files, then validate them.`;await loadActivity();toast('Example app files saved locally.');if(confirm('The example files are saved. Run the repository preflight now?'))await refreshRepo()}catch(error){status.textContent=error.message;toast(error.message)}finally{button.disabled=false}});document.querySelector('#readyValidate').addEventListener('click',async()=&gt;{await refreshRepo();navigate('applications')});
function isApplicationAsset(path){return /^(templates|plugins|images)\//i.test(path)||/(^|\/)icon\.(png|jpe?g|webp|svg)$/i.test(path)}
function repositorySupportFiles(files){return files.filter(file=&gt;!isApplicationAsset(file))}
function repoFileRow(file,attribute){const saved=savedRepoFiles.has(file);return `&lt;button class="file-row repo-file" ${attribute}="${escapeHtml(file)}"&gt;&lt;span class="file-icon ${saved?'saved':file.endsWith('.xml')?'xml':'plain'}"&gt;${saved?'✓':file.endsWith('.xml')?'〈〉':'≡'}&lt;/span&gt;&lt;span&gt;&lt;b&gt;${escapeHtml(file)}&lt;/b&gt;&lt;small&gt;${saved?'Saved locally':'Repository setup file'}&lt;/small&gt;&lt;/span&gt;&lt;span class="file-state ${saved?'ok':''}"&gt;${saved?'✓ Saved':'Edit'}&lt;/span&gt;&lt;/button&gt;`}
async function loadRepoFiles(){try{const d=await api('/api/repo/files'),box=document.querySelector('#repoFileList'),allFiles=new Set(d.files||[]);let pruned=false;for(const file of savedRepoFiles)if(!allFiles.has(file)){savedRepoFiles.delete(file);pruned=true}if(pruned)persistSavedRepoFiles();const files=repositorySupportFiles(d.files||[]);box.innerHTML=files.length?files.slice(0,6).map(f=&gt;repoFileRow(f,'data-repo-file')).join(''):`&lt;div class="history-empty"&gt;No repository setup files found. App templates and icons are managed in Applications.&lt;/div&gt;`}catch(e){toast(e.message)}}
const submissionOptions=['Draft','Submitted','In review','Changes requested','Approved','Published'];
let serverSubmissionStatuses={};
function submissionStorageKey(){return `ca-workshop-submissions:${repo?.path||'no-repository'}`}
function getSubmissionStatuses(){try{const local=JSON.parse(localStorage.getItem(submissionStorageKey())||'{}');return {...local,...serverSubmissionStatuses}}catch{return serverSubmissionStatuses}}
async function setSubmissionStatus(file,status){const values=getSubmissionStatuses();values[file]=status;serverSubmissionStatuses[file]=status;try{localStorage.setItem(submissionStorageKey(),JSON.stringify(values))}catch{}try{await api('/api/submissions/status',{method:'POST',body:JSON.stringify({file,status})})}catch(e){}}
async function syncSubmissionStatuses(){try{const res=await api('/api/submissions/status');if(res&amp;&amp;res.statuses){serverSubmissionStatuses=res.statuses;try{const local=JSON.parse(localStorage.getItem(submissionStorageKey())||'{}');localStorage.setItem(submissionStorageKey(),JSON.stringify({...local,...res.statuses}))}catch{}}}catch{}}
function appMetric(value,format=value=&gt;value){return value===undefined||value===null||value===''?'Unavailable':escapeHtml(format(value))}
async function loadApplicationStats(file,name,container,type='docker'){container.textContent='Checking the CA Store…';try{const result=await api(`/api/ca/browse?q=${encodeURIComponent(name)}&amp;type=${encodeURIComponent(type)}&amp;page=0&amp;limit=8`),hit=(result.hits||[]).find(item=&gt;String(item.Name||'').trim().toLowerCase()===name.trim().toLowerCase());if(!hit){container.textContent='No exact name match found in the CA Store. Check the app name or search the CA Store manually.';return}const categories=hit.CategoryList||hit.categoryPaths||[],cats=Array.isArray(categories)?categories.join(', '):String(categories),repository=hit.Repo||hit.Project||'';container.innerHTML=`&lt;div class="application-metrics-grid"&gt;&lt;div&gt;&lt;small&gt;Application type&lt;/small&gt;&lt;b&gt;${appMetric(hit.appType)}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;small&gt;Categories&lt;/small&gt;&lt;b&gt;${appMetric(cats)}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;small&gt;Added&lt;/small&gt;&lt;b&gt;${appMetric(hit.DateAdded??hit.dateAdded)}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;small&gt;Last update&lt;/small&gt;&lt;b&gt;${appMetric(hit.LastUpdate??hit.lastUpdate)}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;small&gt;GitHub stars&lt;/small&gt;&lt;b&gt;${appMetric(hit.githubStars??hit.GitHubStars)}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;small&gt;CA downloads&lt;/small&gt;&lt;b&gt;${appMetric(hit.downloads,value=&gt;Number(value).toLocaleString())}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;small&gt;Repository / image&lt;/small&gt;&lt;b&gt;${appMetric(repository)}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;small&gt;Docker Hub stars&lt;/small&gt;&lt;b&gt;${appMetric(hit.dockerHubStars??hit.DockerHubStars)}&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;small class="metrics-source"&gt;Matched by exact app name in the Community Apps catalog. Unavailable fields are not provided by the catalog result.&lt;/small&gt;`}catch(error){container.textContent=`Could not load CA Store metrics: ${error.message}`}}
function applicationRow(item,index,{stats=false}={}){const status=getSubmissionStatuses()[item.file]||'Draft',schema=item.schema_validation;return `&lt;article class="application-row"&gt;&lt;div class="application-icon"&gt;${escapeHtml((item.name||'App').slice(0,2).toUpperCase())}&lt;/div&gt;&lt;div class="application-main"&gt;&lt;b&gt;${escapeHtml(item.name||item.file)}&lt;/b&gt;&lt;small&gt;${escapeHtml(item.file)}&lt;/small&gt;&lt;div class="application-meta"&gt;&lt;span class="pill ${item.ok?'good':'pending'}"&gt;${item.ok?'VALID':'FIX REQUIRED'}&lt;/span&gt;&lt;span class="application-status"&gt;Submission: ${escapeHtml(status)}&lt;/span&gt;&lt;/div&gt;${schema?`&lt;div class="application-schema ${schema.status==='invalid'?'invalid':''}"&gt;XSD ${escapeHtml(schema.status)} · ${escapeHtml(schema.message||'')}&lt;/div&gt;`:''}${item.errors?.length?`&lt;ul class="application-errors"&gt;${item.errors.map(error=&gt;`&lt;li&gt;${escapeHtml(error)}&lt;/li&gt;`).join('')}&lt;/ul&gt;`:'&lt;div class="application-valid-note"&gt;Template validation passed. Ready for CA submission.&lt;/div&gt;'}${stats?`&lt;div class="application-metrics-content" data-app-metrics="${index}"&gt;Load statistics from the CA Store.&lt;/div&gt;&lt;button type="button" class="outline" data-app-stats="${index}"&gt;Load statistics&lt;/button&gt;`:''}&lt;/div&gt;&lt;div class="application-actions"&gt;&lt;button class="outline" type="button" data-app-edit="${escapeHtml(item.file)}"&gt;${item.ok?'Edit template':'Edit'}&lt;/button&gt;${stats?'':`&lt;button class="outline" type="button" data-app-icons="${escapeHtml(item.file)}"&gt;Icon&lt;/button&gt;`}&lt;/div&gt;&lt;/article&gt;`}
async function loadApplications(){const box=document.querySelector('#applicationList');try{await syncSubmissionStatuses();const data=await api('/api/status');repo=data.repo;const templates=(data.repo?.templates||[]).filter(item=&gt;item.kind==='docker'||(item.kind==='unknown'&amp;&amp;item.file?.startsWith('templates/')));document.querySelector('#applicationCount').textContent=data.repo?.connected?templates.length:'—';document.querySelector('#applicationReadyCount').textContent=data.repo?.connected?templates.filter(item=&gt;item.ok).length:'—';const statuses=templates.map(item=&gt;getSubmissionStatuses()[item.file]||'Draft');document.querySelector('#applicationSubmissionState').textContent=data.repo?.connected?statuses.filter(status=&gt;['Submitted','In review','Changes requested','Approved','Published'].includes(status)).length:'—';document.querySelector('#applicationMetricsState').textContent=data.repo?.connected?statuses.filter(status=&gt;status==='Published').length:'—';if(!data.repo?.connected){box.innerHTML='&lt;div class="history-empty"&gt;Connect a repository on the Repository page to manage applications.&lt;/div&gt;';return}if(!templates.length){box.innerHTML='&lt;div class="history-empty"&gt;No Docker templates yet. Convert a Compose file or create one from the dummy template.&lt;/div&gt;';return}box.innerHTML=templates.map((item,index)=&gt;applicationRow(item,index)).join('');box.dataset.applicationFiles=JSON.stringify(templates.map(item=&gt;({file:item.file,name:item.name||item.file}))) }catch(error){box.innerHTML=`&lt;div class="history-empty"&gt;${escapeHtml(error.message)}&lt;/div&gt;`}}
async function loadSubmissionTracker(){const box=document.querySelector('#submissionTracker');try{await syncSubmissionStatuses();const data=await api('/api/status');repo=data.repo;if(!data.repo?.connected){box.innerHTML='&lt;div class="history-empty"&gt;Connect a repository to track app and plugin submissions.&lt;/div&gt;';return}const items=(data.repo.templates||[]).filter(item=&gt;item.kind==='docker'||item.kind==='plugin'||(item.kind==='unknown'&amp;&amp;(/^(templates|plugins)\//.test(item.file||'')))),statuses=getSubmissionStatuses();box.innerHTML=items.length?items.map(item=&gt;{const isPlugin=item.kind==='plugin'||item.file?.startsWith('plugins/'),type=isPlugin?'Plugin':'Docker app';return `&lt;div class="submission-row"&gt;&lt;div&gt;&lt;b&gt;${escapeHtml(item.name||item.file)} &lt;span class="submission-kind"&gt;${type}&lt;/span&gt;&lt;/b&gt;&lt;small&gt;${escapeHtml(item.file)} · ${item.ok?'Local validation passed':'Fix local validation issues before submitting'}&lt;/small&gt;&lt;/div&gt;&lt;label&gt;Portal status&lt;select data-submission-status="${escapeHtml(item.file)}"&gt;${submissionOptions.map(status=&gt;`&lt;option ${status===(statuses[item.file]||'Draft')?'selected':''}&gt;${status}&lt;/option&gt;`).join('')}&lt;/select&gt;&lt;/label&gt;${isPlugin?`&lt;button class="outline" type="button" data-submission-file="${escapeHtml(item.file)}"&gt;View file&lt;/button&gt;`:`&lt;button class="outline" type="button" data-app-edit="${escapeHtml(item.file)}"&gt;${item.ok?'Edit':'Fix'}&lt;/button&gt;`}&lt;/div&gt;`}).join(''):'&lt;div class="history-empty"&gt;No Docker applications or plugin wrappers found in this repository.&lt;/div&gt;'}catch(error){box.textContent=error.message}}
async function loadPublishedStats(){const box=document.querySelector('#publishedApplicationStats');try{const data=await api('/api/status');repo=data.repo;const published=(data.repo?.templates||[]).filter(item=&gt;item.kind==='docker'&amp;&amp;getSubmissionStatuses()[item.file]==='Published');box.dataset.applicationFiles=JSON.stringify(published.map(item=&gt;({file:item.file,name:item.name||item.file})));box.innerHTML=published.length?published.map((item,index)=&gt;applicationRow(item,index,{stats:true})).join(''):'&lt;div class="history-empty"&gt;No apps marked Published yet. Confirm approval in the CA portal, then update each app in Submissions.&lt;/div&gt;'}catch(error){box.innerHTML=`&lt;div class="history-empty"&gt;${escapeHtml(error.message)}&lt;/div&gt;`}}
function pluginRow(item){const status=getSubmissionStatuses()[item.file]||'Draft';return `&lt;article class="application-row"&gt;&lt;div class="application-icon"&gt;PL&lt;/div&gt;&lt;div class="application-main"&gt;&lt;b&gt;${escapeHtml(item.name||item.file)}&lt;/b&gt;&lt;small&gt;${escapeHtml(item.file)}&lt;/small&gt;&lt;div class="application-meta"&gt;&lt;span class="pill ${item.ok?'good':'pending'}"&gt;${item.ok?'VALID':'FIX REQUIRED'}&lt;/span&gt;&lt;span class="application-status"&gt;Submission: ${escapeHtml(status)}&lt;/span&gt;&lt;/div&gt;${item.plugin_url?`&lt;p&gt;Package: &lt;a href="${escapeHtml(item.plugin_url)}" target="_blank" rel="noreferrer"&gt;${escapeHtml(item.plugin_url)}&lt;/a&gt;&lt;/p&gt;`:''}${item.errors?.length?`&lt;ul class="application-errors"&gt;${item.errors.map(error=&gt;`&lt;li&gt;${escapeHtml(error)}&lt;/li&gt;`).join('')}&lt;/ul&gt;`:'&lt;div class="application-valid-note"&gt;Plugin wrapper validation passed.&lt;/div&gt;'}&lt;/div&gt;&lt;/article&gt;`}
async function getPluginTemplates(){const data=await api('/api/status');repo=data.repo;return{repo:data.repo,plugins:(data.repo?.templates||[]).filter(item=&gt;item.kind==='plugin'||(item.kind==='unknown'&amp;&amp;item.file?.startsWith('plugins/')))}}
async function loadPlugins(){const box=document.querySelector('#pluginList');try{await syncSubmissionStatuses();const{repo:connectedRepo,plugins}=await getPluginTemplates(),connected=!!connectedRepo?.connected,statuses=getSubmissionStatuses(),statusValues=plugins.map(item=&gt;statuses[item.file]||'Draft');document.querySelector('#pluginWorkspaceCount').textContent=connected?plugins.length:'—';document.querySelector('#pluginReadyCount').textContent=connected?plugins.filter(item=&gt;item.ok).length:'—';document.querySelector('#pluginSubmissionCount').textContent=connected?statusValues.filter(status=&gt;['Submitted','In review','Changes requested','Approved','Published'].includes(status)).length:'—';document.querySelector('#pluginPublishedCount').textContent=connected?statusValues.filter(status=&gt;status==='Published').length:'—';box.innerHTML=!connected?'&lt;div class="history-empty"&gt;Connect a repository on the Repository page to manage plugins.&lt;/div&gt;':plugins.length?plugins.map(pluginRow).join(''):'&lt;div class="history-empty"&gt;No plugin wrappers found. Add plugin XML files under &lt;code&gt;plugins/&lt;/code&gt;.&lt;/div&gt;'}catch(error){box.innerHTML=`&lt;div class="history-empty"&gt;${escapeHtml(error.message)}&lt;/div&gt;`}}
async function loadPluginStats(){const box=document.querySelector('#publishedPluginStats');try{const{plugins}=await getPluginTemplates(),published=plugins.filter(item=&gt;getSubmissionStatuses()[item.file]==='Published');box.dataset.pluginFiles=JSON.stringify(published.map(item=&gt;({file:item.file,name:item.name||item.file})));box.innerHTML=published.length?published.map((item,index)=&gt;`&lt;article class="application-row"&gt;&lt;div class="application-icon"&gt;PL&lt;/div&gt;&lt;div class="application-main"&gt;&lt;b&gt;${escapeHtml(item.name||item.file)}&lt;/b&gt;&lt;small&gt;${escapeHtml(item.file)}&lt;/small&gt;&lt;div class="application-metrics-content" data-plugin-metrics="${index}"&gt;Load statistics from the CA Store.&lt;/div&gt;&lt;button type="button" class="outline" data-plugin-stats="${index}"&gt;Load statistics&lt;/button&gt;&lt;/div&gt;&lt;/article&gt;`).join(''):'&lt;div class="history-empty"&gt;No plugins marked Published yet. Confirm approval in the CA portal, then update each plugin in Submissions.&lt;/div&gt;'}catch(error){box.innerHTML=`&lt;div class="history-empty"&gt;${escapeHtml(error.message)}&lt;/div&gt;`}}

document.querySelector('#refreshApplications').addEventListener('click',()=&gt;loadApplications());document.querySelector('#refreshPlugins').addEventListener('click',()=&gt;loadPlugins());document.querySelector('#refreshPluginStats').addEventListener('click',()=&gt;loadPluginStats());document.querySelector('#publishedPluginStats').addEventListener('click',async event=&gt;{const button=event.target.closest('[data-plugin-stats]');if(!button)return;const box=document.querySelector('#publishedPluginStats'),item=JSON.parse(box.dataset.pluginFiles||'[]')[Number(button.dataset.pluginStats)],target=box.querySelector(`[data-plugin-metrics="${button.dataset.pluginStats}"]`);if(item&amp;&amp;target)await loadApplicationStats(item.file,item.name,target,'plugin')});document.querySelector('#refreshApplicationStats').addEventListener('click',()=&gt;loadPublishedStats());document.querySelector('#applicationList').addEventListener('click',async event=&gt;{const button=event.target.closest('[data-app-edit]');if(button){await navigate('template-editor');document.querySelector('#templateEditorSelect').value=button.dataset.appEdit;await loadTemplateEditorFile(button.dataset.appEdit);return}const iconButton=event.target.closest('[data-app-icons]');if(iconButton){await navigate('icon-tools')}});document.querySelector('#publishedApplicationStats').addEventListener('click',async event=&gt;{const button=event.target.closest('[data-app-stats]');if(!button)return;const box=document.querySelector('#publishedApplicationStats'),item=JSON.parse(box.dataset.applicationFiles||'[]')[Number(button.dataset.appStats)],target=box.querySelector(`[data-app-metrics="${button.dataset.appStats}"]`);if(item&amp;&amp;target)await loadApplicationStats(item.file,item.name,target)});document.querySelector('#submissionTracker').addEventListener('change',async event=&gt;{const select=event.target.closest('[data-submission-status]');if(!select)return;const file=select.dataset.submissionStatus,next=select.value,previous=getSubmissionStatuses()[file]||'Draft';if(next==='Submitted'){try{const status=await api('/api/repo/sync/status');if(!status.synced){select.value=previous;toast(status.error||'Sync the repository to GitHub before marking this app submitted.');await navigate('settings');return}}catch(error){select.value=previous;toast(`Could not verify GitHub sync: ${error.message}`);await navigate('settings');return}}setSubmissionStatus(file,next);loadApplications();loadPlugins();toast(`Submission status updated: ${next}.`)});document.querySelector('#submissionTracker').addEventListener('click',async event=&gt;{const fileButton=event.target.closest('[data-submission-file]');if(fileButton){viewRepoFile(fileButton.dataset.submissionFile);return}const button=event.target.closest('[data-app-edit]');if(!button)return;await navigate('template-editor');document.querySelector('#templateEditorSelect').value=button.dataset.appEdit;await loadTemplateEditorFile(button.dataset.appEdit)});
let repoIconUploadPath='',iconPreviewUrl='';let templateEditorIsNew=false;function isRepositoryIcon(path){return /(^|\/)icon\.(png|jpe?g|webp|svg)$/i.test(path)}
async function viewRepoFile(name){if(name==='ca_profile.xml'){await navigate('profile-editor');return}if(isRepositoryIcon(name)){repoIconUploadPath=name;const input=document.querySelector('#iconUploadInput'),extension=name.split('.').pop().toLowerCase(),accept={png:'image/png',jpg:'image/jpeg',jpeg:'image/jpeg',webp:'image/webp',svg:'image/svg+xml'}[extension];document.querySelector('#iconUploadPath').textContent=`${name} · upload a replacement`;document.querySelector('#iconUploadStatus').textContent='';document.querySelector('#iconUploadPreview').hidden=true;document.querySelector('#saveIconUpload').disabled=true;input.value='';input.accept=accept;document.querySelector('#iconUploadDialog').hidden=false;return}try{const d=await api(`/api/repo/file?path=${encodeURIComponent(name)}`);document.querySelector('#repoEditorPath').value=d.name;document.querySelector('#repoEditorContent').value=d.content;document.querySelector('#repoEditorTitle').textContent='Edit repository file';document.querySelector('#repoEditorStatus').textContent='Changes are saved locally and are not pushed to GitHub automatically.';document.querySelector('#deleteRepoFile').hidden=false;document.querySelector('#repoEditorDialog').hidden=false}catch(e){toast(e.message)}}
document.querySelector('#iconUploadInput').addEventListener('change',event=&gt;{const file=event.target.files[0],extension=repoIconUploadPath.split('.').pop().toLowerCase(),expected={png:'image/png',jpg:'image/jpeg',jpeg:'image/jpeg',webp:'image/webp',svg:'image/svg+xml'}[extension],status=document.querySelector('#iconUploadStatus'),preview=document.querySelector('#iconUploadPreview'),save=document.querySelector('#saveIconUpload');if(iconPreviewUrl)URL.revokeObjectURL(iconPreviewUrl);iconPreviewUrl='';if(!file){save.disabled=true;preview.hidden=true;return}if(file.size&gt;2_000_000||file.type&amp;&amp;file.type!==expected){status.textContent='Choose an image under 2 MB in the same format as the current icon.';save.disabled=true;preview.hidden=true;return}status.textContent=file.name;iconPreviewUrl=URL.createObjectURL(file);preview.src=iconPreviewUrl;preview.hidden=false;save.disabled=false});
function closeIconUploader(){document.querySelector('#iconUploadDialog').hidden=true;document.querySelector('#iconUploadInput').value='';document.querySelector('#iconUploadPreview').hidden=true;if(iconPreviewUrl)URL.revokeObjectURL(iconPreviewUrl);iconPreviewUrl=''}document.querySelector('#closeIconUpload').addEventListener('click',closeIconUploader);document.querySelector('#cancelIconUpload').addEventListener('click',closeIconUploader);document.querySelector('#iconUploadDialog').addEventListener('click',event=&gt;{if(event.target.id==='iconUploadDialog')closeIconUploader()});document.querySelector('#saveIconUpload').addEventListener('click',async()=&gt;{const file=document.querySelector('#iconUploadInput').files[0],status=document.querySelector('#iconUploadStatus'),button=document.querySelector('#saveIconUpload'),extension=repoIconUploadPath.split('.').pop().toLowerCase(),mime=file?.type||({png:'image/png',jpg:'image/jpeg',jpeg:'image/jpeg',webp:'image/webp',svg:'image/svg+xml'}[extension]);if(!file||!repoIconUploadPath)return;button.disabled=true;status.textContent='Uploading the new icon…';try{const encoded=await new Promise((resolve,reject)=&gt;{const reader=new FileReader();reader.onload=()=&gt;resolve(String(reader.result).split(',')[1]);reader.onerror=()=&gt;reject(Error('The selected image could not be read.'));reader.readAsDataURL(file)});await api('/api/repo/file/upload',{method:'POST',body:JSON.stringify({path:repoIconUploadPath,type:mime,data:encoded})});markRepoFileSaved(repoIconUploadPath);closeIconUploader();toast('Repository icon saved locally.');await loadRepoFiles();try{const data=await api('/api/status');drawRepo(data.repo);await loadActivity()}catch(error){toast(`Icon saved, but the repository view could not refresh: ${error.message}`)}}catch(error){status.textContent=error.message;toast(error.message)}finally{button.disabled=false}});
document.querySelector('#browseFiles').addEventListener('click',async()=&gt;{try{const d=await api('/api/repo/files'),files=repositorySupportFiles(d.files||[]),box=document.querySelector('#allRepoFiles');box.innerHTML=files.length?files.map(f=&gt;repoFileRow(f,'data-browse-file')).join(''):'&lt;div class="history-empty"&gt;No repository setup files found. App templates and icons are managed in Applications.&lt;/div&gt;';document.querySelector('#browseDialog').hidden=false}catch(e){toast(e.message)}});document.querySelector('#closeBrowse').addEventListener('click',()=&gt;document.querySelector('#browseDialog').hidden=true);document.querySelector('#newRepoFile').addEventListener('click',()=&gt;{document.querySelector('#browseDialog').hidden=true;document.querySelector('#repoEditorPath').value='';document.querySelector('#repoEditorContent').value='';document.querySelector('#repoEditorTitle').textContent='Create repository file';document.querySelector('#repoEditorStatus').textContent='New files are saved to your local clone.';document.querySelector('#deleteRepoFile').hidden=true;document.querySelector('#repoEditorDialog').hidden=false});document.querySelector('#allRepoFiles').addEventListener('click',e=&gt;{const b=e.target.closest('[data-browse-file]');if(b){document.querySelector('#browseDialog').hidden=true;viewRepoFile(b.dataset.browseFile)}});document.querySelector('#repoFileList').addEventListener('click',e=&gt;{const b=e.target.closest('[data-repo-file]');if(b)viewRepoFile(b.dataset.repoFile)});
document.querySelector('#closeRepoEditor').addEventListener('click',()=&gt;document.querySelector('#repoEditorDialog').hidden=true);document.querySelector('#repoEditorDialog').addEventListener('click',e=&gt;{if(e.target.id==='repoEditorDialog')e.currentTarget.hidden=true});document.querySelector('#saveRepoFile').addEventListener('click',async()=&gt;{const path=document.querySelector('#repoEditorPath').value.trim(),status=document.querySelector('#repoEditorStatus');if(!path){toast('Enter a file path first.');return}if(isApplicationAsset(path)){status.textContent='Docker templates and app icons are managed in Applications.';return}const button=document.querySelector('#saveRepoFile');button.disabled=true;try{await api('/api/repo/file/save',{method:'POST',body:JSON.stringify({path,content:document.querySelector('#repoEditorContent').value})});markRepoFileSaved(path);document.querySelector('#repoEditorDialog').hidden=true;toast('Repository file saved locally.');document.querySelector('#repoEditorDialog').hidden=true;;await loadRepoFiles();try{const current=await api('/api/status');drawRepo(current.repo);await loadActivity()}catch(error){toast(`Saved, but the repository view could not refresh: ${error.message}`)}}catch(e){status.textContent=e.message;toast(e.message)}finally{button.disabled=false}});document.querySelector('#deleteRepoFile').addEventListener('click',async()=&gt;{const path=document.querySelector('#repoEditorPath').value;if(!path||!confirm(`Delete ${path} from this local repository?`))return;try{await api('/api/repo/file/delete',{method:'POST',body:JSON.stringify({path})});markRepoFileDeleted(path);document.querySelector('#repoEditorDialog').hidden=true;await loadRepoFiles();const current=await api('/api/status');drawRepo(current.repo);await loadActivity();toast('Repository file deleted locally.')}catch(e){toast(e.message)}});
async function loadActivity(){try{const {events=[]}=await api('/api/history'),box=document.querySelector('#activityHistory');box.className=events.length?'activity-list':'history-empty';box.innerHTML=events.length?events.slice().reverse().map(e=&gt;`&lt;div class="activity-row"&gt;&lt;b&gt;${escapeHtml(e.action)}&lt;/b&gt;&lt;small&gt;${escapeHtml(e.detail)} · ${escapeHtml(new Date(e.time).toLocaleString())}&lt;/small&gt;&lt;/div&gt;`).join(''):'&lt;div&gt;◷&lt;/div&gt;&lt;b&gt;No local activity yet&lt;/b&gt;&lt;p&gt;Connect a repository or run a preflight to begin.&lt;/p&gt;';const validation=events.find(e=&gt;e.action==='Local preflight');document.querySelector('#validationDate').textContent=validation?new Date(validation.time).toLocaleDateString():'—';document.querySelector('#validationLabel').textContent=validation?new Date(validation.time).toLocaleTimeString():'Not run yet'}catch(e){toast(e.message)}}
async function loadUnraidStatus(){try{const d=await api('/api/unraid/status'),box=document.querySelector('#unraidStatus'),disconnect=document.querySelector('#unraidDisconnect'),list=document.querySelector('#unraidContainers');disconnect.hidden=!d.connected;if(!d.connected){box.innerHTML='Not connected. This app requests &lt;code&gt;system:read&lt;/code&gt;, &lt;code&gt;docker:read&lt;/code&gt;, &lt;code&gt;docker:update&lt;/code&gt;, and &lt;code&gt;docker:delete&lt;/code&gt;.';list.innerHTML='';return}document.querySelector('#unraidHost').value=d.host||'';if(d.error){box.textContent=`Connected to ${d.host}, but the API check failed: ${d.error}`;list.innerHTML='';return}const os=d.os||{};box.innerHTML=`&lt;b&gt;Connected to ${escapeHtml(d.host)}&lt;/b&gt;&lt;span&gt;${escapeHtml([os.distro,os.release].filter(Boolean).join(' ')||os.platform||'Unraid OS')} · ${Number(d.container_count)||0} Docker containers&lt;/span&gt;`;renderUnraidContainers(d.containers||[])}catch(e){toast(e.message)}}
function renderSyncStatus(status){const box=document.querySelector('#syncStatus'),list=document.querySelector('#syncFileList'),button=document.querySelector('#syncRepository');if(!status.connected){box.innerHTML=`&lt;span class="sync-state pending"&gt;Repository unavailable&lt;/span&gt;&lt;p&gt;${escapeHtml(status.error||'Connect a repository first.')}&lt;/p&gt;`;list.innerHTML='';button.disabled=true;return}const publicOk=status.public_check?.ok===true;box.innerHTML=`&lt;span class="sync-state ${status.synced?'good':'pending'}"&gt;${status.synced?'SYNCED TO GITHUB':publicOk?'SYNC REQUIRED':'CHECK REQUIRED'}&lt;/span&gt;&lt;p&gt;Local folder &lt;code&gt;${escapeHtml(status.repository_path||'unknown')}&lt;/code&gt; · GitHub &lt;b&gt;${escapeHtml(status.remote_name||'repository')}&lt;/b&gt; · branch &lt;code&gt;${escapeHtml(status.branch||'unknown')}&lt;/code&gt;${status.ahead?` · ${status.ahead} local commit(s) to push`:''}${status.behind?` · ${status.behind} remote commit(s) to pull`:''}&lt;/p&gt;${status.error?`&lt;small&gt;${escapeHtml(status.error)}&lt;/small&gt;`:''}${publicOk?'&lt;small class="sync-public good-text"&gt;Repository is public and active.&lt;/small&gt;':`&lt;small class="sync-public"&gt;${escapeHtml(status.public_check?.detail||'GitHub repository visibility is not verified.')}&lt;/small&gt;`}`;const files=status.syncable_files||[],other=status.other_changes||[];list.innerHTML=files.length?`&lt;b&gt;Submission files ready to sync&lt;/b&gt;${files.map(file=&gt;`&lt;div&gt;${escapeHtml(file)}&lt;/div&gt;`).join('')}`:other.length?'&lt;b&gt;No supported app files are waiting to sync.&lt;/b&gt;':'&lt;span&gt;No local app file changes.&lt;/span&gt;';if(other.length)list.innerHTML+=`&lt;div class="sync-other"&gt;&lt;b&gt;Other changes will be left out of this sync&lt;/b&gt;${other.map(file=&gt;`&lt;div&gt;${escapeHtml(file)}&lt;/div&gt;`).join('')}&lt;/div&gt;`;button.disabled=!files.length&amp;&amp;!status.ahead||status.behind&gt;0||!status.branch;document.querySelector('#syncCommitMessage').disabled=button.disabled}
const COMMON_INSTALL_VARS_KEY='ca-workshop-common-install-vars';function getCommonInstallVariables(){try{const data=JSON.parse(localStorage.getItem(COMMON_INSTALL_VARS_KEY)||'{}');return data&amp;&amp;typeof data==='object'&amp;&amp;!Array.isArray(data)?data:{}}catch{return {}}}
function addCommonInstallVarRow(name='',value=''){const row=document.createElement('div');row.className='common-install-var-row';const nameLabel=document.createElement('label'),nameInput=document.createElement('input');nameLabel.textContent='Variable name';nameInput.className='common-var-name';nameInput.value=name;nameInput.placeholder='PUID';nameInput.autocomplete='off';nameLabel.append(nameInput);const valueLabel=document.createElement('label');valueLabel.textContent='Saved value';const valueInput=document.createElement('input');valueInput.className='common-var-value';valueInput.type='password';valueInput.value=value;valueInput.autocomplete='off';valueInput.placeholder='1000';valueLabel.append(valueInput);const reveal=document.createElement('label');reveal.className='common-var-reveal';const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.addEventListener('change',()=&gt;valueInput.type=checkbox.checked?'text':'password');reveal.append(checkbox,document.createTextNode('Show'));const remove=document.createElement('button');remove.type='button';remove.className='outline common-var-remove';remove.textContent='Remove';remove.addEventListener('click',()=&gt;row.remove());row.append(nameLabel,valueLabel,reveal,remove);document.querySelector('#commonInstallVars').append(row)}
function renderCommonInstallVariables(){const box=document.querySelector('#commonInstallVars');box.replaceChildren();const values=getCommonInstallVariables();for(const[name,value]of Object.entries(values))addCommonInstallVarRow(name,String(value));document.querySelector('#commonInstallVarsStatus').textContent=Object.keys(values).length?`${Object.keys(values).length} variable(s) saved on this server.`:'No variables saved yet.'}
document.querySelector('#addCommonInstallVar').addEventListener('click',()=&gt;{addCommonInstallVarRow();document.querySelector('#commonInstallVars .common-var-name:last-of-type')?.focus()});document.querySelector('#commonInstallVarsForm').addEventListener('submit',async event=&gt;{event.preventDefault();const values={},rows=[...document.querySelectorAll('.common-install-var-row')];for(const row of rows){const name=row.querySelector('.common-var-name').value.trim(),value=row.querySelector('.common-var-value').value;if(!name&amp;&amp;!value)continue;if(!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)){row.querySelector('.common-var-name').focus();document.querySelector('#commonInstallVarsStatus').textContent='Use variable names with letters, numbers, and underscores.';return}values[name]=value}await api('/api/settings/vars',{method:'POST',body:JSON.stringify({vars:values})});document.querySelector('#commonInstallVarsStatus').textContent=`Saved ${Object.keys(values).length} common variable(s) in this browser.`;toast('Common install variables saved.')});
async function loadSettings(){try{const data=await api('/api/settings');const github=data.github||{},badge=document.querySelector('#githubSettingsBadge');renderCommonInstallVariables();badge.className=`pill ${github.configured?'good':'pending'}`;badge.textContent=github.configured?`CONNECTED · ${github.login||'GITHUB'}`:'NOT CONNECTED';document.querySelector('#githubSettingsStatus').textContent=github.configured?`Token verified for ${github.login}. Enter a new token to replace it.`:'No GitHub token saved.';document.querySelector('#removeGithubToken').hidden=!github.configured;const widget=data.dashboard_widget||{},widgetToggle=document.querySelector('#dashboardWidgetToggle'),widgetBadge=document.querySelector('#dashboardWidgetBadge');if(widgetToggle){widgetToggle.checked=widget.enabled!==false;if(widgetBadge){widgetBadge.className=`pill ${widgetToggle.checked?'good':'pending'}`;widgetBadge.textContent=widgetToggle.checked?'ENABLED':'DISABLED'}}renderSyncStatus(data.sync||{});loadAISettings();loadRuntime();await loadUnraidStatus()}catch(error){document.querySelector('#syncStatus').textContent=error.message}}
document.querySelector('#refreshSettings').addEventListener('click',loadSettings);document.querySelector('#refreshSyncStatus').addEventListener('click',async()=&gt;{try{renderSyncStatus(await api('/api/repo/sync/status'))}catch(error){toast(error.message)}});document.querySelector('#settingsThemeToggle').addEventListener('click',()=&gt;document.querySelector('#themeToggle').click());
document.querySelector('#dashboardWidgetToggle')?.addEventListener('change',async event=&gt;{const enabled=event.target.checked,badge=document.querySelector('#dashboardWidgetBadge');if(badge){badge.className=`pill ${enabled?'good':'pending'}`;badge.textContent=enabled?'ENABLED':'DISABLED'}try{await api('/api/settings/dashboard-widget',{method:'POST',body:JSON.stringify({enabled})});toast(`Dashboard widget ${enabled?'enabled':'disabled'}.`)}catch(e){toast(e.message)}});
document.querySelector('#githubSettingsForm').addEventListener('submit',async event=&gt;{event.preventDefault();const token=document.querySelector('#settingsGithubToken').value.trim(),status=document.querySelector('#githubSettingsStatus'),button=event.currentTarget.querySelector('button[type=submit]');if(!token){status.textContent='Paste a GitHub token first.';return}button.disabled=true;status.textContent='Verifying the token with GitHub…';try{const result=await api('/api/settings/github',{method:'POST',body:JSON.stringify({token})});document.querySelector('#settingsGithubToken').value='';status.textContent=`Verified and saved for ${result.login}.`;toast('GitHub token saved securely on this computer.');await loadSettings()}catch(error){status.textContent=error.message;toast(error.message)}finally{button.disabled=false}});document.querySelector('#removeGithubToken').addEventListener('click',async()=&gt;{if(!confirm('Remove the saved GitHub token from this computer?'))return;try{await api('/api/settings/github/remove',{method:'POST',body:'{}'});document.querySelector('#settingsGithubToken').value='';toast('Saved GitHub token removed.');await loadSettings()}catch(error){toast(error.message)}});
document.querySelector('#syncForm').addEventListener('submit',async event=&gt;{event.preventDefault();const button=document.querySelector('#syncRepository');button.disabled=true;try{const status=await api('/api/repo/sync/status'),files=status.syncable_files||[];if(status.behind){toast(status.error||'Pull remote changes before syncing.');return}const message=document.querySelector('#syncCommitMessage').value.trim();if(!message){toast('Enter a commit message.');return}const summary=files.length?files.join('\n'):status.ahead?`${status.ahead} existing local commit(s)`:'';if(!summary){toast('There are no app files or local commits to push.');return}if(!confirm(`Commit and push these changes to ${status.remote_name} on ${status.branch}?\n\n${summary}`))return;button.textContent='Pushing to GitHub…';const result=await api('/api/repo/sync',{method:'POST',body:JSON.stringify({message})});renderSyncStatus(result.status);toast(`Repository synced to GitHub (${result.branch}).`);await loadActivity()}catch(error){toast(error.message);await loadSettings()}finally{button.textContent='Commit submission files &amp; push';button.disabled=false}});
function renderUnraidContainers(containers){const box=document.querySelector('#unraidContainers');if(!containers.length){box.innerHTML='&lt;div class="unraid-empty"&gt;No Docker containers found on this Unraid server.&lt;/div&gt;';return}box.innerHTML='&lt;h3&gt;Unraid Docker containers&lt;/h3&gt;'+containers.map(c=&gt;{const id=escapeHtml(c.id),state=String(c.state).toLowerCase(),stateButtons=state==='running'?`&lt;button data-unraid-action="stop" data-id="${id}"&gt;Stop&lt;/button&gt;&lt;button data-unraid-action="restart" data-id="${id}"&gt;Restart&lt;/button&gt;`:`&lt;button data-unraid-action="start" data-id="${id}"&gt;Start&lt;/button&gt;`;return `&lt;div class="unraid-container-row"&gt;&lt;div&gt;&lt;b&gt;${escapeHtml(c.name||'Unnamed container')}&lt;/b&gt;&lt;small&gt;${escapeHtml(c.image||'')} · ${escapeHtml(c.status||c.state||'Unknown status')}&lt;/small&gt;&lt;/div&gt;&lt;div class="unraid-container-actions"&gt;${stateButtons}&lt;button data-unraid-action="update" data-id="${id}"&gt;Update&lt;/button&gt;&lt;button class="danger-button" data-unraid-action="remove" data-id="${id}"&gt;Remove&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;`}).join('')}
document.querySelector('#unraidContainers').addEventListener('click',async e=&gt;{const button=e.target.closest('[data-unraid-action]');if(!button)return;const {unraidAction:action,id}=button.dataset,verb={start:'Start',stop:'Stop',restart:'Restart',update:'Update from the latest image',remove:'Remove'}[action];if(!confirm(`${verb} ${action==='remove'?'this container?':'this Unraid container?'}${action==='update'?' This pulls and applies its latest image.':''}${action==='remove'?' The container will be removed; its image will be kept.':''}`))return;button.disabled=true;try{await api('/api/unraid/docker/action',{method:'POST',body:JSON.stringify({action,id,confirmed:true})});toast(`Unraid container ${action} request completed.`);await loadUnraidStatus();loadActivity()}catch(error){toast(error.message)}finally{button.disabled=false}});
async function completeUnraidCallback(){const params=new URLSearchParams(location.search),apiKey=params.get('api_key'),state=params.get('state'),error=params.get('error');if(!apiKey&amp;&amp;!error)return;history.replaceState({},document.title,location.pathname);if(error){toast('Unraid authorization was not completed.');return}try{await api('/api/unraid/connect/complete',{method:'POST',body:JSON.stringify({api_key:apiKey,state})});toast('Unraid server connected.');await loadUnraidStatus();loadActivity()}catch(e){toast(e.message)}}
document.querySelector('#unraidConnectForm').addEventListener('submit',async ev=&gt;{ev.preventDefault();const tab=window.open('about:blank','_blank');const button=ev.currentTarget.querySelector('button');button.disabled=true;try{const d=await api('/api/unraid/connect/start',{method:'POST',body:JSON.stringify({host:document.querySelector('#unraidHost').value})});if(tab)tab.location=d.authorization_url;else window.location.href=d.authorization_url}catch(e){if(tab)tab.close();toast(e.message)}finally{button.disabled=false}});document.querySelector('#unraidDisconnect').addEventListener('click',async()=&gt;{try{await api('/api/unraid/disconnect',{method:'POST',body:'{}'});toast('Unraid server disconnected.');await loadUnraidStatus();loadActivity()}catch(e){toast(e.message)}});
async function canOpenSubmissionPortal(){try{const status=await api('/api/repo/sync/status');if(status.synced)return true;toast(status.error||'Sync the public repository to GitHub before opening CA submission.');await navigate('settings');return false}catch(error){toast(`Could not verify GitHub sync: ${error.message}`);await navigate('settings');return false}}
document.querySelector('#reloadCAPortal').addEventListener('click',async()=&gt;{if(await canOpenSubmissionPortal())document.querySelector('#caSubmissionFrame').src='https://ca.unraid.net/submit/new'});document.querySelectorAll('a[href="https://ca.unraid.net/submit/new"]').forEach(link=&gt;link.addEventListener('click',async event=&gt;{event.preventDefault();const tab=window.open('about:blank','_blank');if(tab)tab.opener=null;if(await canOpenSubmissionPortal()){if(tab)tab.location.href=link.href;else toast('Allow popups to open the CA submission portal.')}else if(tab)tab.close()}));
function templateEditorLabel(value){return String(value).replace(/([a-z0-9])([A-Z])/g,'$1 $2').replace(/[_-]+/g,' ').replace(/^./,letter=&gt;letter.toUpperCase())}
function templateEditorInput(label,value,attrs){const data=Object.entries(attrs).map(([key,val])=&gt;`data-${key}="${escapeHtml(val)}"`).join(' '),boolean=/^(Required|Mask)$/i.test(label);if(boolean)return `&lt;label&gt;${escapeHtml(templateEditorLabel(label))}&lt;select ${data}&gt;&lt;option value="false" ${String(value).toLowerCase()==='false'?'selected':''}&gt;No&lt;/option&gt;&lt;option value="true" ${String(value).toLowerCase()==='true'?'selected':''}&gt;Yes&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;`;const long=/Overview|Description|Changes|Support|WebUI/i.test(label),secret=/^Default$/i.test(label)&amp;&amp;attrs.masked==='true';return `&lt;label&gt;${escapeHtml(templateEditorLabel(label))}${long?`&lt;textarea ${data} rows="3"&gt;${escapeHtml(value)}&lt;/textarea&gt;`:`&lt;input type="${secret?'password':'text'}" ${data} value="${escapeHtml(value)}" autocomplete="off"&gt;`}&lt;/label&gt;`}
function templateEditorXml(){if(!templateEditorDocument)return '';const root=templateEditorDocument.documentElement,children=[...root.children],direct=children.filter(node=&gt;node.tagName!=='Config'&amp;&amp;!node.children.length);document.querySelectorAll('[data-template-root-index]').forEach(field=&gt;{const node=direct[Number(field.dataset.templateRootIndex)];if(node)node.textContent=field.value});document.querySelectorAll('[data-template-new-element]').forEach(field=&gt;{const tag=field.dataset.templateNewElement;let node=[...root.children].find(child=&gt;child.tagName===tag);if(!node&amp;&amp;field.value.trim()){node=templateEditorDocument.createElement(tag);root.append(node)}if(node)node.textContent=field.value});document.querySelectorAll('[data-template-root-attribute]').forEach(field=&gt;root.setAttribute(field.dataset.templateRootAttribute,field.value));const configs=[...root.children].filter(node=&gt;node.tagName==='Config');document.querySelectorAll('[data-config-index][data-config-attribute]').forEach(field=&gt;{const node=configs[Number(field.dataset.configIndex)];if(node)node.setAttribute(field.dataset.configAttribute,field.value)});const serialized=new XMLSerializer().serializeToString(templateEditorDocument).replace(/^(?:\s*&lt;\?xml[^?]*\?&gt;)+\s*/i,'');return `&lt;?xml version="1.0" encoding="UTF-8"?&gt;\n${serialized}`}
function refreshTemplateEditorPreview(){document.querySelector('#templateEditorPreview').textContent=templateEditorXml()}
function renderTemplateEditor(){
 const root=templateEditorDocument.documentElement,form=document.querySelector('#templateEditorForm'),configsBox=document.querySelector('#templateEditorConfigs'),direct=[...root.children].filter(node=&gt;node.tagName!=='Config'&amp;&amp;!node.children.length);
 const fields=direct.map((node,index)=&gt;templateEditorInput(node.tagName,node.textContent,{'template-root-index':index}));
 if(root.tagName==='Container'){
  const present=new Set(direct.map(node=&gt;node.tagName));
  ['Name','Repository','Network','Overview','Support','Project','WebUI'].filter(tag=&gt;!present.has(tag)).forEach(tag=&gt;fields.push(templateEditorInput(tag,'',{'template-new-element':tag})));
 }
 const rootAttributes=[...root.attributes];
 if(rootAttributes.length)fields.unshift(...rootAttributes.map(attr=&gt;templateEditorInput(attr.name,attr.value,{'template-root-attribute':attr.name})));
 form.innerHTML=fields.join('');
 const configs=[...root.children].filter(node=&gt;node.tagName==='Config');
 const cards=configs.map((config,index)=&gt;{
  const settingName=config.getAttribute('Name')||('Setting '+(index+1));
  const attrs=[...config.attributes].map(attr=&gt;templateEditorInput(attr.name,attr.value,{'config-index':index,'config-attribute':attr.name,masked:config.getAttribute('Mask')?.toLowerCase()||'false'})).join('');
  return '&lt;section class="template-config-card"&gt;&lt;div class="template-config-heading"&gt;&lt;b&gt;'+escapeHtml(settingName)+'&lt;/b&gt;&lt;span&gt;'+escapeHtml(config.getAttribute('Type')||'Config')+'&lt;/span&gt;&lt;/div&gt;&lt;div class="template-config-fields"&gt;'+attrs+'&lt;/div&gt;&lt;/section&gt;';
 }).join('');
 configsBox.innerHTML=configs.length?'&lt;h2&gt;Container settings&lt;/h2&gt;'+cards:'&lt;div class="history-empty"&gt;This template has no Config settings yet.&lt;/div&gt;';
 document.querySelector('#templateEditorWorkspace').hidden=false;document.querySelector('#templateEditorEmpty').hidden=true;refreshTemplateEditorPreview();
}
async function loadTemplateEditor(){const select=document.querySelector('#templateEditorSelect'),status=document.querySelector('#templateEditorStatus'),previous=select.value;try{const data=await api('/api/status'),templates=(data.repo?.templates||[]).filter(item=&gt;item.kind==='docker');select.innerHTML='&lt;option value=""&gt;Choose a template file…&lt;/option&gt;'+templates.map(item=&gt;`&lt;option value="${escapeHtml(item.file)}"&gt;${escapeHtml(item.name||item.file)} · ${escapeHtml(item.file)}&lt;/option&gt;`).join('');status.textContent=data.repo?.connected?`${templates.length} Docker application template(s) available.`:'Connect a repository to load templates.';select.disabled=!data.repo?.connected;document.querySelector('#saveVisualTemplate').disabled=!data.repo?.connected;document.querySelector('#startDummyTemplate').disabled=!data.repo?.connected;if(previous&amp;&amp;templates.some(item=&gt;item.file===previous)){select.value=previous;await loadTemplateEditorFile(previous)}else{select.value='';templateEditorDocument=null;templateEditorPath='';templateEditorIsNew=false;document.querySelector('#templateEditorFilePath').value='';document.querySelector('#templateEditorWorkspace').hidden=true;document.querySelector('#templateEditorEmpty').hidden=false;document.querySelector('#templateEditorEmpty').textContent=data.repo?.connected?'Choose a template XML file or start from the dummy example.':'Connect a repository to begin.'}}catch(error){status.textContent=error.message}}
async function loadTemplateEditorFile(path){const status=document.querySelector('#templateEditorStatus');if(!path){templateEditorDocument=null;document.querySelector('#templateEditorWorkspace').hidden=true;document.querySelector('#templateEditorEmpty').hidden=false;return}try{const data=await api(`/api/repo/file?path=${encodeURIComponent(path)}`),parsed=new DOMParser().parseFromString(data.content,'application/xml');if(parsed.querySelector('parsererror')||parsed.documentElement?.tagName!=='Container')throw Error('This file is not a valid Docker Container template XML.');templateEditorDocument=parsed;templateEditorPath=path;templateEditorIsNew=false;document.querySelector('#templateEditorFilePath').value=path;status.textContent=`Editing ${path}. Changes are saved to your local repository.`;renderTemplateEditor()}catch(error){templateEditorDocument=null;document.querySelector('#templateEditorWorkspace').hidden=true;document.querySelector('#templateEditorEmpty').hidden=false;document.querySelector('#templateEditorEmpty').textContent=error.message}}
document.querySelector('#startDummyTemplate').addEventListener('click',async()=&gt;{if(!repo?.connected){toast('Connect a repository before starting a template.');return}if(!document.querySelector('#templateEditorWorkspace').hidden&amp;&amp;!confirm('Start a new template and discard the current unsaved editor changes?'))return;const button=document.querySelector('#startDummyTemplate'),status=document.querySelector('#templateEditorStatus');button.disabled=true;try{const [response,listing]=await Promise.all([fetch(apiUrl('/api/template/dummy'),{headers:{'X-CA-Workshop':'1'}}),api('/api/repo/files')]);if(!response.ok)throw Error('The example template could not be loaded.');const payload=await response.json(),source=payload.content||'',parsed=new DOMParser().parseFromString(source,'application/xml');if(parsed.querySelector('parsererror'))throw Error('The bundled example template is not valid XML.');const files=new Set(listing.files||[]);let index=1,path='templates/new-app.xml';while(files.has(path)){index+=1;path=`templates/new-app-${index}.xml`}templateEditorDocument=parsed;templateEditorPath=path;templateEditorIsNew=true;document.querySelector('#templateEditorFilePath').value=path;document.querySelector('#templateEditorSelect').value='';status.textContent='Started from the dummy XML example. Replace its sample values, then save into templates/.';renderTemplateEditor()}catch(error){status.textContent=error.message;toast(error.message)}finally{button.disabled=false}});document.querySelector('#templateEditorSelect').addEventListener('change',event=&gt;loadTemplateEditorFile(event.target.value));function handleTemplateEditorChange(event){const field=event.target;if(field.dataset.configAttribute==='Mask'){const value=document.querySelector(`[data-config-index="${field.dataset.configIndex}"][data-config-attribute="Default"]`);if(value)value.type=field.value==='true'?'password':'text'}refreshTemplateEditorPreview()}document.querySelector('#templateEditorWorkspace').addEventListener('input',handleTemplateEditorChange);document.querySelector('#templateEditorWorkspace').addEventListener('change',handleTemplateEditorChange);document.querySelector('#saveVisualTemplate').addEventListener('click',async()=&gt;{if(!templateEditorDocument)return;const button=document.querySelector('#saveVisualTemplate'),status=document.querySelector('#templateEditorStatus'),savedPath=document.querySelector('#templateEditorFilePath').value.trim(),parts=savedPath.split('/');if(!savedPath.endsWith('.xml')||parts[0]!=='templates'||parts.some(part=&gt;!part||part==='.'||part==='..')||savedPath.includes('\\')){status.textContent='Choose an XML file path inside templates/.';return}button.disabled=true;try{if(templateEditorIsNew){const listing=await api('/api/repo/files');if((listing.files||[]).includes(savedPath)&amp;&amp;!confirm(`${savedPath} already exists. Replace it?`))return}await api('/api/repo/file/save',{method:'POST',body:JSON.stringify({path:savedPath,content:templateEditorXml()})});templateEditorPath=savedPath;templateEditorIsNew=false;markRepoFileSaved(savedPath);status.textContent=`Saved ${savedPath} locally. Commit and push it from Git when ready.`;await loadRepoFiles();const data=await api('/api/status');drawRepo(data.repo);await loadActivity();toast('Template saved locally.');navigate('applications')}catch(error){status.textContent=error.message;toast(error.message)}finally{button.disabled=false}});
async function loadComposePage(){try{const data=await api('/api/status'),label=document.querySelector('#composeRepoStatus');label.textContent=data.repo?.connected?`Saving into ${data.repo.name}/templates/`:'Connect a repository first; you can still generate and review templates.';document.querySelector('#saveComposeTemplates').disabled=!data.repo?.connected}catch(error){document.querySelector('#composeRepoStatus').textContent=error.message}}
document.querySelector('#composeFileInput').addEventListener('change',async event=&gt;{const file=event.target.files?.[0];if(!file)return;if(file.size&gt;1_000_000){toast('Compose files must be smaller than 1 MB.');event.target.value='';return}try{document.querySelector('#composeSource').value=await file.text();document.querySelector('#composeSource').dataset.filename=file.name;document.querySelector('#composeMessage').textContent=`Loaded ${file.name}. Review it, then generate templates.`}catch(error){toast(`Could not read the file: ${error.message}`)}});
document.querySelector('#composeForm').addEventListener('submit',async event=&gt;{event.preventDefault();const content=document.querySelector('#composeSource').value,button=document.querySelector('#convertCompose'),message=document.querySelector('#composeMessage');button.disabled=true;button.textContent='Generating…';message.textContent='Reading services and mapping Compose settings…';try{const result=await api('/api/compose/convert',{method:'POST',body:JSON.stringify({content})});composeTemplates=result.templates||[];document.querySelector('#composeResults').innerHTML=composeTemplates.map((template,index)=&gt;`&lt;details class="compose-template" ${index===0?'open':''}&gt;&lt;summary&gt;&lt;span&gt;${escapeHtml(template.service)}&lt;/span&gt;&lt;small&gt;${escapeHtml(template.image)} · ${escapeHtml(template.path)}&lt;/small&gt;&lt;/summary&gt;${template.warnings.length?`&lt;div class="compose-warnings"&gt;&lt;b&gt;Review these items&lt;/b&gt;&lt;ul&gt;${template.warnings.map(warning=&gt;`&lt;li&gt;${escapeHtml(warning)}&lt;/li&gt;`).join('')}&lt;/ul&gt;&lt;/div&gt;`:`&lt;div class="compose-success"&gt;Compose values mapped into the dummy template. Review the remaining example URLs and settings in the graphical editor.&lt;/div&gt;`}&lt;label&gt;Template file path&lt;input data-compose-path value="${escapeHtml(template.path)}" autocomplete="off"&gt;&lt;/label&gt;&lt;button type="button" class="outline" data-compose-edit="${index}"&gt;Continue in graphical editor&lt;/button&gt;&lt;/details&gt;`).join('');document.querySelector('#saveComposeTemplates').hidden=true;message.textContent=`Generated ${composeTemplates.length} template${composeTemplates.length===1?'':'s'}. Check each warning and review the XML before saving.`;await loadComposePage()}catch(error){message.textContent=error.message;document.querySelector('#composeResults').innerHTML='';document.querySelector('#saveComposeTemplates').hidden=true;composeTemplates=[]}finally{button.disabled=false;button.textContent='Generate templates'}});
async function openComposeTemplateInEditor(index){const template=composeTemplates[index];if(!template)return;template.path=document.querySelector(`[data-compose-edit="${index}"]`).closest('.compose-template').querySelector('[data-compose-path]').value.trim();await navigate('template-editor');const parsed=new DOMParser().parseFromString(template.content,'application/xml');if(parsed.querySelector('parsererror')){toast('The generated template could not be opened in the graphical editor.');return}templateEditorDocument=parsed;templateEditorPath=template.path;templateEditorIsNew=true;document.querySelector('#templateEditorSelect').value='';document.querySelector('#templateEditorFilePath').value=template.path;document.querySelector('#templateEditorStatus').textContent=`Compose settings were mapped into the dummy template. Review the values, icon URL, and template URL before saving.`;renderTemplateEditor()}
document.querySelector('#composeResults').addEventListener('click',event=&gt;{const button=event.target.closest('[data-compose-edit]');if(button)openComposeTemplateInEditor(Number(button.dataset.composeEdit)).catch(error=&gt;toast(error.message))});
document.querySelector('#saveComposeTemplates').addEventListener('click',async()=&gt;{if(!composeTemplates.length)return;const templates=[...document.querySelectorAll('.compose-template')].map(card=&gt;({path:card.querySelector('[data-compose-path]').value.trim(),content:card.querySelector('[data-compose-content]').value}));const fileList=templates.map(item=&gt;item.path).join('\n');if(!confirm(`Save these ${templates.length} template file(s) into your connected repository?\n\n${fileList}\n\nExisting files with the same names will be replaced.`))return;const button=document.querySelector('#saveComposeTemplates');button.disabled=true;try{const result=await api('/api/compose/save',{method:'POST',body:JSON.stringify({templates,overwrite:true})});document.querySelector('#composeMessage').textContent=`Saved ${result.files.length} template file(s) locally. Review, commit, and push them from your repository.`;toast('Compose templates saved to the repository.');const current=await api('/api/status');drawRepo(current.repo);await loadActivity()}catch(error){document.querySelector('#composeMessage').textContent=error.message;toast(error.message)}finally{button.disabled=false}});
function renderPackageState(data){const badge=document.querySelector('#packageBadge'),message=document.querySelector('#packageMessage'),check=document.querySelector('#packageCheckUpdates'),download=document.querySelector('#packageDownloadUpdate'),pending=['checking','downloading'].includes(data.state);document.querySelector('#packageVersion').textContent=data.available?`Version ${data.current_version} · x86_64 · TXZ package`:pending?'Checking the official archive…':'No package downloaded yet';document.querySelector('#packageFilename').textContent=data.filename||'Official Unraid archive';badge.className=`pill ${data.update_available?'pending':data.available?'good':'pending'}`;badge.textContent=data.state==='downloading'?'DOWNLOADING':data.state==='checking'?'CHECKING':data.update_available?'UPDATE AVAILABLE':data.available?'ARCHIVE READY':'WAITING';message.textContent=data.state==='downloading'?`Downloading ${data.latest_version} · ${formatSize(data.bytes||0)} of ${formatSize(data.total||0)}`:data.state==='checking'?'Checking the official Unraid archive for the newest build…':data.state==='update-available'?`Version ${data.latest_version} is available.`:data.state==='up-to-date'?`Version ${data.current_version} is up to date.`:data.state==='downloaded'?`Downloaded and verified version ${data.current_version}.`:data.state==='failed'?`Archive check failed: ${data.error||'Unknown error'}`:data.available?'Use “Check for updates” to compare with GitHub.':'The latest package will download automatically.';check.disabled=pending;download.hidden=!data.update_available||pending;download.disabled=pending}
async function loadPackage(){clearTimeout(packagePollTimer);try{const data=await api('/api/package');renderPackageState(data);if(data.entries){const files=data.entries.filter(x=&gt;x.type==='file');document.querySelector('#packageTree').innerHTML=`&lt;div&gt;▾ &lt;b&gt;${escapeHtml(data.archive)}&lt;/b&gt; &lt;i&gt;${files.length} files&lt;/i&gt;&lt;/div&gt;${files.slice(0,100).map(x=&gt;`&lt;button class="tree-item archive-file" data-file="${escapeHtml(x.name)}"&gt;&lt;span&gt;${escapeHtml(x.name.replace(/^\.\//,''))}&lt;/span&gt;&lt;i&gt;${formatSize(x.size)}&lt;/i&gt;&lt;/button&gt;`).join('')}${files.length&gt;100?`&lt;div class="tree-item"&gt;&lt;span&gt;… ${files.length-100} more files&lt;/span&gt;&lt;/div&gt;`:''}`;document.querySelectorAll('.archive-file').forEach(b=&gt;b.addEventListener('click',()=&gt;viewPackageFile(b.dataset.file)))}else if(data.state==='failed'){document.querySelector('#packageTree').textContent=data.error||'The official package could not be downloaded.'}else{document.querySelector('#packageTree').textContent=data.state==='downloading'?'Downloading the official Community Applications archive…':'Checking the official Community Applications archive…'}if(['checking','downloading'].includes(data.state))packagePollTimer=setTimeout(loadPackage,900)}catch(e){document.querySelector('#packageTree').textContent=e.message}}
async function requestPackageUpdate(path){const button=document.querySelector(path.endsWith('/download')?'#packageDownloadUpdate':'#packageCheckUpdates');button.disabled=true;try{const data=await api(path,{method:'POST',body:'{}'});renderPackageState(data);await loadPackage()}catch(e){toast(e.message)}finally{button.disabled=false}}
document.querySelector('#packageCheckUpdates')?.addEventListener('click',()=&gt;requestPackageUpdate('/api/package/check'));document.querySelector('#packageDownloadUpdate')?.addEventListener('click',()=&gt;requestPackageUpdate('/api/package/download'));
async function viewPackageFile(name){try{const d=await api(`/api/package?file=${encodeURIComponent(name)}`);document.querySelector('#fileTitle').textContent=name;document.querySelector('#fileContent').textContent=d.content;document.querySelector('#fileDialog').hidden=false}catch(e){toast(e.message)}}
document.querySelector('#closeFile').addEventListener('click',()=&gt;document.querySelector('#fileDialog').hidden=true);document.querySelector('#fileDialog').addEventListener('click',e=&gt;{if(e.target.id==='fileDialog')e.currentTarget.hidden=true});document.querySelector('#browseDialog').addEventListener('click',e=&gt;{if(e.target.id==='browseDialog')e.currentTarget.hidden=true});
function formatSize(n){return n&lt;1024?`${n} B`:n&lt;1048576?`${(n/1024).toFixed(1)} KB`:`${(n/1048576).toFixed(1)} MB`}
async function loadDocker(){try{const d=await api('/api/status');drawRepo(d.repo);const available=d.docker.available;document.querySelector('#dockerBadge').innerHTML=`&lt;i&gt;&lt;/i&gt; ${available?'DOCKER CONNECTED':'DOCKER UNAVAILABLE'}`;document.querySelector('#dockerTitle').textContent=available?`Docker ${d.docker.version} connected`:'Docker connection required';document.querySelector('#dockerMessage').textContent=available?'Only running containers installed from the CA Store are listed.':'Start the Docker daemon to view CA Store sandbox containers.';document.querySelector('#dockerStatus').innerHTML=`&lt;span class="${available?'green-dot':'red-dot'}"&gt;&lt;/span&gt;&lt;span&gt;${available?'Docker daemon is reachable':'Cannot connect to Docker API'}&lt;/span&gt;&lt;button type="button" id="retryDocker"&gt;Retry&lt;/button&gt;`;document.querySelector('#retryDocker').addEventListener('click',loadDocker);if(available)await loadContainers();else document.querySelector('#containers').innerHTML='&lt;div class="history-empty"&gt;Docker is unavailable.&lt;/div&gt;'}catch(e){toast(e.message)}}
async function loadContainers(){try{const d=await api('/api/docker/containers'),el=document.querySelector('#containers');el.innerHTML=d.containers.length?`&lt;h3&gt;Running CA Store apps&lt;/h3&gt;${d.containers.map(c=&gt;`&lt;div class="container-row"&gt;&lt;span&gt;&lt;b&gt;${escapeHtml(c.name)}&lt;/b&gt;&lt;small&gt;${escapeHtml(c.image)} · ${escapeHtml(c.status)} · ${escapeHtml(c.source||'CA Store')}&lt;/small&gt;&lt;/span&gt;&lt;button data-stop="${escapeHtml(c.id)}"&gt;Stop &amp;amp; remove&lt;/button&gt;&lt;/div&gt;`).join('')}`:'&lt;div class="history-empty"&gt;&lt;div&gt;◈&lt;/div&gt;&lt;b&gt;No running CA Store apps&lt;/b&gt;&lt;p&gt;Install a Docker app from the CA Store to start a sandbox session.&lt;/p&gt;&lt;/div&gt;';el.querySelectorAll('[data-stop]').forEach(b=&gt;b.addEventListener('click',async()=&gt;{if(!confirm('Stop and remove this CA Store sandbox container?'))return;try{await api('/api/docker/stop',{method:'POST',body:JSON.stringify({id:b.dataset.stop})});toast('Container removed.');await loadContainers();loadActivity()}catch(e){toast(e.message)}}))}catch(e){toast(e.message)}}
document.querySelector('#refreshSandbox').addEventListener('click',loadDocker);
function showInstallConsole(name){const pane=document.querySelector('#installConsole');document.querySelector('#installConsoleTitle').textContent=`Installing ${name}`;document.querySelector('#installConsoleStage').textContent='Preparing install…';document.querySelector('#installConsoleLog').textContent='Waiting for Docker output…';pane.hidden=false;pane.classList.remove('install-done','install-failed');pane.scrollIntoView({block:'nearest'});return pane}
function appendConsoleLog(logs){const box=document.querySelector('#installConsoleLog');box.textContent=(logs||[]).join('\n')||'Docker is preparing the image and container…';box.scrollTop=box.scrollHeight}
async function watchInstall(jobId){let terminal=false;while(!terminal){try{const job=await api(`/api/docker/install/${encodeURIComponent(jobId)}`);document.querySelector('#installConsoleStage').textContent=job.stage||'Installing…';appendConsoleLog(job.logs);terminal=job.status==='complete'||job.status==='failed';if(terminal){const pane=document.querySelector('#installConsole');pane.classList.toggle('install-done',job.status==='complete');pane.classList.toggle('install-failed',job.status==='failed');if(job.error){const box=document.querySelector('#installConsoleLog');box.textContent+=(box.textContent?`\n\n${job.error}`:job.error)}if(job.status==='complete'){toast(`${job.result?.name||'App'} installed and started.`);await loadContainers();loadActivity()}else toast(job.error||'Docker install failed.')}else await new Promise(resolve=&gt;setTimeout(resolve,700))}catch(e){document.querySelector('#installConsoleStage').textContent='Could not read install status';document.querySelector('#installConsoleLog').textContent=e.message;document.querySelector('#installConsole').classList.add('install-failed');terminal=true}}}
document.querySelector('#installConsoleClose').addEventListener('click',()=&gt;{document.querySelector('#installConsole').hidden=true});
document.querySelector('#templateForm').addEventListener('submit',async ev=&gt;{ev.preventDefault();const value=document.querySelector('#templateSelect').value,selected=value.startsWith('external:')?selectedExternalTemplate:installerTemplates.find(t=&gt;t.file===value);if(!selected)return;const config={};document.querySelectorAll('[data-config]').forEach(input=&gt;{const field=selected.configs[Number(input.dataset.config)];config[field.name]=input.value});document.querySelectorAll('[data-volume-mode]').forEach(mode=&gt;{const index=Number(mode.dataset.volumeMode),field=selected.configs[index],source=document.querySelector(`[data-bind-source="${index}"]`).value.trim();config[field.name]=mode.value==='bind'?{mode:'bind',source}:{mode:'volume'}});const payload={...(selected.template_url?{template_url:selected.template_url}:{template:selected.file}),name:document.querySelector('#templateName').value,config};const pathCount=selected.configs.filter(c=&gt;c.type.toLowerCase()==='path').length,bindCount=Object.values(config).filter(v=&gt;v&amp;&amp;v.mode==='bind').length;const storageNote=bindCount?`${bindCount} bind mount(s) will expose selected host folders to the container.`:`${pathCount} path setting(s) will use isolated Docker volumes.`;if(!confirm(`Pull and install ${selected.name} (${selected.repository}) in Docker? This runs third-party image code. ${storageNote} Published ports are local to this computer.`))return;const button=ev.currentTarget.querySelector('button[type=submit]');button.disabled=true;button.textContent='Installing…';showInstallConsole(selected.name);try{const {job_id}=await api('/api/docker/run',{method:'POST',body:JSON.stringify(payload)});if(!job_id)throw Error('Docker install did not start.');await watchInstall(job_id)}catch(e){document.querySelector('#installConsoleStage').textContent='Docker install could not start';document.querySelector('#installConsoleLog').textContent=e.message;document.querySelector('#installConsole').classList.add('install-failed');toast(e.message)}finally{button.textContent='Install template to Docker';button.disabled=!selected.configs.every(c=&gt;['port','path','variable'].includes(c.type.toLowerCase()))}});
document.querySelector('#inspect')?.addEventListener('click',loadPackage);

document.querySelector('#checkPackage').addEventListener('click',async()=&gt;{try{const d=await api('/api/package');const badge=document.querySelector('#packageStatusBadge');badge.textContent=d.state==='idle'?'CHECKING':d.state;badge.className='pill '+(d.update_available?'warning':'ok');document.querySelector('#packageInfo').innerHTML=`&lt;b&gt;Version&lt;/b&gt; ${escapeHtml(d.current_version||'-')} &lt;b&gt;Archive&lt;/b&gt; ${escapeHtml(d.filename||'-')} &lt;b&gt;Latest&lt;/b&gt; ${escapeHtml(d.latest_version||'-')} &lt;b&gt;Update available&lt;/b&gt; ${(d.update_available?'Yes':'No')}`;renderPackageEntries(d.entries||[])}catch(e){toast(e.message)}});
document.querySelector('#showPackageContents').addEventListener('click',async()=&gt;{document.querySelector('#packageOverlay').classList.remove('hidden');try{const d=await api('/api/package');renderPackageEntries(d.entries||[], true)}catch(e){toast(e.message)}});
document.querySelector('#closeOverlay').addEventListener('click',()=&gt;{document.querySelector('#packageOverlay').classList.add('hidden')});
function renderPackageEntries(entries,overlay=false){const list=entries.filter(x=&gt;x.type==='file').map(x=&gt;`&lt;div class="entry-row"&gt;&lt;span class="entry-name"&gt;${escapeHtml(x.name.replace(/^\.\//,''))}&lt;/span&gt;&lt;span class="entry-size"&gt;${formatSize(x.size)}&lt;/span&gt;&lt;/div&gt;`).join('')||'&lt;div class="history-empty"&gt;No entries.&lt;/div&gt;';if(overlay){document.querySelector('#packageContents').innerHTML=`&lt;div class="package-entries"&gt;${list}&lt;/div&gt;`}else{document.querySelector('#packageInfo').innerHTML+=' &lt;div class="package-entries"&gt;&lt;b&gt;Files (first 50)&lt;/b&gt;&lt;div&gt;'+list.slice(0,50).join('')+'&lt;/div&gt;&lt;/div&gt;'}}
async function init(){loadActivity();await completeUnraidCallback();loadUnraidStatus();try{const d=await api('/api/status');drawRepo(d.repo)}catch(e){toast('Start the local server with python3 server.py')}}init();

document.querySelector('#editRawTemplate').addEventListener('click',async()=&gt;{if(!templateEditorPath||!repo?.connected){toast('No template file loaded or repository not connected.');return}try{const d=await api('/api/repo/file?path='+encodeURIComponent(templateEditorPath));document.querySelector('#repoEditorPath').value=templateEditorPath;document.querySelector('#repoEditorContent').value=d.content;document.querySelector('#repoEditorStatus').textContent='Editing '+templateEditorPath;document.querySelector('#repoEditorDialog').hidden=false}catch(e){toast('Could not load raw file: '+e.message)}});
/* Local OpenAI-compatible AI assistant */
let aiEnhanceTimer=0;
const aiObserver=new MutationObserver(records=&gt;{
  if(!aiConfig.configured)return;
  const added=records.some(record=&gt;[...record.addedNodes].some(node=&gt;node.nodeType===1&amp;&amp;(node.matches?.('input,textarea')||node.querySelector?.('input,textarea'))));
  if(!added)return;
  clearTimeout(aiEnhanceTimer);
  aiEnhanceTimer=setTimeout(()=&gt;enhanceAIFields(document),40);
});
if(document.querySelector('main'))aiObserver.observe(document.querySelector('main'),{childList:true,subtree:true});

function aiFieldLabel(field){
  const configAttr=field.dataset.configAttribute;
  if(configAttr)return templateEditorLabel(configAttr);
  const label=field.closest('label');
  if(label){
    const clone=label.cloneNode(true);
    clone.querySelectorAll('input,textarea,select,button,small,.ai-field-control,.ai-suggestion').forEach(node=&gt;node.remove());
    const text=clone.textContent.replace(/\s+/g,' ').trim();
    if(text)return text.replace(/\s*\(optional\)$/i,'');
  }
  return field.getAttribute('aria-label')||field.getAttribute('placeholder')||field.name||field.id||'Field';
}

function aiFieldAllowed(field){
  if(!field.matches('input,textarea'))return false;
  if(field.tagName==='INPUT'&amp;&amp;(field.type||'text')!=='text')return false;
  if(field.disabled||field.readOnly||field.dataset.aiEnhanced==='true')return false;
  if(field.closest('#aiSettingsForm, #syncForm, #unraidConnectForm, .repo-editor-box, .file-dialog, .template-xml-preview, #composeForm, #composeResults, .common-install-vars, .ca-install-drawer, .icon-tools-grid, .ai-suggestion'))return false;
  const label=aiFieldLabel(field);
  const key=[field.id,field.name,field.getAttribute('placeholder')||'',label,field.dataset.configAttribute||'',field.dataset.templateNewElement||''].join(' ');
  if(/(token|password|passwd|secret|api.?key|commit|search|folder|\bfile\b|host|\bport\b|icon|image|\burl\b|\buri\b|email|version|sha|hash|target|network|mode|\btype\b|command|args|regex|pattern|mask|template|\bxml\b|\byaml\b|\bjson\b)/i.test(key))return false;
  if(/^(repository|web ui|icon|support|project|template|target|type|mode|network)$/i.test(label))return false;
  if(field.dataset.templateRootAttribute)return false;
  if(field.dataset.configAttribute&amp;&amp;!/^description$/i.test(field.dataset.configAttribute))return false;
  if((field.dataset.templateRootIndex!==undefined||field.dataset.templateNewElement)&amp;&amp;!/^(name|overview|description|changes)$/i.test(label))return false;
  return true;
}

function enhanceAIField(field){
  if(!aiFieldAllowed(field))return;
  field.dataset.aiEnhanced='true';
  const control=document.createElement('span');
  control.className='ai-field-control';
  field.parentNode.insertBefore(control,field);
  control.append(field);
  const button=document.createElement('button');
  button.type='button';
  button.className='ai-field-button';
  button.textContent='✦';
  button.title='Generate text with local AI';
  button.setAttribute('aria-label',`Generate ${aiFieldLabel(field)} with local AI`);
  control.append(button);
}

function enhanceAIFields(root=document){
  if(!aiConfig.configured)return;
  root.querySelectorAll('input,textarea').forEach(enhanceAIField);
}

function removeAIFieldControls(root=document){
  root.querySelectorAll('.ai-field-control').forEach(control=&gt;{
    const field=control.querySelector('input,textarea');
    if(field){control.parentNode.insertBefore(field,control);delete field.dataset.aiEnhanced}
    control.remove();
  });
  root.querySelectorAll('.ai-suggestion').forEach(panel=&gt;panel.remove());
}

function aiFieldContext(field){
  const parts=[];
  const page=document.querySelector('.page.active-page h1');
  if(page)parts.push(`Page: ${page.textContent.trim()}`);
  const repo=document.querySelector('#repoName');
  if(repo&amp;&amp;!/no repository/i.test(repo.textContent))parts.push(`Repository: ${repo.textContent.trim()}`);
  const template=document.querySelector('#templateEditorSelect');
  if(template&amp;&amp;template.selectedOptions[0]?.value)parts.push(`Template: ${template.selectedOptions[0].textContent.trim()}`);
  if(typeof templateEditorPath==='string'&amp;&amp;templateEditorPath)parts.push(`Template file: ${templateEditorPath}`);
  const card=field.closest('.template-config-card');
  const setting=card?.querySelector('.template-config-heading b')?.textContent.trim();
  if(setting)parts.push(`Setting: ${setting}`);
  const appName=document.querySelector('#populateForm [name="name"]')?.value.trim();
  if(appName)parts.push(`App name: ${appName}`);
  const image=document.querySelector('#populateForm [name="image"]')?.value.trim();
  if(image)parts.push(`Docker image: ${image}`);
  return parts.join('\n').slice(0,4000);
}

function ensureAISuggestion(field){
  const control=field.closest('.ai-field-control');
  if(!control)return null;
  let panel=control.nextElementSibling;
  if(!panel||!panel.classList.contains('ai-suggestion')){
    panel=document.createElement('div');
    panel.className='ai-suggestion';
    panel.hidden=true;
    panel.innerHTML='&lt;div class="ai-suggestion-head"&gt;&lt;span&gt;✦ AI draft&lt;/span&gt;&lt;button type="button" class="ai-suggestion-close" aria-label="Close AI draft"&gt;×&lt;/button&gt;&lt;/div&gt;&lt;textarea class="ai-suggestion-text" rows="3" readonly aria-label="AI draft"&gt;&lt;/textarea&gt;&lt;div class="ai-suggestion-actions"&gt;&lt;button type="button" class="primary small ai-suggestion-use"&gt;Use this text&lt;/button&gt;&lt;button type="button" class="outline small ai-suggestion-retry"&gt;Try again&lt;/button&gt;&lt;small class="ai-suggestion-status" aria-live="polite"&gt;&lt;/small&gt;&lt;/div&gt;';
    control.after(panel);
    panel.querySelector('.ai-suggestion-close').addEventListener('click',()=&gt;{panel.hidden=true;field.focus()});
    panel.querySelector('.ai-suggestion-use').addEventListener('click',()=&gt;useAISuggestion(field,panel));
    panel.querySelector('.ai-suggestion-retry').addEventListener('click',()=&gt;runAIField(field,panel));
  }
  return panel;
}

function useAISuggestion(field,panel){
  const text=panel.querySelector('.ai-suggestion-text').value;
  if(!text)return;
  field.value=text;
  field.dispatchEvent(new Event('input',{bubbles:true}));
  field.dispatchEvent(new Event('change',{bubbles:true}));
  panel.hidden=true;
  field.focus();
  toast('AI text inserted. Review it before saving.');
}

async function runAIField(field,panel){
  const button=field.closest('.ai-field-control')?.querySelector('.ai-field-button');
  const output=panel.querySelector('.ai-suggestion-text');
  const status=panel.querySelector('.ai-suggestion-status');
  const use=panel.querySelector('.ai-suggestion-use');
  panel.hidden=false;
  panel.classList.add('busy');
  use.disabled=true;
  status.textContent='Asking the local model…';
  if(button)button.disabled=true;
  try{
    const label=aiFieldLabel(field);
    const max=field.maxLength&gt;0?Math.min(field.maxLength,4000):(field.tagName==='TEXTAREA'?1800:240);
    const result=await api('/api/ai/generate',{method:'POST',body:JSON.stringify({field:field.name||field.id||label,label,context:aiFieldContext(field),current_value:field.value.slice(0,4000),max_chars:max})});
    output.value=result.text;
    status.textContent=`Draft from ${result.model}. Review it, then use the text.`;
    use.disabled=false;
  }catch(error){
    output.value='';
    status.textContent=error.message;
  }finally{
    panel.classList.remove('busy');
    if(button)button.disabled=false;
  }
}

document.addEventListener('click',event=&gt;{
  const button=event.target.closest('.ai-field-button');
  if(!button)return;
  const field=button.closest('.ai-field-control')?.querySelector('input,textarea');
  if(!field)return;
  event.preventDefault();
  const panel=ensureAISuggestion(field);
  if(panel)runAIField(field,panel);
});

function renderAIModelOptions(models,selected){
  const select=document.querySelector('#aiModel');
  if(!select)return;
  const list=[...new Set([...(models||[]),...(selected?[selected]:[])])];
  select.innerHTML=list.length?list.map(model=&gt;`&lt;option value="${escapeHtml(model)}"&gt;${escapeHtml(model)}&lt;/option&gt;`).join(''):'&lt;option value=""&gt;Check the endpoint to load models&lt;/option&gt;';
  if(selected)select.value=selected;
}

function renderAISettings(){
  const badge=document.querySelector('#aiSettingsBadge');
  if(!badge)return;
  badge.className=`pill ${aiConfig.configured?'good':'pending'}`;
  badge.textContent=aiConfig.configured?`CONNECTED · ${aiConfig.model||'AI'}`:'NOT CONNECTED';
  const remove=document.querySelector('#removeAISettings');
  if(remove)remove.hidden=!aiConfig.configured;
  renderAIModelOptions(aiConfig.models,aiConfig.model);
}

async function loadAISettings(){
  const status=document.querySelector('#aiSettingsStatus');
  try{
    const data=await api('/api/settings/ai');
    aiConfig={...aiConfig,...data,models:Array.isArray(data.models)?data.models:[]};
    const base=document.querySelector('#aiBaseUrl');
    if(base&amp;&amp;document.activeElement!==base)base.value=aiConfig.base_url||'';
    const key=document.querySelector('#aiApiKey');
    if(key)key.placeholder=aiConfig.api_key_set?'Saved key — leave blank to keep it':'Leave blank if the endpoint has no key';
    renderAISettings();
    if(status)status.textContent=aiConfig.configured?`Connected to ${aiConfig.base_url} using ${aiConfig.model}.`:'No local AI endpoint connected.';
    if(aiConfig.configured)enhanceAIFields(document);else removeAIFieldControls(document);
  }catch(error){
    if(status)status.textContent=error.message;
  }
}

async function discoverAIModels(){
  const button=document.querySelector('#aiDiscoverModels');
  const status=document.querySelector('#aiSettingsStatus');
  const base=document.querySelector('#aiBaseUrl');
  const key=document.querySelector('#aiApiKey');
  if(!base||!base.value.trim()){if(status)status.textContent='Enter the endpoint base URL first.';base?.focus();return}
  const original=button.textContent;
  button.disabled=true;
  button.textContent='Checking…';
  if(status)status.textContent='Asking the endpoint for its model list…';
  try{
    const data=await api('/api/settings/ai/models',{method:'POST',body:JSON.stringify({base_url:base.value.trim(),api_key:key.value.trim()})});
    base.value=data.base_url;
    renderAIModelOptions(data.models);
    if(status)status.textContent=`Connected. Found ${data.models.length} model${data.models.length===1?'':'s'}. Choose one and save.`;
  }catch(error){
    if(status)status.textContent=error.message;
  }finally{
    button.disabled=false;
    button.textContent=original;
  }
}

document.querySelector('#aiDiscoverModels')?.addEventListener('click',discoverAIModels);
document.querySelector('#aiSettingsForm')?.addEventListener('submit',async event=&gt;{
  event.preventDefault();
  const base=document.querySelector('#aiBaseUrl');
  const key=document.querySelector('#aiApiKey');
  const model=document.querySelector('#aiModel');
  const status=document.querySelector('#aiSettingsStatus');
  const button=event.currentTarget.querySelector('button[type="submit"]');
  if(!base.value.trim()){if(status)status.textContent='Enter the endpoint base URL first.';base.focus();return}
  button.disabled=true;
  if(status)status.textContent='Checking the endpoint and saving settings…';
  try{
    const data=await api('/api/settings/ai',{method:'POST',body:JSON.stringify({base_url:base.value.trim(),api_key:key.value.trim(),model:model.value})});
    key.value='';
    aiConfig={...aiConfig,...data};
    renderAISettings();
    if(status)status.textContent=`Saved. Connected to ${data.base_url} using ${data.model}.`;
    toast('Local AI assistant connected.');
    await loadAISettings();
  }catch(error){
    if(status)status.textContent=error.message;
    else toast(error.message);
  }finally{
    button.disabled=false;
  }
});
document.querySelector('#removeAISettings')?.addEventListener('click',async()=&gt;{
  if(!confirm('Remove the saved local AI endpoint and API key from this computer?'))return;
  try{
    await api('/api/settings/ai/remove',{method:'POST',body:'{}'});
    aiConfig={configured:false,base_url:'',model:'',models:[],api_key_set:false};
    document.querySelector('#aiBaseUrl').value='';
    document.querySelector('#aiApiKey').value='';
    renderAISettings();
    removeAIFieldControls(document);
    const status=document.querySelector('#aiSettingsStatus');
    if(status)status.textContent='No local AI endpoint connected.';
    toast('Local AI settings removed.');
  }catch(error){toast(error.message)}
});
loadAISettings();

/* Unraid host runtime */
function renderRuntime(){
  const badge=document.querySelector('#runtimeBadge');
  const box=document.querySelector('#runtimeStatus');
  if(!badge||!box)return;
  badge.className=`pill ${runtime.unraid?'good':'pending'}`;
  badge.textContent=runtime.unraid?`UNRAID${runtime.version?' · '+runtime.version:''}`:'WORKSTATION';
  const docker=runtime.docker||{},plugins=runtime.plugins||{},ca=runtime.ca||{},templates=runtime.templates_user||{};
  const row=(label,value,ok)=&gt;`&lt;div class="runtime-row"&gt;&lt;span&gt;${escapeHtml(label)}&lt;/span&gt;&lt;b class="${ok===false?'runtime-bad':ok===true?'runtime-good':''}"&gt;${escapeHtml(value)}&lt;/b&gt;&lt;/div&gt;`;
  box.innerHTML=[
    row('Platform',runtime.unraid?`Unraid ${runtime.version||''}`.trim():'This computer (not Unraid)',runtime.unraid),
    row('Docker',docker.available?`${docker.mode||'Docker'} · ${docker.version||'available'}`:`Unavailable · ${docker.mode||'Docker'}`,docker.available),
    row('Plugin manager',plugins.available?`Available · ${plugins.count||0} installed plugin file(s)`:'Not available outside Unraid',plugins.available),
    row('Community Applications',ca.active?'Installed on this Unraid host':'Not detected; using the public CA catalog',ca.active),
    row('Unraid user templates',templates.active?templates.path:'Not available outside Unraid',templates.active),
  ].join('');
  if(runtime.unraid)box.insertAdjacentHTML('beforeend','&lt;p class="runtime-note"&gt;CA Workshop is using the Unraid Docker socket and plugin manager. Plugin installs from the CA Store run through Unraid’s own plugin manager after confirmation.&lt;/p&gt;');
}
async function loadRuntime(){
  try{
    runtime={...runtime,...await api('/api/runtime')};
    renderRuntime();
    updateUnraidModeUI();
    return runtime;
  }catch(error){
    const box=document.querySelector('#runtimeStatus');
    if(box)box.textContent=error.message;
    return runtime;
  }
}
loadRuntime();
</INLINE>
