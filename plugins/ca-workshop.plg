function setTheme(theme){const chosen=theme==='light'?'light':'dark';document.documentElement.dataset.theme=chosen;localStorage.setItem('ca-workshop-theme',chosen);const button=document.querySelector('#themeToggle');button.textContent=chosen==='dark'?'☼':'☾';button.setAttribute('aria-label',chosen==='dark'?'Switch to light theme':'Switch to dark theme')}setTheme(localStorage.getItem('ca-workshop-theme')||'dark');document.querySelector('#themeToggle').addEventListener('click',()=&gt;setTheme(document.documentElement.dataset.theme==='dark'?'light':'dark'));
function navigate(name){if((runtime.unraid||Boolean(window.CA_WORKSHOP_API_BASE))&amp;&amp;name==='sandbox')name='repository';pages.forEach(p=&gt;p.classList.toggle('active-page',p.id===name));const appPages=['applications','template-editor','compose','application-stats','icon-tools'],pluginPages=['plugins','plugin-stats'],appWorkspace=appPages.includes(name),pluginWorkspace=pluginPages.includes(name);document.querySelectorAll('.nav').forEach(n=&gt;n.classList.toggle('active',n.dataset.page===(appWorkspace?'applications':pluginWorkspace?'plugins':name)));document.querySelectorAll('.nav-tree-item').forEach(n=&gt;n.classList.toggle('active',n.dataset.page===name||(name==='compose'&amp;&amp;n.dataset.page==='template-editor')||(name==='icon-tools'&amp;&amp;n.dataset.page==='applications')));document.querySelectorAll('.nav-tree').forEach(tree=&gt;tree.classList.toggle('tree-active',tree.getAttribute('aria-label')===(pluginWorkspace?'Plugin pages':'Application pages')));document.querySelector('#crumb').textContent=({repository:'Repository',applications:'Applications',submissions:'Submissions','application-stats':'Application statistics','plugins':'Plugins','plugin-stats':'Plugin statistics','ca-shim':'Repository preview','ca-browser':'CA Store',sandbox:'Docker sandbox','package-archive':'CA archive',settings:'Settings',compose:'Compose import','template-editor':'Application editor','profile-editor':'CA profile editor','icon-tools':'Application icons',docs:'Unraid docs'})[name]||'Repository';if(name==='sandbox')pageLoad=loadDocker();else if(name==='package-archive')pageLoad=loadPackage();else if(name==='settings')pageLoad=loadSettings();else if(name==='ca-shim')pageLoad=loadCatalog();else if(name==='ca-browser')pageLoad=loadCABrowser();else if(name==='applications')pageLoad=loadApplications();else if(name==='plugins')pageLoad=loadPlugins();else if(name==='plugin-stats')pageLoad=loadPluginStats();else if(name==='submissions'){pageLoad=Promise.all([loadSubmissionTracker()])}else if(name==='application-stats')pageLoad=loadPublishedStats();else if(name==='compose')pageLoad=loadComposePage();else if(name==='template-editor')pageLoad=loadTemplateEditor();else if(name==='profile-editor')pageLoad=loadCAProfile();else if(name==='icon-tools')pageLoad=loadIconTools();window.scrollTo({top:0,behavior:'smooth'});return pageLoad}
document.querySelectorAll('.nav').forEach(n=&gt;n.addEventListener('click',()=&gt;navigate(n.dataset.page)));document.querySelectorAll('[data-go]').forEach(n=&gt;n.addEventListener('click',()=&gt;navigate(n.dataset.go)));document.querySelectorAll('.nav-tree-item').forEach(button=&gt;button.addEventListener('click',()=&gt;navigate(button.dataset.page)));
function updateUnraidModeUI(){const isUnraid=runtime.unraid||Boolean(window.CA_WORKSHOP_API_BASE);if(isUnraid){document.querySelectorAll('[data-page="sandbox"],.package-card,#packageOverlay').forEach(el=&gt;{el.hidden=true;el.style.display='none'});const sandboxSection=document.querySelector('#sandbox');if(sandboxSection){sandboxSection.hidden=true;sandboxSection.style.display='none'}if(document.querySelector('#crumb')?.textContent==='Docker sandbox')navigate('repository');}}
