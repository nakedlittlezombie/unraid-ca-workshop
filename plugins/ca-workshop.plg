document.querySelector('#reloadCAProfile').addEventListener('click',()=&gt;loadCAProfile().catch(error=&gt;toast(error.message)));
document.querySelector('#saveCAProfile').addEventListener('click',async()=&gt;{const button=document.querySelector('#saveCAProfile'),status=document.querySelector('#caProfileStatus'),invalid=[...document.querySelectorAll('.profile-field-name')].find(input=&gt;{const row=input.closest('.profile-field-row'),value=row.querySelector('.profile-field-value').value.trim(),name=input.value.trim();return (value||row.dataset.originalIndex!=='')&amp;&amp;(!/^[A-Za-z_][A-Za-z0-9_.-]*$/.test(name)||/^xml/i.test(name))});if(!caProfileDocument)return;if(invalid){invalid.focus();status.textContent='Use a valid XML field name: start with a letter or underscore, then use letters, numbers, dots, hyphens, or underscores.';return}button.disabled=true;try{const content=profileXmlFromForm();await api('/api/repo/file/save',{method:'POST',body:JSON.stringify({path:'ca_profile.xml',content})});caProfileDocument=new DOMParser().parseFromString(content,'application/xml');caProfileOriginalLeafIndexes=new Set();markRepoFileSaved('ca_profile.xml');status.textContent='Saved ca_profile.xml in the repository root. Run preflight to verify the profile.';toast('CA profile saved locally.');fillCAProfileForm();await loadRepoFiles();const current=await api('/api/status');drawRepo(current.repo);await loadActivity()}catch(error){status.textContent=error.message;toast(error.message)}finally{button.disabled=false}});
let iconToolsData=null,placeholderMatches=[];
function renderIconTools(data){iconToolsData=data;const templateSelect=document.querySelector('#fontAwesomeTemplate'),oldTemplate=templateSelect.value;templateSelect.innerHTML=data.templates.length?'&lt;option value=""&gt;Choose a Docker template&lt;/option&gt;'+data.templates.map(item=&gt;`&lt;option value="${escapeHtml(item.file)}"&gt;${escapeHtml(item.name)} · ${escapeHtml(item.file)}&lt;/option&gt;`).join(''):'&lt;option value=""&gt;No Docker templates found&lt;/option&gt;';if(data.templates.some(item=&gt;item.file===oldTemplate))templateSelect.value=oldTemplate;document.querySelector('#placeholderStatus').textContent=data.has_placeholder?'Placeholder ready at images/placeholder-icon.png.':`Upload a PNG to create images/placeholder-icon.png. ${data.templates.length} template(s) found.`;document.querySelector('#fillMissingIcons').disabled=!data.has_placeholder||!data.templates.length;document.querySelector('#scanPlaceholderIcons').disabled=!data.has_placeholder;const replacements=data.images.filter(path=&gt;path!=='images/placeholder-icon.png');document.querySelector('#placeholderReplacement').innerHTML=replacements.length?'&lt;option value=""&gt;Choose an image from images/&lt;/option&gt;'+replacements.map(path=&gt;`&lt;option value="${escapeHtml(path)}"&gt;${escapeHtml(path)}&lt;/option&gt;`).join(''):'&lt;option value=""&gt;No other PNG icons found&lt;/option&gt;';const missing=data.templates.filter(item=&gt;!item.has_icon);document.querySelector('#missingIconResults').innerHTML=missing.length?missing.map(item=&gt;`&lt;div class="icon-tool-row"&gt;&lt;span&gt;${escapeHtml(item.icon_file)}&lt;/span&gt;&lt;small&gt;Missing&lt;/small&gt;&lt;/div&gt;`).join(''):'&lt;div class="icon-tool-row"&gt;All templates have convention-named PNG icons.&lt;/div&gt;';if(!placeholderMatches.length)document.querySelector('#placeholderScanResults').textContent=data.has_placeholder?'Select “Check placeholder icons” to compare image pixels.':'Upload a placeholder PNG, then check the